      {
        "@language": "en",
        "@value": "establishedBy"
      },
      {
        "@language": "nl",
        "@value": "ingesteldDoor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
