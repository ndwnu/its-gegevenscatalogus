<https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen> a skos:ConceptScheme ;
    dct:created "2026-03-19T11:14:21.685697+00:00"^^xsd:dateTime ;
    dct:description "This concept scheme describes the set of temporary traffic management measures taken by or on behalf of the road authority (for a bounded validity period), which is activated for and deactivated after one or more specific triggers or scenarios."@en,
        "Dit conceptschema beschrijft de door of namens de wegbeheerder genomen set van tijdelijke verkeersmanagementmaatregels (voor een begrensde geldigheidsperiode), die wordt geactiveerd voor en gedeactiveerd na een of meerdere specifieke aanleidingen of scenario's."@nl ;
    dct:modified "2026-10-01T13:46:44.163012+00:00"^^xsd:dateTime ;
    dct:title "RTTI — Temporary traffic control measures"@en,
        "RTTI — Tijdelijke verkeersbeheersmaatregelen"@nl ;
