  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000303",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000302"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het afsluiten van een wegvak voor al het verkeer, eventueel met uitzondering van hulpdiensten."
      },
      {
        "@language": "en",
        "@value": "The closure of a road section to all traffic, possibly with the exception of emergency services."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Full closure"
      },
      {
        "@language": "nl",
        "@value": "Volledige afsluiting"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In het NDW DATEX II v3-profiel gemodelleerd via RoadOrCarriagewayOrLaneManagement; treft de afsluiting alle rijstroken dan valt deze samen met een wegafsluiting (NAPCORE)."
      },
      {
        "@language": "en",
        "@value": "Modelled in the NDW DATEX II v3 profile via RoadOrCarriagewayOrLaneManagement; where the closure affects all lanes it coincides with a road closure (NAPCORE)."
      }
    ]
  },
  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920547796",
