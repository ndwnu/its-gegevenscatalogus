      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0006622"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een verkeersbesluit dat ten grondslag ligt aan een tijdelijke plaatsing of tijdelijke maatregel, vereist wanneer de omstandigheden voor enkele maanden of zich regelmatig voordoen."
      },
      {
        "@language": "en",
        "@value": "A traffic decision underlying a temporary placement or temporary measure, required where the circumstances last a few months or occur on a regular basis."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Tijdelijk verkeersbesluit"
      },
      {
        "@language": "en",
        "@value": "Temporary traffic decision"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "WVW 1994 jo. BABW art. 37: in afwijking van de hoofdregel geschieden de tijdelijke plaatsing en de tijdelijke maatregel krachtens een verkeersbesluit indien de omstandigheden van langere duur zijn dan vier maanden dan wel zich regelmatig voordoen. De jurisprudentie (o.a. RvS) staat afzien van een verkeersbesluit toe bij dringende omstandigheden van voorbijgaande aard."
      },
      {
        "@language": "en",
        "@value": "WVW 1994 in conjunction with BABW art. 37: by way of derogation from the main rule, temporary placement and temporary measures are effected pursuant to a traffic decision where the circumstances last longer than four months or occur on a regular basis. Case law (including the Council of State) allows a traffic decision to be waived in the case of urgent circumstances of a passing nature."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000502",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een geplande gebeurtenis, zoals een wedstrijd, markt of festival, die de het regulier gebruik van het netwerk verstoren en daardoor tijdelijke verkeersmaatregelen vergt."
      },
      {
        "@language": "en",
        "@value": "A planned occurrence, such as a sports fixture, market or festival, that requires temporary traffic measures."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Evenement"
      },
      {
        "@language": "en",
        "@value": "Event"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In het NDW DATEX II v3-profiel ondergebracht bij werkzaamheden en evenementen."
      },
      {
        "@language": "en",
        "@value": "Placed under road works and events in the NDW DATEX II v3 profile."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/collections/wegwerkzaamheden",
    "@type": [
