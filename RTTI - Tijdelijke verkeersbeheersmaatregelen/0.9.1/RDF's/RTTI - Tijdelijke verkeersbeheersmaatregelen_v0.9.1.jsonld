        "@value": "Service verzoek"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000102",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De bevoegdheid van de wegbeheerder om bij een dringende omstandigheid van voorbijgaande aard tijdelijke verkeerstekens te plaatsen of tijdelijke maatregelen te treffen zonder een daaraan ten grondslag liggend verkeersbesluit."
      },
      {
        "@language": "en",
        "@value": "The competence of the road authority to place temporary traffic signs or take temporary measures in the case of an urgent circumstance of a passing nature, without an underlying traffic decision."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temporary measure competence"
      },
      {
        "@language": "nl",
        "@value": "Bevoegdheid tijdelijke maatregel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "BABW art. 34 (dringende omstandigheid van voorbijgaande aard voor de duur van die omstandigheid) en art. 35 (plaatsing/maatregel kunnen geschieden zonder verkeersbesluit)."
      },
      {
        "@language": "en",
        "@value": "BABW art. 34 (urgent circumstance of a passing nature, for the duration of that circumstance) and art. 35 (placement/measure may be effected without a traffic decision)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000308",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000103"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een tijdelijk op het wegdek aangebrachte markering die voorrang heeft op de permanente witte markering."
      },
      {
        "@language": "en",
        "@value": "A marking applied temporarily to the road surface that takes precedence over the permanent white marking."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Tijdelijke markering"
      },
      {
        "@language": "en",
        "@value": "Temporary yellow marking"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RVV 1990 art. 63a regelt de voorrang van tijdelijke wegdektekens; de kleureis (een andere kleur dan wit, in de praktijk geel) volgt uit de Uitvoeringsvoorschriften BABW, Hoofdstuk IV, paragraaf 1. Verwijst naar het verkeersborden-model zonder duplicatie."
      },
      {
        "@language": "en",
        "@value": "RVV 1990 art. 63a governs the precedence of temporary road surface signs; the colour requirement (a colour other than white, in practice yellow) follows from the BABW implementing regulations, Chapter IV, section 1. References the traffic signs model without duplication."
      }
    ]
  },
