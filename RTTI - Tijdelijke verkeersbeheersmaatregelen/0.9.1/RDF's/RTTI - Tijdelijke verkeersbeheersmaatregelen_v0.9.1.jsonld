        "@value": "Tijdelijke verkeerslichten"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In het NDW DATEX II v3-profiel via GeneralNetworkManagement met generalNetworkManagementType temporaryTrafficLights."
      },
      {
        "@language": "en",
        "@value": "In the NDW DATEX II v3 profile via GeneralNetworkManagement with generalNetworkManagementType temporaryTrafficLights."
      }
    ]
