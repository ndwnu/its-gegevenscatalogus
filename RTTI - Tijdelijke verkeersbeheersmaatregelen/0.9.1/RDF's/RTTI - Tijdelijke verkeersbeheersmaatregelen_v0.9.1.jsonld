      {
        "@language": "nl",
        "@value": "Het van kracht worden van een tijdelijke verkeersmaatregel bij het optreden van de aanleiding."
      },
      {
        "@language": "en",
        "@value": "The entry into force of a temporary traffic measure upon occurrence of the trigger."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
