  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920171026",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A contiguous geographic area within which a temporary traffic management measure or traffic management plan applies. Unlike a road section, which denotes a linear stretch of road, a zone delimits an areal region to which the relevant measures, rules or conditions apply."
      },
      {
        "@language": "nl",
        "@value": "Een aaneengesloten geografisch gebied waarbinnen een tijdelijke verkeersbeheersmaatregel of verkeersmanagementplan van toepassing is. Anders dan een wegvak, dat een lijnvormig weggedeelte aanduidt, bakent een zone een vlakvormig gebied af waarop de betreffende maatregelen, regels of condities gelden."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Definitie bedacht op basis van wat er in DATEXII staat. Omdat DATEXII nog geen formeel semantisch model online heeft staan, kan ik niet direct verwijzen naar wat DATEXII bedacht heeft."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Zone"
      },
      {
        "@language": "nl",
        "@value": "Zone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Geïnspireerd op het DATEX II-concept ControlledZone (namespace ControlledZone, v3.4), dat een gebied modelleert waarbinnen verkeersregelgeving geldt. Zie https://docs.datex2.eu/levels/mastering/controlledzones/"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000304",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het tijdelijk afsluiten van een of meer rijstroken terwijl de overige rijstroken beschikbaar blijven."
      },
      {
        "@language": "en",
        "@value": "The temporary closure of one or more lanes while the remaining lanes stay available."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Lane closure"
      },
      {
        "@language": "nl",
        "@value": "Rijstrookafsluiting"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RTTI-datacategorie lane closures (gepland/ongepland); in het NDW-profiel via RoadOrCarriagewayOrLaneManagement."
      },
      {
        "@language": "en",
        "@value": "RTTI data category lane closures (planned/unplanned); in the NDW profile via RoadOrCarriagewayOrLaneManagement."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000703",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het beeindigen van een tijdelijke verkeersmaatregel zodra het scenario dat de maatregel triggerde is opgelost."
      },
      {
        "@language": "en",
        "@value": "The termination of a temporary traffic measure once the scenario that triggered the measure has been resolved."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Deactivering"
      },
      {
        "@language": "en",
        "@value": "Deactivation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Kernonderscheid tussen verkeersmanagementplan en verkeerscirculatieplan volgens de NAPCORE data dictionary; in de NDW-keten de overgang van actieve naar ruststatus waarbij de bijbehorende maatregelen worden gedeactiveerd."
      },
      {
        "@language": "en",
        "@value": "Core distinction between the traffic management plan and the traffic circulation plan according to the NAPCORE data dictionary; in the NDW chain the transition from active to idle status, whereby the associated measures are deactivated."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000001",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "nl",
        "@value": "TVM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A set of temporary traffic management measures adopted by or on behalf of the road authority (for a limited period of validity), which is activated before and deactivated after one or more specific disruptions."
      },
      {
        "@language": "nl",
        "@value": "Een door of namens de wegbeheerder genomen set van tijdelijke verkeersmanagementmaatregels (voor een begrensde geldigheidsperiode), die wordt geactiveerd voor en gedeactiveerd na een of meerdere specifieke verstoringen."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Tijdelijke verkeersmaatregel gewijzigd naar Tijdelijke verkeersbeheersmaatregel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601"
      },
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920015950"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Tijdelijke verkeersbeheersmaatregel"
      },
      {
        "@language": "en",
        "@value": "Temporary traffic management measure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701"
      },
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920279579"
      },
