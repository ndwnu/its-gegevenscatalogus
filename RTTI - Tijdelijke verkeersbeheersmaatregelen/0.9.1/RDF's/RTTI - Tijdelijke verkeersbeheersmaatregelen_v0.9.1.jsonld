  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-03-19T11:14:21.685697+00:00"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "This concept scheme describes the set of temporary traffic management measures taken by or on behalf of the road authority (for a bounded validity period), which is activated for and deactivated after one or more specific triggers or scenarios."
      },
      {
        "@language": "nl",
        "@value": "Dit conceptschema beschrijft de door of namens de wegbeheerder genomen set van tijdelijke verkeersmanagementmaatregels (voor een begrensde geldigheidsperiode), die wordt geactiveerd voor en gedeactiveerd na een of meerdere specifieke aanleidingen of scenario's."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-10-01T13:46:44.163012+00:00"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "RTTI — Temporary traffic control measures"
      },
      {
        "@language": "nl",
        "@value": "RTTI — Tijdelijke verkeersbeheersmaatregelen"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.9.1"
      }
    ]
  },
  {
