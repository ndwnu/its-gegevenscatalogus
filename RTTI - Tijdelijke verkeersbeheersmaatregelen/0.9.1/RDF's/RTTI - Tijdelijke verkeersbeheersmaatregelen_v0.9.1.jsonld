    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een tijdelijk geplaatste verkeersregelinstallatie, bijvoorbeeld om verkeer langs een werkvak te regelen."
      },
      {
        "@language": "en",
        "@value": "A temporarily installed traffic signal control installation, for example to regulate traffic past a work zone."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
