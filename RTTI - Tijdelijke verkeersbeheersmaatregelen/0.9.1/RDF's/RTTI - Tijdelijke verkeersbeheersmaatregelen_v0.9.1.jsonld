      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RTTI state-of-network-categorie; triggert tijdelijke maatregelen en informatievoorziening."
      },
      {
        "@language": "en",
        "@value": "RTTI state-of-the-network category; triggers temporary measures and the provision of information."
      }
