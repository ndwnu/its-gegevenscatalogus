  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920279579",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Een expliciet vastgelegde regel die bepaalt onder welke condities een tijdelijke verkeersbeheersmaatregel wordt geactiveerd, gewijzigd of gedeactiveerd."
      },
      {
        "@language": "nl",
        "@value": "An explicitly defined rule that determines the conditions under which a temporary traffic management measure is activated, modified or deactivated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Dit concept is nog onderdeel van discussie."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Business rule"
      },
      {
        "@language": "nl",
        "@value": "Bedrijfsregel"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000401",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.datex2.eu/"
      },
      {
        "@value": "https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het tijdelijk leiden van verkeer langs een alternatieve route wegens een afsluiting of beperking op de gebruikelijke route."
      },
      {
        "@language": "en",
        "@value": "The temporary guidance of traffic along an alternative route because of a closure or restriction on the usual route."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Omleiding"
      },
      {
        "@language": "en",
        "@value": "Diversion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000403"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In DATEX II gemodelleerd via ReroutingManagement; in NL uitgewerkt in de CROW-richtlijnen werk in uitvoering."
      },
      {
        "@language": "en",
        "@value": "Modelled in DATEX II via ReroutingManagement; in the Netherlands elaborated in the CROW work in progress guidelines."
      }
    ],
    "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/relations/geffectueerdIn": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000404",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/"
      },
      {
        "@value": "https://www.rijkswaterstaat.nl/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een vooraf gedefinieerde en genummerde omleidingsroute (U-route) die bij afsluiting van een autosnelweg wordt opengesteld."
      },
      {
        "@language": "en",
        "@value": "A predefined and numbered diversion route (Dutch: U-route) that is opened when a motorway is closed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Emergency diversion route"
      },
      {
        "@language": "nl",
        "@value": "Uitwijkroute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De Nederlandse U-routesystematiek wordt beheerd door Rijkswaterstaat en aangeduid met U-borden."
      },
      {
        "@language": "en",
        "@value": "The Dutch U-route system is managed by Rijkswaterstaat and indicated by U-signs."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000403",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Tijdelijke aanduidingen op of bij de bestaande bewegwijzering die de omleidingsroute aangeven."
      },
      {
        "@language": "en",
        "@value": "Temporary indications on or next to the existing signposting that indicate the diversion route."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temporary signposting"
      },
      {
        "@language": "nl",
        "@value": "Tijdelijke bewegwijzering"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Vormgegeven met gele omleidingsborden conform de CROW-richtlijnen werk in uitvoering."
      },
      {
        "@language": "en",
        "@value": "Designed using yellow diversion signs in accordance with the CROW work in progress guidelines."
      }
    ]
  },
  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A disruption that is not scheduled in advance and occurs unexpectedly."
      },
      {
        "@language": "nl",
        "@value": "Een verstoring die niet vooraf is ingepland en zich onverwacht voordoet."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Definitie toegevoegd:\n\nEen verstoring die niet vooraf is ingepland en zich onverwacht voordoet."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Niet gepland"
      },
      {
        "@language": "en",
        "@value": "Unplanned"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000306",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      },
      {
        "@value": "https://docs.datex2.eu/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een tijdelijk verlaagde maximumsnelheid die bij wegwerkzaamheden of een ander scenario wordt ingesteld en na afloop wordt opgeheven."
      },
      {
        "@language": "en",
        "@value": "A temporarily reduced speed limit imposed during road works or another scenario and lifted once these have ended."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temporary speed limit"
      },
      {
        "@language": "nl",
        "@value": "Tijdelijke snelheidsbeperking"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In DATEX II vastgelegd als SpeedManagement met speedManagementType speedRestrictionInOperation, een temporarySpeedLimit en complianceOption mandatory (NDW-profiel). Verwijst naar het snelheidsbeperkingen-model zonder dit te dupliceren."
      },
      {
        "@language": "en",
        "@value": "Recorded in DATEX II as SpeedManagement with speedManagementType speedRestrictionInOperation, a temporarySpeedLimit and complianceOption mandatory (NDW profile). References the speed restrictions model without duplicating it."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000505",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Weather conditions, such as storm, black ice or snow, that require the activation of a set of temporary traffic measures."
      },
      {
        "@language": "nl",
        "@value": "Weersomstandigheden, zoals storm, ijzel of sneeuw, die de activering van een set van tijdelijke verkeersmaatregelen vergen."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Extreem weer"
      },
      {
        "@language": "en",
        "@value": "Extreme weather"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Een van de condities die een verkeersmanagementplan kunnen triggeren (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "One of the conditions that can trigger a traffic management plan (NAPCORE data dictionary)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000305",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het tijdelijk versmallen of verleggen van de rijbaan of rijstrook ten behoeve van werkzaamheden of een ander scenario."
      },
      {
        "@language": "en",
        "@value": "The temporary narrowing or shifting of the carriageway or lane for the purpose of works or another scenario."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Road narrowing"
      },
      {
        "@language": "nl",
        "@value": "Wegversmalling"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In het NDW DATEX II v3-profiel onderdeel van het rijstrook- en rijbaanbeheer bij werkzaamheden."
      },
      {
        "@language": "en",
        "@value": "Part of lane and carriageway management for road works in the NDW DATEX II v3 profile."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000503",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een onverwachte gebeurtenis met grote impact, zoals een natuurramp of technische ramp, die tijdelijke verkeersmaatregelen vergt."
      },
      {
        "@language": "en",
        "@value": "An unexpected high-impact event, such as a natural or technological disaster, that requires temporary measures."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Calamity"
      },
      {
        "@language": "nl",
        "@value": "Calamiteit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de scenario-gedreven maatregelen die via een verkeersmanagementplan worden geactiveerd (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "Falls under the scenario-driven measures activated through a traffic management plan (NAPCORE data dictionary)."
      }
    ]
  },
