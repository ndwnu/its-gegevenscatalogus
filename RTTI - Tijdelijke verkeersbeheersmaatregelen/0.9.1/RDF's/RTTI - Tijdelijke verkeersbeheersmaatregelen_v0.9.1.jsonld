    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een onverwachte verstoring van de verkeersstroom, zoals een ongeval of een gestrand voertuig."
      },
      {
        "@language": "en",
        "@value": "An unexpected disruption of the traffic flow, such as an accident or a broken-down vehicle."
      }
    ],
