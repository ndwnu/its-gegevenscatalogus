    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temporary measure type"
      },
      {
        "@language": "nl",
        "@value": "Tijdelijk maatregeltype"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Verzamelconcept voor afzettingen, rijstrookmaatregelen, snelheidsmaatregelen en tijdelijke verkeerslichten, conform de deelmaatregelen in het NDW DATEX II v3-profiel."
      },
      {
        "@language": "en",
        "@value": "Collective concept for closures, lane measures, speed measures and temporary traffic signals, in line with the sub-measures in the NDW DATEX II v3 profile."
      }
    ]
  },
