  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000103",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een verkeersteken dat tijdelijk wordt geplaatst of toegepast en na afloop van de aanleiding weer wordt verwijderd of gedeactiveerd."
      },
      {
        "@language": "en",
        "@value": "A traffic sign that is placed or applied on a temporary basis and is removed or deactivated once the trigger has ended."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000308"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temporary traffic sign"
      },
      {
        "@language": "nl",
        "@value": "Tijdelijk verkeersteken"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RVV 1990: tijdelijk geplaatste of toegepaste verkeerstekens op het wegdek gaan boven andere ter plekke aangebrachte wegdektekens voor zover deze onverenigbaar zijn (art. 63a)."
      },
      {
        "@language": "en",
        "@value": "RVV 1990: temporarily placed or applied road surface traffic signs take precedence over other road surface markings applied at that location in so far as these are incompatible (art. 63a)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000504",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
