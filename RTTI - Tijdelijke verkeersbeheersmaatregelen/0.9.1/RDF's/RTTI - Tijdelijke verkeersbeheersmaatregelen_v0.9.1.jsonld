  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.datex2.eu/"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De begin- en eindtijd waarbinnen een tijdelijke verkeersmaatregel van kracht is."
      },
      {
        "@language": "en",
        "@value": "The start and end time within which a temporary traffic measure is in force."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000702"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000703"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Validity period"
      },
      {
        "@language": "nl",
        "@value": "Geldigheidsperiode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Het kenmerk dat tijdelijke maatregelen onderscheidt van permanente; in DATEX II en het NDW-profiel vastgelegd als geldigheidsperiode."
      },
      {
        "@language": "en",
        "@value": "The characteristic that distinguishes temporary measures from permanent ones; recorded in DATEX II and the NDW profile as the validity period."
      }
    ]
  },
