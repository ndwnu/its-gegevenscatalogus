      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In de NDW-keten gekoppeld aan het actief melden van een maatregel."
      },
      {
        "@language": "en",
        "@value": "In the NDW chain linked to the active reporting of a measure."
      }
    ]
