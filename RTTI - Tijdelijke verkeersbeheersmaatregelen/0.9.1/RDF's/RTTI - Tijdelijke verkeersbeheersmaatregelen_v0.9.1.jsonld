  {
    "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000201",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.ndw.nu/dataformaten/datex2-v3/wwz/"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@value": "https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Onderhouds-, aanleg- of reparatiewerkzaamheden op of langs een wegvak die het gebruik van de weg geheel of gedeeltelijk beinvloeden."
      },
      {
        "@language": "en",
        "@value": "Maintenance, construction or repair works on or alongside a road section that wholly or partly affect the use of the road."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Zoals werk in uitvoering, onderhoudswerkzaamheden en aanlegwerkzaamheden"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Road works"
      },
      {
        "@language": "nl",
        "@value": "Wegwerkzaamheden"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "NAPCORE data dictionary: road works generally affect individual lanes; where they affect all lanes, they coincide with road closures. In the Netherlands supported by the NDW DATEX II v3 road works profile."
      },
      {
        "@language": "nl",
        "@value": "NAPCORE data dictionary: wegwerkzaamheden treffen doorgaans afzonderlijke rijstroken; treffen zij alle rijstroken, dan vallen zij samen met wegafsluitingen. In NL ondersteund door het NDW DATEX II v3-profiel wegwerkzaamheden."
      }
    ]
  },
  {
