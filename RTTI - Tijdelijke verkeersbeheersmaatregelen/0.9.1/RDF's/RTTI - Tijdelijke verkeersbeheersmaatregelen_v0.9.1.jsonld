    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De alternatieve route die verkeer volgt zolang de gebruikelijke route is afgesloten of beperkt."
      },
      {
        "@language": "en",
        "@value": "The alternative route that traffic follows for as long as the usual route is closed or restricted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"
