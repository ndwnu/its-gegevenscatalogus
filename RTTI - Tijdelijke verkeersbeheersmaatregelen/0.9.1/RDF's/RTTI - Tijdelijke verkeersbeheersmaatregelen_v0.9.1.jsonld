    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Onderscheidt zich van een permanent verkeerscirculatieplan door het activerings- en deactiveringskenmerk: een tijdelijke maatregel wordt gedeactiveerd zodra het getriggerde scenario is opgelost (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "Distinguished from a permanent traffic circulation plan by the activation and deactivation characteristic: a temporary measure is deactivated as soon as the triggered scenario has been resolved (NAPCORE data dictionary)."
      }
    ]
  },
  {
