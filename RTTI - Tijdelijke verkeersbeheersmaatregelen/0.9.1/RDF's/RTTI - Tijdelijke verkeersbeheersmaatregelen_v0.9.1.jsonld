      {
        "@language": "nl",
        "@value": "Strategie"
      },
      {
        "@language": "en",
        "@value": "Strategy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In DATEX II gemodelleerd als Strategy binnen de TrafficManagementPlan-namespace; activeringscondities mogen samengesteld zijn (v3.6)."
      },
      {
        "@language": "en",
        "@value": "Modelled in DATEX II as Strategy within the TrafficManagementPlan namespace; activation conditions may be composite (v3.6)."
      }
    ],
