  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000305">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Road narrowing</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegversmalling</skos:prefLabel>
    <skos:definition xml:lang="nl">Het tijdelijk versmallen of verleggen van de rijbaan of rijstrook ten behoeve van werkzaamheden of een ander scenario.</skos:definition>
    <skos:definition xml:lang="en">The temporary narrowing or shifting of the carriageway or lane for the purpose of works or another scenario.</skos:definition>
    <skos:scopeNote xml:lang="nl">In het NDW DATEX II v3-profiel onderdeel van het rijstrook- en rijbaanbeheer bij werkzaamheden.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Part of lane and carriageway management for road works in the NDW DATEX II v3 profile.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920279579">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Bedrijfsregel</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Business rule</skos:prefLabel>
    <skos:definition xml:lang="en">Een expliciet vastgelegde regel die bepaalt onder welke condities een tijdelijke verkeersbeheersmaatregel wordt geactiveerd, gewijzigd of gedeactiveerd.</skos:definition>
    <skos:definition xml:lang="nl">An explicitly defined rule that determines the conditions under which a temporary traffic management measure is activated, modified or deactivated.</skos:definition>
    <skos:editorialNote xml:lang="nl">Dit concept is nog onderdeel van discussie.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9cff009f5a2a4399a151fb8418a407a1">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000502"/>
    <rdf:rest rdf:nodeID="N415616ba93ad44b2aad916b37f7b7ef8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000503">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Calamity</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Calamiteit</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Valt onder de scenario-gedreven maatregelen die via een verkeersmanagementplan worden geactiveerd (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the scenario-driven measures activated through a traffic management plan (NAPCORE data dictionary).</skos:scopeNote>
    <skos:definition xml:lang="nl">Een onverwachte gebeurtenis met grote impact, zoals een natuurramp of technische ramp, die tijdelijke verkeersmaatregelen vergt.</skos:definition>
    <skos:definition xml:lang="en">An unexpected high-impact event, such as a natural or technological disaster, that requires temporary measures.</skos:definition>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920015950">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Tijdelijke Functionele Weg Classificatie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">+Temprorary Functional Road Class</skos:prefLabel>
    <skos:definition xml:lang="nl">Een tijdelijk toegekende functionele wegklasse die de normale classificatie van een wegvak overschrijft zolang een tijdelijke verkeersbeheersmaatregel van kracht is.</skos:definition>
    <skos:definition xml:lang="en">A temporarily assigned functional road class that overrides the normal classification of a road section for as long as a temporary traffic management measure is in force.</skos:definition>
    <skos:editorialNote xml:lang="nl">Definitie toegevoegd:

Een tijdelijk toegekende functionele wegklasse die de normale classificatie van een wegvak overschrijft zolang een tijdelijke verkeersbeheersmaatregel van kracht is.</skos:editorialNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000001"/>
  </rdf:Description>
