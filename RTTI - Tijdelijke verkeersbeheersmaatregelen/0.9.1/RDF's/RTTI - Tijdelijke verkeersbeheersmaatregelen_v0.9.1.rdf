  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Measure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">+Maatregel</skos:prefLabel>
    <skos:definition xml:lang="nl">Een individuele verkeersbeheersmaatregel binnen een verkeersmanagementplan, met een eigen activeringsconditie.</skos:definition>
    <skos:definition xml:lang="en">An individual traffic control measure within a traffic management plan, with its own activation condition.</skos:definition>
    <skos:scopeNote xml:lang="nl">In DATEX II gemodelleerd als Measure binnen de TrafficManagementPlan-namespace.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Modelled in DATEX II as Measure within the TrafficManagementPlan namespace.</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000602"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601"/>
    <ns1:leidtTot rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000602"/>
    <ns1:wordtgetriggerdDoor rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501"/>
    <ns1:beschrevenIn rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000702">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Activering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Activation</skos:prefLabel>
    <skos:definition xml:lang="nl">Het van kracht worden van een tijdelijke verkeersmaatregel bij het optreden van de aanleiding.</skos:definition>
    <skos:definition xml:lang="en">The entry into force of a temporary traffic measure upon occurrence of the trigger.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de NDW-keten gekoppeld aan het actief melden van een maatregel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In the NDW chain linked to the active reporting of a measure.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000703"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000308">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Tijdelijke markering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Temporary yellow marking</skos:prefLabel>
    <skos:definition xml:lang="nl">Een tijdelijk op het wegdek aangebrachte markering die voorrang heeft op de permanente witte markering.</skos:definition>
    <skos:definition xml:lang="en">A marking applied temporarily to the road surface that takes precedence over the permanent white marking.</skos:definition>
    <skos:scopeNote xml:lang="nl">RVV 1990 art. 63a regelt de voorrang van tijdelijke wegdektekens; de kleureis (een andere kleur dan wit, in de praktijk geel) volgt uit de Uitvoeringsvoorschriften BABW, Hoofdstuk IV, paragraaf 1. Verwijst naar het verkeersborden-model zonder duplicatie.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RVV 1990 art. 63a governs the precedence of temporary road surface signs; the colour requirement (a colour other than white, in practice yellow) follows from the BABW implementing regulations, Chapter IV, section 1. References the traffic signs model without duplication.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000103"/>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N88349102ce98498790857bfb2ec098ba">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000306"/>
    <rdf:rest rdf:nodeID="N525f681daa814161bb8656e561994279"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary measure type</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tijdelijk maatregeltype</skos:prefLabel>
    <skos:definition xml:lang="nl">Een categorie van fysieke of regulatoire ingreep waarmee een verkeersmaatregel wordt uitgevoerd met een duidelijke begin- en eindtijd.</skos:definition>
    <skos:definition xml:lang="en">A category of physical or regulatory intervention by which a traffic measure is implemented with a clear start time and end time.</skos:definition>
    <skos:scopeNote xml:lang="nl">Verzamelconcept voor afzettingen, rijstrookmaatregelen, snelheidsmaatregelen en tijdelijke verkeerslichten, conform de deelmaatregelen in het NDW DATEX II v3-profiel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Collective concept for closures, lane measures, speed measures and temporary traffic signals, in line with the sub-measures in the NDW DATEX II v3 profile.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000001"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000305"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000307"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000302"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000304"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000308"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000401"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000306"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920547796">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Service verzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Service request</skos:prefLabel>
    <skos:definition xml:lang="nl">n.t.b.</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000602">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Strategy</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">+Strategie</skos:prefLabel>
    <skos:definition xml:lang="nl">Een samenhangende set van maatregelen binnen een verkeersmanagementplan met een gemeenschappelijke activeringsconditie.</skos:definition>
    <skos:definition xml:lang="en">A coherent set of measures within a traffic management plan sharing a common activation condition.</skos:definition>
    <skos:scopeNote xml:lang="nl">In DATEX II gemodelleerd als Strategy binnen de TrafficManagementPlan-namespace; activeringscondities mogen samengesteld zijn (v3.6).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Modelled in DATEX II as Strategy within the TrafficManagementPlan namespace; activation conditions may be composite (v3.6).</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
    <ns1:heeft rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000001">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Tijdelijke verkeersbeheersmaatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Temporary traffic management measure</skos:prefLabel>
    <skos:altLabel xml:lang="nl">TVM</skos:altLabel>
    <skos:editorialNote xml:lang="nl">Tijdelijke verkeersmaatregel gewijzigd naar Tijdelijke verkeersbeheersmaatregel</skos:editorialNote>
    <skos:definition xml:lang="en">A set of temporary traffic management measures adopted by or on behalf of the road authority (for a limited period of validity), which is activated before and deactivated after one or more specific disruptions.</skos:definition>
    <skos:definition xml:lang="nl">Een door of namens de wegbeheerder genomen set van tijdelijke verkeersmanagementmaatregels (voor een begrensde geldigheidsperiode), die wordt geactiveerd voor en gedeactiveerd na een of meerdere specifieke verstoringen.</skos:definition>
    <skos:scopeNote xml:lang="nl">Onderscheidt zich van een permanent verkeerscirculatieplan door het activerings- en deactiveringskenmerk: een tijdelijke maatregel wordt gedeactiveerd zodra het getriggerde scenario is opgelost (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Distinguished from a permanent traffic circulation plan by the activation and deactivation characteristic: a temporary measure is deactivated as soon as the triggered scenario has been resolved (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
    <skos:narrower rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920015950"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920438369"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920279579"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920547796"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920171026"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000504">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Incident</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Incident</skos:prefLabel>
    <skos:definition xml:lang="nl">Een onverwachte verstoring van de verkeersstroom, zoals een ongeval of een gestrand voertuig.</skos:definition>
    <skos:definition xml:lang="en">An unexpected disruption of the traffic flow, such as an accident or a broken-down vehicle.</skos:definition>
    <skos:scopeNote xml:lang="nl">RTTI state-of-network-categorie; triggert tijdelijke maatregelen en informatievoorziening.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RTTI state-of-the-network category; triggers temporary measures and the provision of information.</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920372665">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Notes for the model</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Aantekening bij model</skos:prefLabel>
    <skos:definition xml:lang="nl">Deze (waarschijnlijk werkzaamheden) hoort eigenlijk ook onder verstoringen en dan is er misschien ook nog onderscheid nodig tussen gepland en concreet in uitvoering?

Graag kijken hoe we hier tegenaan kijken</skos:definition>
    <skos:definition xml:lang="nl">Concepten zouden in enkelvoud moeten staan</skos:definition>
    <skos:definition xml:lang="nl">Zijn deze items waarden die bij het service request horen?

2.1 "Avoid gebied/wegsegment"
2.2 "Promote gebied/wegsegment"
2.3 "Reroute"</skos:definition>
    <skos:definition xml:lang="nl">Check of er zaken uit moeten gaan die teveel gaan over de NL context!
Dit model heeft scope EU</skos:definition>
    <skos:definition xml:lang="en">Voor validatie doeleinden</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920438369">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Roadsegment</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">+Wegvak</skos:prefLabel>
    <skos:definition xml:lang="nl">Gedeelte van een weg tussen twee opeenvolgende knooppunten of kruispunten, of – indien geen zijweg aanwezig is – tussen twee punten waarop een verkeersmaatregel betrekking heeft. 

In het Nationaal Wegenbestand (NWB) is een wegvak de kleinste eenheid waarvoor wegkenmerken worden geregistreerd.</skos:definition>
    <skos:definition xml:lang="en">T.b.d.</skos:definition>
    <skos:editorialNote xml:lang="nl">Definitie toegevoegd:

Gedeelte van een weg tussen twee opeenvolgende knooppunten of kruispunten, of – indien geen zijweg aanwezig is – tussen twee punten waarop een verkeersmaatregel betrekking heeft. 

In het Nationaal Wegenbestand (NWB) is een wegvak de kleinste eenheid waarvoor wegkenmerken worden geregistreerd.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Verkeersmanagementplan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic management plan</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Het verkeersmanagementplan is een gedefinieerd DATEX II-datatype (TrafficManagementPlan-namespace, CEN/TS 16157-8) met de klassen Strategy en Measure met activeringscondities; anders dan het verkeerscirculatieplan, dat geen eigen DATEX II-namespace kent.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The traffic management plan is a defined DATEX II data type (TrafficManagementPlan namespace, CEN/TS 16157-8) with the classes Strategy and Measure carrying activation conditions; unlike the traffic circulation plan, which has no DATEX II namespace of its own.</skos:scopeNote>
    <skos:definition xml:lang="en">The collection of strategies, measures and actions that together constitute the plan.</skos:definition>
    <skos:definition xml:lang="nl">De verzameling van strategieën, maatregelen en acties die als geheel het plan vormen.</skos:definition>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000001"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000602"/>
    <ns1:bevat rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/collections/verkeersmanagementplan">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Verkeersmanagementplan &amp; activering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic management plan &amp; activation</skos:prefLabel>
    <skos:memberList rdf:nodeID="Nda0a9f53cad34dbca3866b3cc62b45ff"/>
  </rdf:Description>
