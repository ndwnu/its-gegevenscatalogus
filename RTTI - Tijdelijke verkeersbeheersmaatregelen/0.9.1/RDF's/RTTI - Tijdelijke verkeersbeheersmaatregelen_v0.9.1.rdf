    <rdf:rest rdf:nodeID="Na993350c6e7a4f19993ef21851d6323c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/relations/heeft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
    <rdfs:label xml:lang="en">has</rdfs:label>
    <rdfs:label xml:lang="nl">heeft</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000102">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary measure competence</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Bevoegdheid tijdelijke maatregel</skos:prefLabel>
    <skos:definition xml:lang="nl">De bevoegdheid van de wegbeheerder om bij een dringende omstandigheid van voorbijgaande aard tijdelijke verkeerstekens te plaatsen of tijdelijke maatregelen te treffen zonder een daaraan ten grondslag liggend verkeersbesluit.</skos:definition>
    <skos:definition xml:lang="en">The competence of the road authority to place temporary traffic signs or take temporary measures in the case of an urgent circumstance of a passing nature, without an underlying traffic decision.</skos:definition>
    <skos:scopeNote xml:lang="nl">BABW art. 34 (dringende omstandigheid van voorbijgaande aard voor de duur van die omstandigheid) en art. 35 (plaatsing/maatregel kunnen geschieden zonder verkeersbesluit).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">BABW art. 34 (urgent circumstance of a passing nature, for the duration of that circumstance) and art. 35 (placement/measure may be effected without a traffic decision).</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000307">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary traffic signals</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tijdelijke verkeerslichten</skos:prefLabel>
    <skos:definition xml:lang="nl">Een tijdelijk geplaatste verkeersregelinstallatie, bijvoorbeeld om verkeer langs een werkvak te regelen.</skos:definition>
    <skos:definition xml:lang="en">A temporarily installed traffic signal control installation, for example to regulate traffic past a work zone.</skos:definition>
    <skos:scopeNote xml:lang="nl">In het NDW DATEX II v3-profiel via GeneralNetworkManagement met generalNetworkManagementType temporaryTrafficLights.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In the NDW DATEX II v3 profile via GeneralNetworkManagement with generalNetworkManagementType temporaryTrafficLights.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Validity period</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geldigheidsperiode</skos:prefLabel>
    <skos:definition xml:lang="nl">De begin- en eindtijd waarbinnen een tijdelijke verkeersmaatregel van kracht is.</skos:definition>
    <skos:definition xml:lang="en">The start and end time within which a temporary traffic measure is in force.</skos:definition>
    <skos:scopeNote xml:lang="nl">Het kenmerk dat tijdelijke maatregelen onderscheidt van permanente; in DATEX II en het NDW-profiel vastgelegd als geldigheidsperiode.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The characteristic that distinguishes temporary measures from permanent ones; recorded in DATEX II and the NDW profile as the validity period.</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000703"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000702"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Niet gepland</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Unplanned</skos:prefLabel>
    <skos:definition xml:lang="en">A disruption that is not scheduled in advance and occurs unexpectedly.</skos:definition>
    <skos:definition xml:lang="nl">Een verstoring die niet vooraf is ingepland en zich onverwacht voordoet.</skos:definition>
    <skos:editorialNote xml:lang="nl">Definitie toegevoegd:

Een verstoring die niet vooraf is ingepland en zich onverwacht voordoet.</skos:editorialNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000303">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Full closure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Volledige afsluiting</skos:prefLabel>
    <skos:definition xml:lang="nl">Het afsluiten van een wegvak voor al het verkeer, eventueel met uitzondering van hulpdiensten.</skos:definition>
    <skos:definition xml:lang="en">The closure of a road section to all traffic, possibly with the exception of emergency services.</skos:definition>
    <skos:scopeNote xml:lang="nl">In het NDW DATEX II v3-profiel gemodelleerd via RoadOrCarriagewayOrLaneManagement; treft de afsluiting alle rijstroken dan valt deze samen met een wegafsluiting (NAPCORE).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Modelled in the NDW DATEX II v3 profile via RoadOrCarriagewayOrLaneManagement; where the closure affects all lanes it coincides with a road closure (NAPCORE).</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000302"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9ea1716fb0b54f908f9b2bdd5db9992c">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000103"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
