  <rdf:Description rdf:nodeID="N0a4ae248a55d462ba75bac7960aab1b2">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000404"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000304">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Lane closure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Rijstrookafsluiting</skos:prefLabel>
    <skos:definition xml:lang="nl">Het tijdelijk afsluiten van een of meer rijstroken terwijl de overige rijstroken beschikbaar blijven.</skos:definition>
    <skos:definition xml:lang="en">The temporary closure of one or more lanes while the remaining lanes stay available.</skos:definition>
    <skos:scopeNote xml:lang="nl">RTTI-datacategorie lane closures (gepland/ongepland); in het NDW-profiel via RoadOrCarriagewayOrLaneManagement.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RTTI data category lane closures (planned/unplanned); in the NDW profile via RoadOrCarriagewayOrLaneManagement.</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/relations/beschrevenIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
    <rdfs:label xml:lang="en">describedIn</rdfs:label>
    <rdfs:label xml:lang="nl">beschrevenIn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N525f681daa814161bb8656e561994279">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000307"/>
    <rdf:rest rdf:nodeID="Nce38c83eeff94f17a16ba16e0f217c36"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nabefec760b2245f0ab54e5d3c0439379">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000602"/>
    <rdf:rest rdf:nodeID="Ne70c7cfcd0e24ccf9b98cca20706485e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000401">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Diversion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">_Omleiding</skos:prefLabel>
    <skos:definition xml:lang="nl">Het tijdelijk leiden van verkeer langs een alternatieve route wegens een afsluiting of beperking op de gebruikelijke route.</skos:definition>
    <skos:definition xml:lang="en">The temporary guidance of traffic along an alternative route because of a closure or restriction on the usual route.</skos:definition>
    <skos:scopeNote xml:lang="nl">In DATEX II gemodelleerd via ReroutingManagement; in NL uitgewerkt in de CROW-richtlijnen werk in uitvoering.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Modelled in DATEX II via ReroutingManagement; in the Netherlands elaborated in the CROW work in progress guidelines.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000403"/>
    <ns1:geffectueerdIn rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000302">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Road closure setup</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegafzetting</skos:prefLabel>
    <skos:definition xml:lang="nl">Het fysiek afzetten van een werkvak of weggedeelte met bebakening, afzetmateriaal en markering.</skos:definition>
    <skos:definition xml:lang="en">The physical closing off of a work zone or road section using delineation, barrier equipment and markings.</skos:definition>
    <skos:scopeNote xml:lang="nl">Uitgewerkt in de CROW-richtlijnen werk in uitvoering (96a/96b); termen herbruikbaar uit de CROW-thesaurus.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Elaborated in the CROW work in progress guidelines (96a/96b); terms reusable from the CROW thesaurus.</skos:scopeNote>
    <dct:source>https://data.crow.nl/thesaurus/</dct:source>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000303"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1787920171026">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Zone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Zone</skos:prefLabel>
    <skos:editorialNote xml:lang="nl">Definitie bedacht op basis van wat er in DATEXII staat. Omdat DATEXII nog geen formeel semantisch model online heeft staan, kan ik niet direct verwijzen naar wat DATEXII bedacht heeft.</skos:editorialNote>
    <skos:definition xml:lang="en">A contiguous geographic area within which a temporary traffic management measure or traffic management plan applies. Unlike a road section, which denotes a linear stretch of road, a zone delimits an areal region to which the relevant measures, rules or conditions apply.</skos:definition>
    <skos:definition xml:lang="nl">Een aaneengesloten geografisch gebied waarbinnen een tijdelijke verkeersbeheersmaatregel of verkeersmanagementplan van toepassing is. Anders dan een wegvak, dat een lijnvormig weggedeelte aanduidt, bakent een zone een vlakvormig gebied af waarop de betreffende maatregelen, regels of condities gelden.</skos:definition>
    <skos:scopeNote xml:lang="nl">Geïnspireerd op het DATEX II-concept ControlledZone (namespace ControlledZone, v3.4), dat een gebied modelleert waarbinnen verkeersregelgeving geldt. Zie https://docs.datex2.eu/levels/mastering/controlledzones/</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title xml:lang="en">RTTI — Temporary traffic control measures</dct:title>
    <dct:title xml:lang="nl">RTTI — Tijdelijke verkeersbeheersmaatregelen</dct:title>
    <dct:description xml:lang="en">This concept scheme describes the set of temporary traffic management measures taken by or on behalf of the road authority (for a bounded validity period), which is activated for and deactivated after one or more specific triggers or scenarios.</dct:description>
    <dct:description xml:lang="nl">Dit conceptschema beschrijft de door of namens de wegbeheerder genomen set van tijdelijke verkeersmanagementmaatregels (voor een begrensde geldigheidsperiode), die wordt geactiveerd voor en gedeactiveerd na een of meerdere specifieke aanleidingen of scenario's.</dct:description>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T11:14:21.685697+00:00</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T13:46:44.163012+00:00</dct:modified>
    <owl:versionInfo>0.9.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000201">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Road works</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegwerkzaamheden</skos:prefLabel>
    <skos:definition xml:lang="nl">Onderhouds-, aanleg- of reparatiewerkzaamheden op of langs een wegvak die het gebruik van de weg geheel of gedeeltelijk beinvloeden.</skos:definition>
    <skos:definition xml:lang="en">Maintenance, construction or repair works on or alongside a road section that wholly or partly affect the use of the road.</skos:definition>
    <skos:example xml:lang="nl">Zoals werk in uitvoering, onderhoudswerkzaamheden en aanlegwerkzaamheden</skos:example>
    <skos:scopeNote xml:lang="en">NAPCORE data dictionary: road works generally affect individual lanes; where they affect all lanes, they coincide with road closures. In the Netherlands supported by the NDW DATEX II v3 road works profile.</skos:scopeNote>
    <skos:scopeNote xml:lang="nl">NAPCORE data dictionary: wegwerkzaamheden treffen doorgaans afzonderlijke rijstroken; treffen zij alle rijstroken, dan vallen zij samen met wegafsluitingen. In NL ondersteund door het NDW DATEX II v3-profiel wegwerkzaamheden.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Omleidingsroute</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Diversion route</skos:prefLabel>
    <skos:definition xml:lang="nl">De alternatieve route die verkeer volgt zolang de gebruikelijke route is afgesloten of beperkt.</skos:definition>
    <skos:definition xml:lang="en">The alternative route that traffic follows for as long as the usual route is closed or restricted.</skos:definition>
    <skos:scopeNote xml:lang="nl">Onderdeel van het omleidingsontwerp volgens de CROW-richtlijnen werk in uitvoering.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Part of the diversion design according to the CROW work in progress guidelines.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000404"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000401"/>
    <ns1:isOnderdeelVan rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000401"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000502">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Evenement</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Event</skos:prefLabel>
    <skos:definition xml:lang="nl">Een geplande gebeurtenis, zoals een wedstrijd, markt of festival, die de het regulier gebruik van het netwerk verstoren en daardoor tijdelijke verkeersmaatregelen vergt.</skos:definition>
    <skos:definition xml:lang="en">A planned occurrence, such as a sports fixture, market or festival, that requires temporary traffic measures.</skos:definition>
    <skos:scopeNote xml:lang="nl">In het NDW DATEX II v3-profiel ondergebracht bij werkzaamheden en evenementen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Placed under road works and events in the NDW DATEX II v3 profile.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf332150e96a647b0af29deeb8a95a52f">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000505"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/collections/geldigheid-en-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Validity &amp; status</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geldigheid &amp; status</skos:prefLabel>
    <skos:memberList rdf:nodeID="N1c60473028654c26979928d5c8c860c5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nda0a9f53cad34dbca3866b3cc62b45ff">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000601"/>
    <rdf:rest rdf:nodeID="Nabefec760b2245f0ab54e5d3c0439379"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/relations/geffectueerdIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
    <rdfs:label xml:lang="en">Effectuated in</rdfs:label>
    <rdfs:label xml:lang="nl">Geëffectueerd in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary traffic decision</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">+Tijdelijk verkeersbesluit</skos:prefLabel>
    <skos:definition xml:lang="nl">Een verkeersbesluit dat ten grondslag ligt aan een tijdelijke plaatsing of tijdelijke maatregel, vereist wanneer de omstandigheden voor enkele maanden of zich regelmatig voordoen.</skos:definition>
    <skos:definition xml:lang="en">A traffic decision underlying a temporary placement or temporary measure, required where the circumstances last a few months or occur on a regular basis.</skos:definition>
    <skos:scopeNote xml:lang="nl">WVW 1994 jo. BABW art. 37: in afwijking van de hoofdregel geschieden de tijdelijke plaatsing en de tijdelijke maatregel krachtens een verkeersbesluit indien de omstandigheden van langere duur zijn dan vier maanden dan wel zich regelmatig voordoen. De jurisprudentie (o.a. RvS) staat afzien van een verkeersbesluit toe bij dringende omstandigheden van voorbijgaande aard.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">WVW 1994 in conjunction with BABW art. 37: by way of derogation from the main rule, temporary placement and temporary measures are effected pursuant to a traffic decision where the circumstances last longer than four months or occur on a regular basis. Case law (including the Council of State) allows a traffic decision to be waived in the case of urgent circumstances of a passing nature.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0006622</dct:source>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000703">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Deactivering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Deactivation</skos:prefLabel>
    <skos:definition xml:lang="nl">Het beeindigen van een tijdelijke verkeersmaatregel zodra het scenario dat de maatregel triggerde is opgelost.</skos:definition>
    <skos:definition xml:lang="en">The termination of a temporary traffic measure once the scenario that triggered the measure has been resolved.</skos:definition>
    <skos:scopeNote xml:lang="nl">Kernonderscheid tussen verkeersmanagementplan en verkeerscirculatieplan volgens de NAPCORE data dictionary; in de NDW-keten de overgang van actieve naar ruststatus waarbij de bijbehorende maatregelen worden gedeactiveerd.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Core distinction between the traffic management plan and the traffic circulation plan according to the NAPCORE data dictionary; in the NDW chain the transition from active to idle status, whereby the associated measures are deactivated.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000701"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N31862bfffad4422dbc47df20260cb208">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000304"/>
    <rdf:rest rdf:nodeID="Ncb20f4223a9649ef89ea4689a12ca2ec"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000103">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary traffic sign</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tijdelijk verkeersteken</skos:prefLabel>
    <skos:definition xml:lang="nl">Een verkeersteken dat tijdelijk wordt geplaatst of toegepast en na afloop van de aanleiding weer wordt verwijderd of gedeactiveerd.</skos:definition>
    <skos:definition xml:lang="en">A traffic sign that is placed or applied on a temporary basis and is removed or deactivated once the trigger has ended.</skos:definition>
    <skos:scopeNote xml:lang="nl">RVV 1990: tijdelijk geplaatste of toegepaste verkeerstekens op het wegdek gaan boven andere ter plekke aangebrachte wegdektekens voor zover deze onverenigbaar zijn (art. 63a).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RVV 1990: temporarily placed or applied road surface traffic signs take precedence over other road surface markings applied at that location in so far as these are incompatible (art. 63a).</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000308"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/relations/leidtTot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
    <rdfs:label xml:lang="en">canLeadTo</rdfs:label>
    <rdfs:label xml:lang="nl">kanLeidenTot</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000403">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary signposting</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tijdelijke bewegwijzering</skos:prefLabel>
    <skos:definition xml:lang="nl">Tijdelijke aanduidingen op of bij de bestaande bewegwijzering die de omleidingsroute aangeven.</skos:definition>
    <skos:definition xml:lang="en">Temporary indications on or next to the existing signposting that indicate the diversion route.</skos:definition>
    <skos:scopeNote xml:lang="nl">Vormgegeven met gele omleidingsborden conform de CROW-richtlijnen werk in uitvoering.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Designed using yellow diversion signs in accordance with the CROW work in progress guidelines.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/collections/omleiding">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Diversion &amp; temporary signposting</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Omleiding &amp; tijdelijke bewegwijzering</skos:prefLabel>
    <skos:memberList rdf:nodeID="N7efaac40fb4741259f9e31c3fc31b764"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000404">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Emergency diversion route</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Uitwijkroute</skos:prefLabel>
    <skos:definition xml:lang="nl">Een vooraf gedefinieerde en genummerde omleidingsroute (U-route) die bij afsluiting van een autosnelweg wordt opengesteld.</skos:definition>
    <skos:definition xml:lang="en">A predefined and numbered diversion route (Dutch: U-route) that is opened when a motorway is closed.</skos:definition>
    <skos:scopeNote xml:lang="nl">De Nederlandse U-routesystematiek wordt beheerd door Rijkswaterstaat en aangeduid met U-borden.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The Dutch U-route system is managed by Rijkswaterstaat and indicated by U-signs.</skos:scopeNote>
    <dct:source>https://www.rijkswaterstaat.nl/</dct:source>
    <dct:source>https://www.crow.nl/Onderwerpen/Arbo-en-Veiligheid/Werk-in-uitvoering/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000402"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Disturbance</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">+Verstoring</skos:prefLabel>
    <skos:definition xml:lang="nl">De gebeurtenis of conditie die de activering van een set van tijdelijke verkeersmaatregelen of een strategie veroorzaakt.</skos:definition>
    <skos:definition xml:lang="en">The event or condition that causes the activation of a set off temporary traffic measures or a strategy.</skos:definition>
    <skos:scopeNote xml:lang="nl">Verzamelconcept voor de situaties die een verkeersmanagementplan of tijdelijke maatregel triggeren (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Collective concept for the situations that trigger a traffic management plan or a temporary measure (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:narrower rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"/>
    <skos:narrower rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511855955"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
    <ns1:triggert rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000505">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">+Extreem weer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Extreme weather</skos:prefLabel>
    <skos:definition xml:lang="en">Weather conditions, such as storm, black ice or snow, that require the activation of a set of temporary traffic measures.</skos:definition>
    <skos:definition xml:lang="nl">Weersomstandigheden, zoals storm, ijzel of sneeuw, die de activering van een set van tijdelijke verkeersmaatregelen vergen.</skos:definition>
    <skos:scopeNote xml:lang="nl">Een van de condities die een verkeersmanagementplan kunnen triggeren (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">One of the conditions that can trigger a traffic management plan (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511877986"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne70c7cfcd0e24ccf9b98cca20706485e">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000603"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
