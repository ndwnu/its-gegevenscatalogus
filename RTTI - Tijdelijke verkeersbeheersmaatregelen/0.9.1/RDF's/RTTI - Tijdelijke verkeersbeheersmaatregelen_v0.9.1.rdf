  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000306">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="en">Temporary speed limit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tijdelijke snelheidsbeperking</skos:prefLabel>
    <skos:definition xml:lang="nl">Een tijdelijk verlaagde maximumsnelheid die bij wegwerkzaamheden of een ander scenario wordt ingesteld en na afloop wordt opgeheven.</skos:definition>
    <skos:definition xml:lang="en">A temporarily reduced speed limit imposed during road works or another scenario and lifted once these have ended.</skos:definition>
    <skos:scopeNote xml:lang="nl">In DATEX II vastgelegd als SpeedManagement met speedManagementType speedRestrictionInOperation, een temporarySpeedLimit en complianceOption mandatory (NDW-profiel). Verwijst naar het snelheidsbeperkingen-model zonder dit te dupliceren.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Recorded in DATEX II as SpeedManagement with speedManagementType speedRestrictionInOperation, a temporarySpeedLimit and complianceOption mandatory (NDW profile). References the speed restrictions model without duplicating it.</skos:scopeNote>
    <dct:source>https://docs.ndw.nu/dataformaten/datex2-v3/wwz/</dct:source>
    <dct:source>https://docs.datex2.eu/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000301"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N853e48e8600e497e923f6f3a3f30e811">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000201"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen/concept-1788511855955">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-tijdelijke-verkeersmaatregelen"/>
    <skos:prefLabel xml:lang="nl">Gepland</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Planned</skos:prefLabel>
    <skos:definition xml:lang="nl">Een verstoring die vooraf bekend en ingepland is.</skos:definition>
    <skos:definition xml:lang="en">A disruption that is known and scheduled in advance.</skos:definition>
    <skos:editorialNote xml:lang="nl">Definitie toegevoegd:

Een verstoring die vooraf bekend en ingepland is.</skos:editorialNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000501"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000201"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-tijdelijke-verkeersmaatregelen/concept-1773250000502"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N415616ba93ad44b2aad916b37f7b7ef8">
