    <skos:prefLabel xml:lang="nl">Snelheidsbeperking o.b.v. voertuigtype</skos:prefLabel>
    <skos:memberList rdf:nodeID="N112e2345836a43f6a3b3bf56b2768428"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N774a3acc2d88471fbb16ee18b1700192">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235022627"/>
