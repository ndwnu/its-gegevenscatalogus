    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het blikken- of digitale bord waarmee een snelheidsbeperking aan de weggebruiker kenbaar wordt gemaakt."
      },
      {
        "@language": "en",
        "@value": "The tin or digital sign by which a speed limit is communicated to road users."
      }
    ],
