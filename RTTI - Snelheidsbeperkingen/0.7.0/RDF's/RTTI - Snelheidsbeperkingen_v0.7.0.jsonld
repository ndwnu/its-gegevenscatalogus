  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235164125",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een als erf aangeduid deel van de openbare weg, begrensd door bord G5 (begin erf) en bord G6 (einde erf). Op een erf geldt een maximumsnelheid van 15 km/h."
      },
      {
        "@language": "en",
        "@value": "A part of the public road designated as a residential area (erf), bounded by sign G5 (start of residential area) and sign G6 (end of residential area). Within a residential area a maximum speed of 15 km/h applies."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Woonerf"
      },
      {
        "@language": "en",
        "@value": "Residential Area"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "HR 1 november 2011, ECLI:NL:HR:2011:BR5927; voorheen 'stapvoets'"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://www.opengis.net/ont/sf"
      },
      {
        "@value": "https://modellen.geostandaarden.nl/def/nen3610-2022/"
      },
      {
        "@value": "https://docs.geostandaarden.nl/nen3610/gimeg/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een ééndimensionale geometrische primitief die een lijn representeert: een continue, in een coördinatensysteem meetbare lijn die bestaat uit één of meer onderling verbonden lijnsegmenten, waarbij het eindpunt van elk segment — op het laatste na — verbonden is met het beginpunt van het volgende. Lijngeometrie wordt gebruikt om lijnvormige objecten, zoals een weg, ruimtelijk vast te leggen; in ISO 19107 aangeduid als GM_Curve en Curve/LineString in OGC simple features."
      },
      {
        "@language": "en",
        "@value": "A one-dimensional geometric primitive representing a line: a continuous curve, measurable in length within a coordinate system, composed of one or more connected line segments in which the end point of each segment — except the last — coincides with the start point of the next. Line geometry is used to spatially represent linear features such as a road; designated GM_Curve in ISO 19107 and Curve/LineString in OGC Simple Features"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Line geometry"
      },
      {
        "@language": "nl",
        "@value": "Lijngeometrie"
      }
    ]
  },
