  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235620358",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Elk voor rijdend verkeer bestemd weggedeelte, met uitzondering van de fietspaden en de fiets/bromfietspaden."
      },
      {
        "@language": "en",
        "@value": "Any part of the road intended for moving traffic, with the exception of cycle paths and cycle/moped paths."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Carriageway"
      },
      {
        "@language": "nl",
        "@value": "Rijbaan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235638908"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186214125"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In het kader van snelheidsbeperkingen kan een aanduiding specifiek betrekking hebben op één rijbaan van een weg."
      }
    ]
  },
