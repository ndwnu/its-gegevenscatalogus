  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238916868",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Gegevenstype binnen de RTTI-context dat de verzameling van concepten beschrijft die nodig zijn om een snelheidsbeperking op het Nederlandse wegennet eenduidig vast te leggen en uit te wisselen. Omvat de waarde van de snelheidsbeperking, de locatie, de geldigheid, de aanduiding en eventuele uitzonderingen."
      },
      {
        "@language": "en",
        "@value": "Data type within the RTTI context describing the set of concepts required to unambiguously record and exchange a speed limit on the Dutch road network. Encompasses the value of the speed limit, the location, the validity, the indication and any exceptions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Gegevenstype Snelheidsbeperkingen"
      },
      {
        "@language": "en",
        "@value": "Speed Limit Data Type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Dit gegevenstype is gedefinieerd als onderdeel van de Nederlandse implementatie van de ITS-richtlijn (Richtlijn 2010/40/EU) en de daaronder vallende Gedelegeerde Verordening RTTI (EU) 2022/670."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772187355998",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=15"
      },
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=1:3"
      },
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=26"
      },
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=21"
      },
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=12"
      },
      {
        "@value": "https://wetten.overheid.nl/jci1.3:c:BWBR0006622&artikel=18"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Schriftelijk besluit als van het bevoegde gezag waarbij wordt besloten tot plaatsing, wijziging of verwijdering van bij algemene maatregel van bestuur aangewezen verkeerstekens en onderborden voor zover daardoor een gebod of verbod ontstaat of wordt gewijzigd, dan wel tot maatregelen op of aan de weg die leiden tot een beperking of uitbreiding van het aantal categorieën weggebruikers."
      },
      {
        "@language": "en",
        "@value": "Written decision by the competent authority deciding on the placement, modification, or removal of traffic signs and supplementary signs designated by Order in Council insofar as this creates or modifies a command or prohibition, or on measures on or along the road that lead to a restriction or expansion of the number of categories of road users."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Verkeersbesluit"
      },
      {
        "@language": "en",
        "@value": "Traffic decision"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Bekendmaking geschiedt op grond van artikel 26 BABW via de KOOP-Verkeersbesluitenapplicatie in de Staatscourant (Rijk) dan wel het eigen publicatieblad (gemeente, provincie, waterschap) sinds inwerkingtreding van de Wet elektronische publicaties op 1 juli 2021. Motiveringseisen volgen uit artikel 21 BABW; overleg met de korpschef volgt uit artikel 24 BABW."
      },
      {
        "@language": "en",
        "@value": "Publication takes place pursuant to Article 26 of the BABW via the KOOP Traffic Decisions application in the Government Gazette (National Government) or the local publication journal (municipality, province, water board) since the entry into force of the Electronic Publications Act on 1 July 2021. Requirements for justification follow from Article 21 of the BABW; consultation with the Chief of Police follows from Article 24 of the BABW."
      }
    ]
  },
