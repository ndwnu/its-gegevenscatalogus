  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235313383",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Weg, aangeduid door bord G3. Buiten de bebouwde kom geldt op autowegen een wettelijke maximumsnelheid van 100 km/h voor motorvoertuigen tenzij anders aangegeven.\n\nOp autowegen mogen uitsluitend motorvoertuigen rijden die minimaal 50 km/h kunnen en mogen rijden."
      },
      {
        "@language": "en",
        "@value": "Road indicated by sign G3. Outside built-up areas a statutory maximum speed of 100 km/h applies to motor vehicles on expressways unless otherwise indicated.\n\nOnly motor vehicles that are able and permitted to drive at least 50 km/h may use expressways."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Expressway"
      },
      {
        "@language": "nl",
        "@value": "Autoweg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Langs autowegen gelegen parkeerplaatsen, tankstations en bushalteplaatsen maken geen deel van de autoweg uit."
      }
    ]
  },
