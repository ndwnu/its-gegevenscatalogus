          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Dynamische snelheidsbeperking"
      },
      {
        "@language": "nl",
        "@value": "Dynamische snelheidsbeperking"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236142216",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236172013"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het verkeersteken dat het eindpunt aangeeft van de geldigheid van een snelheidsbeperking."
      },
      {
        "@language": "en",
        "@value": "The traffic sign indicating the point at which the validity of a speed limit ends."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Dit kan zijn: een bord A2 (einde maximumsnelheid), een zonebord (bijv. A01-30-ZE voor einde 30 km/h-zone), een bord G2/G4/G6 (einde autosnelweg/autoweg/erf), het deactiveren van een elektronisch signaleringsbord, of het bereiken van een kruispunt waarachter een ander regime geldt."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Aanduiding einde"
      },
      {
        "@language": "en",
        "@value": "End Indication"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235638908",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Door doorgetrokken of onderbroken strepen gemarkeerd gedeelte van de rijbaan van zodanige breedte dat bestuurders van motorvoertuigen op meer dan twee wielen daarvan gebruik kunnen maken. \n\nBij toepassing van een verkeersbord op specifieke rijstroken kan een snelheidsbeperking beperkt worden tot één of meer rijstroken.\nBijvoorbeeld bij spitsstroken of matrixborden."
      },
      {
        "@language": "en",
        "@value": "Part of the carriageway, marked by continuous or broken lines, of such a width that drivers of motor vehicles on more than two wheels can make use of it.\n\nWhen a traffic sign is applied to specific lanes, a speed limit can be restricted to one or more lanes, for example at rush-hour lanes or matrix signs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Lane"
      },
      {
        "@language": "nl",
        "@value": "Rijstrook"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186214125"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235085917"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235331951",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Weg, aangeduid door bord G1. Buiten de bebouwde kom geldt op autosnelwegen een wettelijke maximumsnelheid van 130 km/h voor motorvoertuigen tenzij anders aangegeven.\n\nOp autosnelwegen mogen uitsluitend motorvoertuigen rijden die minimaal 60 km/h kunnen en mogen rijden."
      },
      {
        "@language": "en",
        "@value": "Road indicated by sign G1. Outside built-up areas a statutory maximum speed of 130 km/h applies to motor vehicles on motorways unless otherwise indicated.\n\nOnly motor vehicles that are able and permitted to drive at least 60 km/h may use motorways."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Motorway"
      },
      {
        "@language": "nl",
        "@value": "Autosnelweg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Langs autosnelwegen gelegen parkeerplaatsen, tankstations en bushalteplaatsen maken geen deel van de autosnelweg uit."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236446358",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een conditie waardoor de standaard snelheidsbeperking op een wegvak wordt gemodificeerd. Uitzonderingen worden in de Nederlandse praktijk kenbaar gemaakt via onderborden en kunnen betrekking hebben op voertuigtype, tijdvenster, weersomstandigheden of andere voorwaarden."
      },
      {
        "@language": "en",
        "@value": "A condition that modifies the standard speed limit on a road section. In Dutch practice such conditions are communicated via supplementary signs and may relate to vehicle type, time window, weather conditions or other circumstances."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Condition"
      },
      {
        "@language": "nl",
        "@value": "Conditie"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236028582"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186160984"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236028582",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Meteorologische condities (zoals regen, mist, sneeuw, ijzel of storm) die aanleiding geven tot een aangepaste snelheidsbeperking. \nIn Nederland worden weersafhankelijke snelheidsbeperkingen met name dynamisch ingesteld via matrixsignalering op autosnelwegen (RWS – Praktijkrichtlijn Dynamisch Verkeersmanagement) of statisch aangegeven via onderborden (bijv. 'bij nat wegdek')."
      },
      {
        "@language": "en",
        "@value": "Meteorological conditions (such as rain, fog, snow, black ice or storm) that give rise to an adjusted speed limit.\nIn the Netherlands weather-dependent speed limits are mainly set dynamically via matrix signalling on motorways (RWS – Praktijkrichtlijn Dynamisch Verkeersmanagement) or indicated statically via supplementary signs (e.g. 'when the road surface is wet')."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Weather Conditions"
      },
      {
        "@language": "nl",
        "@value": "Weersomstandigheden"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772187859423",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het gebied buiten de door de gemeenteraad vastgestelde bebouwde kom. Buiten de bebouwde kom gelden de maximumsnelheden  130 km/h op autosnelwegen, 100 km/h op autowegen en 80 km/h op overige wegen, tenzij door verkeersborden anders is aangegeven."
      },
      {
        "@language": "en",
        "@value": "The area outside the built-up area established by the municipal council. Outside the built-up area the maximum speeds are 130 km/h on motorways, 100 km/h on expressways and 80 km/h on other roads, unless otherwise indicated by traffic signs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Is dit een goede toevoeging voor 'rest categorie'? RobS: RVV noemt dit \"andere wegen\" https://wetten.overheid.nl/jci1.3:c:BWBR0004825&hoofdstuk=II&paragraaf=8&artikel=21&z=2026-01-01&g=2026-01-01"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "N-road"
      },
      {
        "@language": "nl",
        "@value": "N-weg"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236355335",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Elektronisch signaleringsbord waarop verkeersborden dynamisch kunnen worden weergegeven. Een digitaal bord kan een lagere snelheid aangeven dan het statische ('blikken') bord; in dat geval geldt de lagere snelheid van het digitale bord. Pas wanneer het digitale bord een einde-aanduiding toont of blanco is, herleeft de snelheidsbeperking van het statische bord. Digitale borden worden met name ingezet op autosnelwegen via matrixsignalering (RWS)."
      },
      {
        "@language": "en",
        "@value": "An electronic signalling sign on which traffic signs can be displayed dynamically. A digital sign can indicate a lower speed than the static ('tin') sign; in that case the lower speed of the digital sign applies. Only when the digital sign shows an end indication or is blank does the speed limit of the static sign revive. Digital signs are used in particular on motorways via matrix signalling (RWS)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Actuator"
      },
      {
        "@language": "nl",
        "@value": "Actuator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Het digitale bord heeft een hogere geldigheid indien een digitaal bord een lagere snelheid aan dan de blikken borden.\n\nPas als als het digitale bord een einde aanduiding aangeeft, dan geld het blikken bord in. \n\n\"Zie het als een digitale zone\""
      },
      {
        "@language": "nl",
        "@value": "Zijnde een Matrixsignaalgeversinstallatie, Kantelwalsbord of DRIP"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235874098",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Classification of a vehicle based on the statutory categorisation in the RVV 1990 and the Vehicle Regulations.\n\nRelevant for speed limits because the law establishes special maximum speeds per vehicle category."
      },
      {
        "@language": "nl",
        "@value": "Classificatie van een voertuig op basis van de wettelijke indeling in het RVV 1990 en het Voertuigreglement. \n\nRelevant voor snelheidsbeperkingen omdat de wet bijzondere maximumsnelheden per voertuigcategorie vaststelt."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "T-100 bus mag maximaal 100 km/h"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Vehicle category"
      },
      {
        "@language": "nl",
        "@value": "Voertuigcategorie"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235085917",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Gedeelte van een weg tussen twee opeenvolgende knooppunten of kruispunten, of – indien geen zijweg aanwezig is – tussen twee punten waarop een verkeersmaatregel betrekking heeft. \n\nIn het Nationaal Wegenbestand (NWB) is een wegvak de kleinste eenheid waarvoor wegkenmerken worden geregistreerd."
      },
      {
        "@language": "en",
        "@value": "A section of road between two consecutive junctions or intersections, or – if no side road is present – between two points to which a traffic measure applies.\n\nIn the National Road Database (NWB) a road section is the smallest unit for which road attributes are registered."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Wegvak"
      },
      {
        "@language": "en",
        "@value": "Road section"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236090614",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236172013"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het verkeersteken dat het beginpunt aangeeft van de geldigheid van een snelheidsbeperking."
      },
      {
        "@language": "en",
        "@value": "The traffic sign indicating the point at which the validity of a speed limit begins."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Start Indication"
      },
      {
        "@language": "nl",
        "@value": "Aanduiding begin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Dit kan zijn: een bord A1 (maximumsnelheid) of een zonebord (bijv. A01-30-ZB voor begin 30 km/h-zone), een bord G1/G3/G5 (begin autosnelweg/autoweg/erf), of de activering van een elektronisch signaleringsbord."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237259923",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een zone die genest is binnen een omsluitende zone en waarvan de snelheidsbeperking voorrang heeft boven die van de omsluitende zone zolang de weggebruiker zich binnen de inliggende zone bevindt."
      },
      {
        "@language": "en",
        "@value": "A zone nested within an enclosing zone, whose speed limit takes precedence over that of the enclosing zone for as long as the road user is within the inner zone."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Inner regime"
      },
      {
        "@language": "nl",
        "@value": "Inliggend regime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The inner zone concept describes the cascading effect of nested zones. When entering an inner zone, the speed restriction of the enclosing zone is temporarily suspended. When exiting, the speed restriction of the enclosing zone becomes active again. This mechanism works recursively: multiple levels of nesting are possible."
      },
      {
        "@language": "nl",
        "@value": "Het concept inliggende zone beschrijft het cascaderend effect van geneste zones. Bij het inrijden van een inliggende zone wordt de snelheidsbeperking van de omsluitende zone tijdelijk opgeschort. Bij het uitrijden wordt de snelheidsbeperking van de omsluitende zone weer actief. Dit mechanisme werkt recursief: meerdere niveaus van nesting zijn mogelijk."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/collections/snelheidsbeperking-o-b-v-voertuigtype",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#OrderedCollection"
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#memberList": [
      {
        "@list": [
          {
            "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238916868"
          },
          {
            "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"
          },
          {
            "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235874098"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Snelheidsbeperking o.b.v. voertuigtype"
      },
      {
        "@language": "nl",
        "@value": "Snelheidsbeperking o.b.v. voertuigtype"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De toegestane snelheid op een weg of weggedeelte, uitgedrukt in kilometers per uur (km/h). In Nederland wordt de maximumsnelheid bepaald door: \n\n(1) de wettelijke standaardlimieten \n(2) door middel van verkeersborden \n(3) dynamisch ingestelde limieten via digitale borden."
      },
      {
        "@language": "en",
        "@value": "The permitted speed on a road or road section, expressed in kilometres per hour (km/h). In the Netherlands the maximum speed is determined by:\n\n(1) the statutory default limits\n(2) by means of traffic signs\n(3) dynamically set limits via digital signs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Snelheidsbeperking"
      },
      {
        "@language": "en",
        "@value": "Speedlimit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236172013"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In Nederland gaat het voornamelijk over maximum snelheden. Minimum snelheden zijn afhankelijk van het voertuigtype."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een ruimtelijk afgebakend gebied waarbinnen een uniform verkeersregime geldt, begrensd door verkeerstekens die het begin en het einde van het regime aanduiden. \n\nBinnen de context van snelheidsbeperkingen is een gesloten zone een gebied waarvan de grenzen worden gemarkeerd door zoneborden (bijv. bord A01-30-ZB / A01-30-ZE voor een 30 km/h-zone, of bord G5/G6 voor een erf)."
      },
      {
        "@language": "en",
        "@value": "A spatially demarcated area within which a uniform traffic regime applies, bounded by traffic signs indicating the start and end of the regime.\n\nWithin the context of speed limits, a closed zone is an area whose boundaries are marked by zone signs (e.g. sign A01-30-ZB / A01-30-ZE for a 30 km/h zone, or sign G5/G6 for a residential area)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Geometrie"
      },
      {
        "@language": "en",
        "@value": "Geometry"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236090614"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236142216"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Het BABW art. 9 bepaalt dat in een verkeersbesluit kan worden bepaald dat geboden of verboden gelden in een bepaald gebied (zonale toepassing)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186160984",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://kennisbank.crow.nl/public/gastgebruiker/FVV/Verkeerstekens_(toepassing,_plaatsing_en_uitvoering)/Hoofdstuk_C._Geslotenverklaring/29510"
      },
      {
        "@value": "https://www.rijkswaterstaat.nl/wegen/wetten-regels-en-vergunningen/verkeerswetten/maximumsnelheid"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826/"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De op een onderbord vermelde dagen en/of uren die een beperking van de werkingssfeer in de tijd inhouden van de aanduiding op het bovenliggende verkeersbord; in het bijzonder, voor snelheidsbeperkingen, het tijdvak waarbinnen de op het verkeersbord aangeduide maximumsnelheid geldt."
      },
      {
        "@language": "en",
        "@value": "The days and/or hours indicated on a supplementary sign that imply a limitation of the temporal scope of application of the indication on the overlying traffic sign; in particular, for speed limits, the period during which the maximum speed indicated on the traffic sign applies."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Tijdvenster"
      },
      {
        "@language": "en",
        "@value": "Time window"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De term 'tijdvenster' komt niet als zodanig voor in de wetgeving; de juridische grondslag ligt in de beperking van de werkingssfeer en wordt door Rijkswaterstaat en CROW als 'tijdvenster' aangeduid. Het concept kent een dubbele realisatie: als fysiek onderbord onder een blikken bord, of als tijdsconditie binnen een digitaal/elektronisch bord. Niet te verwarren met 'venstertijden' (laad- en lostijden voor stadslogistiek), dat in het model Goederenlevering is ondergebracht."
      },
      {
        "@language": "en",
        "@value": "The term 'time window' does not appear as such in the legislation; the legal basis lies in the limitation of the scope and is referred to as a 'time window' by Rijkswaterstaat and CROW. The concept has a dual realization: as a physical supplementary sign beneath a metal sign, or as a time condition within a digital/electronic sign. Not to be confused with 'window times' (loading and unloading times for urban logistics), which are incorporated into the Goods Delivery model."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236944308",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het gebied dat als bebouwde kom is vastgesteld door de gemeenteraad.\n\nDe bebouwde kom wordt aangeduid door de borden H1 (begin bebouwde kom) en H2 (einde bebouwde kom). De snelheidsbeperking van 50 km/h is van toepassing tenzij door verkeersborden anders is aangegeven."
      },
      {
        "@language": "en",
        "@value": "The area established as a built-up area by the municipal council.\n\nThe built-up area is indicated by signs H1 (start of built-up area) and H2 (end of built-up area). A speed limit of 50 km/h applies unless otherwise indicated by traffic signs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Built-Up Area"
      },
      {
        "@language": "nl",
        "@value": "Bebouwde kom"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "nader te bepalen"
      },
      {
        "@language": "en",
        "@value": "to be decided"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Vlak geometrie"
      },
      {
        "@language": "en",
        "@value": "Area geometry"
      }
    ]
  }
]