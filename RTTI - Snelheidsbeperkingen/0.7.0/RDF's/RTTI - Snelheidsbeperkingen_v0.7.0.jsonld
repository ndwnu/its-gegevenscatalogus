    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het fysieke object — een paneel (de 'plaat'), doorgaans bevestigd op een paal of andere drager — waarop een verkeersteken als is aangebracht, en waarvan de uitvoering wettelijk is voorgeschreven."
      },
      {
        "@language": "en",
        "@value": "The physical object — a panel (the 'plate'), normally mounted on a post or other support — bearing a traffic sign symbol, whose physical execution is legally prescribed."
      }
    ],
