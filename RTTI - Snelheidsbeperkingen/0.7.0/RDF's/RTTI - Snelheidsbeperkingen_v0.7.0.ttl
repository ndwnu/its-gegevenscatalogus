<https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186485225> a skos:Concept ;
    skos:definition "to be decided"@en,
        "nader te bepalen"@nl ;
    skos:inScheme <https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen> ;
    skos:narrower <https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235313383>,
        <https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235331951>,
