      {
        "@language": "nl",
        "@value": "Dynamische gegevens"
      },
      {
        "@language": "en",
        "@value": "Dynamische gegevens"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De terugkoppeling van een gebruiker over een vrachtwagenparkeerterrein of over de verstrekte informatie daarover, zoals een beoordeling, een opmerking of een melding van onjuiste gegevens."
      },
      {
        "@language": "en",
        "@value": "The response from a user about a truck parking area or about the information provided on it, such as a rating, a comment or a report of incorrect data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Fictief voorbeeld — een chauffeur meldt anoniem via een app dat het gepubliceerde aantal vrije plaatsen op Truckparking Voorbeeldstad niet overeenkomt met de werkelijke bezetting."
      },
      {
        "@language": "en",
        "@value": "Fictitious example — a driver anonymously reports via an app that the published number of available spaces at Truckparking Voorbeeldstad does not match the actual occupancy."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Gebruikersfeedback"
      },
      {
        "@language": "en",
        "@value": "User Feedback"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gebruikersfeedback mag anoniem worden gegeven. De feedback kan worden gebruikt om de kwaliteit van de gepubliceerde statische en dynamische gegevens te verbeteren."
      },
      {
        "@language": "en",
        "@value": "User feedback may be given anonymously. The feedback can be used to improve the quality of the published static and dynamic data."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het actuele aantal onbezette parkeerplaatsen voor vrachtwagens op een vrachtwagenparkeerterrein."
      },
      {
        "@language": "en",
        "@value": "The current number of unoccupied truck parking spaces at a truck parking area."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "_Aantal vrije parkeerplaatsen"
      },
      {
        "@language": "en",
        "@value": "Number of Vacant Spaces"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De identificatie en rijrichting van de weg of wegen (maximaal twee) waarvan het vrachtwagenparkeerterrein direct toegankelijk is."
      },
      {
        "@language": "en",
        "@value": "The identifier and travel direction of the road or roads (maximum two) from which the truck parking area is directly accessible."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Weg: A2, richting: Den Haag; nevenweg: N2, richting: Eindhoven-Centrum."
      },
      {
        "@language": "en",
        "@value": "Road: A2, direction: Den Haag; secondary road: N2, direction: Eindhoven-Centrum."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Primaire weg"
      },
      {
        "@language": "en",
        "@value": "Primary Road"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Wegidentificatoren volgen de Nederlandse nationale nummeringsconventie: A-wegen (autosnelwegen), N-wegen (nationale wegen) en S-wegen (stadsroutes). Wegidentificatoren worden bijgehouden in het NWB (Nationaal Wegenbestand). Het richtingsveld geeft de hoofdbestemming aan die wordt bediend, zodat bestuurders het relevante parkeerterrein kunnen identificeren vanuit routegeleiding."
      },
      {
        "@language": "en",
        "@value": "Road identifiers follow the Dutch national numbering convention: A-wegen (autosnelwegen), N-wegen (nationale wegen), and S-wegen (stadsroutes). Road identifiers are maintained in the NWB (Nationaal Wegenbestand). The direction field indicates the main destination served, enabling drivers to identify the relevant parking area from route guidance."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De afstand tussen de te nemen afrit en het toegangspunt van het vrachtwagenparkeerterrein."
      },
      {
        "@language": "en",
        "@value": "The distance between the exit to be taken and the entry point of the truck parking area."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Fictief voorbeeld — rijafstand van afrit 99 tot het toegangspunt: 850 m."
      },
      {
        "@language": "en",
        "@value": "Fictitious example — travel distance from exit 99 to the entry point: 850 m."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Afstand tot primaire weg"
      },
      {
        "@language": "en",
        "@value": "Distance from Primary Road"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Bij voorkeur uitgedrukt als rijafstand over de weg in meters, niet als hemelsbrede afstand. Voor vrachtwagenparkeerterreinen die niet langs een autosnelweg liggen, geldt de weg van de hoogste orde in de nabijheid als primaire weg; dit gegeven kan dan optioneel zijn."
      },
      {
        "@language": "en",
        "@value": "Preferably expressed as the travel distance by road in metres, not as the straight-line distance. For truck parking areas not located along a motorway, the road of the highest order in the vicinity is regarded as the primary road; this data item may then be optional."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773739249931",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De toegang tot het vrachtwagenparkeerterrein."
      },
      {
        "@language": "en",
        "@value": "The entrance to the truck parking area."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Ingang"
      },
      {
        "@language": "en",
        "@value": "Entrence"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De perioden gedurende welke een vrachtwagenparkeerterrein open en toegankelijk is voor voertuigen, inclusief eventuele beperkingen per dag van de week of tijdstip. Relevant zowel voor toegangsvoorwaarden als voor de geldigheid van tariefinformatie."
      },
      {
        "@language": "en",
        "@value": "The periods during which a truck parking area is open and accessible to vehicles, including any restrictions by day of week or time of day. Relevant both to access conditions and to the validity of tariff information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Open 24/7 het hele jaar; of: maandag–vrijdag 06:00–22:00, zaterdag 08:00–18:00, gesloten op zondag en feestdagen."
      },
      {
        "@language": "en",
        "@value": "Open 24/7 all year; or: Monday–Friday 06:00–22:00, Saturday 08:00–18:00, closed on Sundays and public holidays."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Tijdvenster"
      },
      {
        "@language": "en",
        "@value": "Operating Hours"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "24/7-beschikbaarheid is een vereiste voor Goud- en Platina-certificering onder DR (EU) 2022/1012 Bijlage I. Openingstijden kunnen de betrouwbaarheid van real-time beschikbaarheidsgegevens beïnvloeden: een gesloten parkeerterrein dient in het dynamische gegevenstype als 'gesloten' te worden weergegeven. In DATEX II correspondeert dit met OpeningTimes binnen de ParkingRecord-structuur."
      },
      {
        "@language": "en",
        "@value": "24/7 availability is a prerequisite for Gold and Platinum certification under DR (EU) 2022/1012 Annex I. Operating hours may affect the reliability of real-time availability data: a closed parking area should be reflected in the dynamic data type as 'closed'. In DATEX II this maps to OpeningTimes within the ParkingRecord structure."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het totale aantal parkeerplaatsen dat op een parkeerterrein is bestemd voor vrachtwagens en bedrijfsvoertuigen, zoals vereist in Gedelegeerde Verordening (EU) nr. 885/2013."
      },
      {
        "@language": "en",
        "@value": "The total number of parking spaces designated for trucks and commercial vehicles at a parking area, as required by Delegated Regulation (EU) No 885/2013."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Totaal vrachtwagenplaatsen: 120 (waarvan 8 koelplaatsen). De statische capaciteit blijft 120 ongeacht de actuele bezetting."
      },
      {
        "@language": "en",
        "@value": "Total truck spaces: 120 (of which 8 refrigerated). The static capacity remains 120 regardless of current occupancy."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Parkeercapaciteit"
      },
      {
        "@language": "en",
        "@value": "Parking Capacity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Het capaciteitscijfer betreft uitsluitend plaatsen gedimensioneerd voor vrachtwagencombinaties (opleggers/semi-trailers) tenzij anders aangegeven. \n\nPlaatsen voor koelvoertuigen worden afzonderlijk gerapporteerd. \n\nDe capaciteit kan een statisch of een dynamisch gegeven zijn."
      },
      {
        "@language": "en",
        "@value": "The capacity figure refers exclusively to spaces dimensioned for articulated lorries (opleggers/semi-trailers) unless otherwise specified. \n\nSpaces for refrigerated goods vehicles are reported separately. \n\nThe capacity can concern static and dynamic figures."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Het publiekrechtelijk orgaan dat juridisch verantwoordelijk is voor een weg en de daarmee verbonden infrastructuur, inclusief vrachtwagenparkeerterreinen op of naast die weg. De wegbeheerder is tevens het bevoegd gezag voor het nemen van een verkeersbesluit."
      },
      {
        "@language": "en",
        "@value": "The public body legally responsible for a road and any associated infrastructure, including truck parking areas on or adjacent to that road. The wegbeheerder is also the competent authority for issuing a verkeersbesluit."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Rijkswaterstaat (voor A2 Truck Parking langs de A2); Gemeente Amsterdam (voor een gemeentelijk aangewezen vrachtwagenparkeerterrein binnen de gemeentegrenzen)."
      },
      {
        "@language": "en",
        "@value": "Rijkswaterstaat (for A2 Truck Parking along the A2); Gemeente Amsterdam (for a municipally designated truck parking area within city limits)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Wegbeheerder"
      },
      {
        "@language": "en",
        "@value": "Road Authority"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De bevoegdheid is geregeld in WVW 1994 artikel 18: Rijkswaterstaat voor rijkswegen (A-wegen en bepaalde N-wegen), het college van Gedeputeerde Staten voor provinciale wegen, en het college van B&W voor gemeentelijke wegen. Op verzorgingsplaatsen is Rijkswaterstaat zowel wegbeheerder als doorgaans concessieverlener voor de serviceexploitant."
      },
      {
        "@language": "en",
        "@value": "Authority is determined by WVW 1994 Article 18: Rijkswaterstaat for national highways (A-wegen and certain N-wegen), the provincial executive (Gedeputeerde Staten) for provincial roads, and the municipal executive (B&W) for municipal roads. On verzorgingsplaatsen, Rijkswaterstaat is both wegbeheerder and often concession grantor for the service operator."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De rechtspersoon die verantwoordelijk is voor het dagelijks beheer en de exploitatie van een vrachtwagenparkeerterrein, inclusief het verstrekken van contactgegevens voor publicatie, zoals vereist door de Gedelegeerde Verordening (EU) nr. 885/2013."
      },
      {
        "@language": "en",
        "@value": "The legal entity responsible for the day-to-day management and operation of a truck parking area, including the provision of contact information for publication, as required by Delegated Regulation (EU) No 885/2013."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Fictief voorbeeld — exploitant: Voorbeeldparking B.V., KvK 00000000; publicatietoestemming contactgegevens: ja."
      },
      {
        "@language": "en",
        "@value": "Fictitious example — operator: Voorbeeldparking B.V., Chamber of Commerce (KvK) number 00000000; consent to publish contact details: yes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Exploitant"
      },
      {
        "@language": "en",
        "@value": "Operator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De identiteit van de exploitant kan worden geverifieerd via de Nederlandse KvK-registratie (Kamer van Koophandel). Het registreert of de exploitant heeft ingestemd met het openbaar beschikbaar stellen van zijn contactgegevens via het nationaal toegangspunt. De exploitant kan afwijken van de wegbeheerder, met name bij particulier geëxploiteerde vrachtwagenparkeerterreinen."
      },
      {
        "@language": "en",
        "@value": "The operator's identity can be verified against the Dutch Chamber of Commerce (Kamer van Koophandel) registration. The information records whether the operator has consented to their contact details being made publicly available via the national access point. The operator may differ from the wegbeheerder (road authority), particularly at privately operated truck parking facilities."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De gegevens waarmee gebruikers van een vrachtwagenparkeerterrein contact kunnen opnemen met de exploitant of een daaraan verbonden onderneming, bestaande uit het telefoonnummer en het e-mailadres van het contactpunt en optioneel de naam van de contactpersoon."
      },
      {
        "@language": "en",
        "@value": "The information enabling users of a truck parking area to contact the parking operator or an associated company, comprising the telephone number and e-mail address of the contact point and, optionally, the name of the contact person."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "nl",
        "@value": "Fictief voorbeeld — contactpunt: receptie Truckparking Voorbeeldstad; telefoon: +31 00 000 0000; e-mail: contact@voorbeeldparking.example."
      },
      {
        "@language": "en",
        "@value": "Fictitious example — contact point: reception Truckparking Voorbeeldstad; telephone: +31 00 000 0000; e-mail: contact@voorbeeldparking.example."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Contactgegevens exploitant"
      },
      {
        "@language": "en",
        "@value": "Operator Contact Details"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Deze gegevens worden alleen openbaar gemaakt als de exploitant daarmee instemt; Gedelegeerde Verordening (EU) nr. 885/2013 legt die instemming als afzonderlijk gegeven vast."
      },
      {
        "@language": "en",
        "@value": "These details are only made public if the operator consents; Delegated Regulation (EU) No 885/2013 records that consent as a separate data item."
      }
    ]
  }
]