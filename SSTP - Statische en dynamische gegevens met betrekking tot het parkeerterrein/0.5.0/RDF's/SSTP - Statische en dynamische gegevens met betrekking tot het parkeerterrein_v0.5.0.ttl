<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/collections/dynamische-gegevens> a skos:OrderedCollection ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:memberList ( <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132808912> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132848912> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371> <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747> ) ;
    skos:prefLabel "Dynamische gegevens"@en,
        "Dynamische gegevens"@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773737661675> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> ;
    skos:definition "The exit of the truck parking area."@en,
        "De uitgang van het vrachtwagenparkeerterrein."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Exit"@en,
        "Uitgang"@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773739249931> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> ;
    skos:definition "The entrance to the truck parking area."@en,
        "De toegang tot het vrachtwagenparkeerterrein."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Entrence"@en,
        "Ingang"@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132808912> a skos:Concept ;
    skos:definition "The current data on the number of reserved parking spaces at a truck parking area and on the remaining possibility to book in advance."@en,
        "De actuele data over het aantal gereserveerde parkeerplaatsen op een vrachtwagenparkeerterrein en over de resterende mogelijkheid om vooraf te reserveren."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Reservation Status"@en,
        "_Reserveringsstatus"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsvoorziening> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> ;
    skos:definition "A physical or technological measure installed at a truck parking area to prevent theft, cargo tampering, or unauthorised access."@en,
        "Een fysieke of technologische maatregel die is geïnstalleerd op een vrachtwagenparkeerterrein om diefstal, lading manipulatie of ongeoorloofde toegang te voorkomen."@nl ;
    skos:example "CCTV covering all truck bays and entry/exit points, HD 720p minimum, 30-day recording retention; perimeter fencing 2.0 m galvanised steel mesh with anti-climb top rail."@en,
        "CCTV met dekking van alle vrachtwagenparkeerplaatsen en toegangspunten, minimaal HD 720p, bewaarintermijn opnames 30 dagen; hekwerk 2,0 m gegalvaniseerd staalvlechtwerk met anti-klimrail."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Security Feature"@en,
        "Beveiligingsvoorziening"@nl ;
    skos:scopeNote "Delegated Regulation 2022/1012 Annex I specifies minimum technical requirements per feature per tier (e.g. CCTV minimum HD 720p resolution at 5 fps for Silver and above)."@en,
        "Gedelegeerde Verordening 2022/1012 Bijlage I specificeert minimale technische vereisten per voorziening per niveau (bijv. CCTV minimaal HD 720p resolutie bij 5 fps voor Zilver en hoger)."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-identificatiegegevens> a skos:Concept ;
    skos:definition "The information by which a truck parking area can be unambiguously identified, comprising its name, its national identifier (if available) and its address, including the country and territorial unit in which it is located."@en,
        "De gegevens waarmee een vrachtwagenparkeerterrein eenduidig kan worden geïdentificeerd, bestaande uit de naam, de nationale identificatie (indien beschikbaar) en het adres, inclusief het land en de territoriale eenheid waarin het terrein ligt."@nl ;
    skos:example "Fictitious example — name: 'Truckparking Voorbeeldstad'; national identifier: NL-TP-0000; address: Fictieweg 1, 9999 ZZ Voorbeeldstad, the Netherlands."@en,
        "Fictief voorbeeld — naam: 'Truckparking Voorbeeldstad'; nationale identificatie: NL-TP-0000; adres: Fictieweg 1, 9999 ZZ Voorbeeldstad, Nederland."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Truck Parking Area Identification Information"@en,
        "Identificatiegegevens vrachtwagenparkeerterrein"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> ;
    skos:scopeNote "Maximum 200 characters per field. In the Netherlands, the address must be consistent with the BAG (Basisregistratie Adressen en Gebouwen) where a BAG address exists. If the area is located along a motorway without a street address, the address may be supplemented with the name or number of the road, the hectometre position and the direction of travel from which the area is accessible."@en,
        "Maximaal 200 tekens per veld. In Nederland dient het adres te zijn afgestemd op de BAG (Basisregistratie Adressen en Gebouwen) waar een BAG-adres beschikbaar is. Ligt het terrein langs een autosnelweg zonder straatadres, dan kan het adres worden aangevuld met de naam of het nummer van de weg, de hectometerpositie en de rijrichting waarlangs het terrein bereikbaar is."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toezicht> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> ;
    skos:definition "The type of monitoring and supervision arrangement in place at a truck parking area, indicating whether the site is staffed, remotely monitored, or unattended."@en,
        "Het type bewakings- en toezichtregeling op een vrachtwagenparkeerterrein, die aangeeft of het terrein is bemand, op afstand wordt bewaakt of onbemand is."@nl ;
    skos:example "staffOnSite: a security guard present at the site 24/7; remoteSurveillance: CCTV feeds monitored from a central control room in Amsterdam, with intervention capability via contracted response service."@en,
        "staffOnSite: een beveiliger die 24/7 op het terrein aanwezig is; remoteSurveillance: CCTV-beelden worden bewaakt vanuit een centrale meldkamer in Amsterdam, met interventiemogelijkheid via een gecontracteerde responsdienst."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Supervision"@en,
        "Toezicht"@nl ;
    skos:scopeNote "DATEX II ParkingSupervisionEnum includes: patrolled, remoteSurveillance, staffOnSite, controlCentre, none. Gold and Platinum certification under DR 2022/1012 require at minimum remoteSurveillance with 24/7 coverage. Supervision type directly affects the real-time responsiveness to incidents and is relevant to the dynamic data type."@en,
        "DATEX II ParkingSupervisionEnum omvat: patrolled, remoteSurveillance, staffOnSite, controlCentre, none. Goud- en Platina-certificering onder DR 2022/1012 vereisen minimaal remoteSurveillance met 24/7-dekking. Het type toezicht heeft direct invloed op de responstijd bij incidenten en is relevant voor het dynamische gegevenstype."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsvoorziening> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> ;
    skos:definition "A facility at a truck parking area that serves to protect the physical safety of drivers and occupants, as distinct from cargo security measures."@en,
        "Een voorziening op een vrachtwagenparkeerterrein die dient ter bescherming van de fysieke veiligheid van chauffeurs en inzittenden, onderscheiden van beveiligingsmaatregelen voor lading."@nl ;
    skos:example "Emergency telephone connected to a 24/7 manned control room; fire extinguisher posts every 50 metres along the parking rows; AED (defibrillator) at the reception building."@en,
        "Noodtelefoon verbonden met een 24/7 bemande meldkamer; brandblusserposten elke 50 meter langs de parkeerrijen; AED (defibrillator) bij het receptiegebouw."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Safety Provision"@en,
        "Veiligheidsvoorziening"@nl ;
    skos:scopeNote "These are distinct from security features (beveiligingsvoorzieningen) which concern crime prevention."@en,
        "Deze zijn te onderscheiden van beveiligingsvoorzieningen die betrekking hebben op misdaadpreventie."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834> a skos:Concept ;
    skos:definition "The response from a user about a truck parking area or about the information provided on it, such as a rating, a comment or a report of incorrect data."@en,
        "De terugkoppeling van een gebruiker over een vrachtwagenparkeerterrein of over de verstrekte informatie daarover, zoals een beoordeling, een opmerking of een melding van onjuiste gegevens."@nl ;
    skos:example "Fictitious example — a driver anonymously reports via an app that the published number of available spaces at Truckparking Voorbeeldstad does not match the actual occupancy."@en,
        "Fictief voorbeeld — een chauffeur meldt anoniem via een app dat het gepubliceerde aantal vrije plaatsen op Truckparking Voorbeeldstad niet overeenkomt met de werkelijke bezetting."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "User Feedback"@en,
        "Gebruikersfeedback"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> ;
    skos:scopeNote "User feedback may be given anonymously. The feedback can be used to improve the quality of the published static and dynamic data."@en,
        "Gebruikersfeedback mag anoniem worden gegeven. De feedback kan worden gebruikt om de kwaliteit van de gepubliceerde statische en dynamische gegevens te verbeteren."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226> a skos:Concept ;
    skos:definition "The current number of unoccupied truck parking spaces at a truck parking area."@en,
        "Het actuele aantal onbezette parkeerplaatsen voor vrachtwagens op een vrachtwagenparkeerterrein."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Number of Vacant Spaces"@en,
        "_Aantal vrije parkeerplaatsen"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132848912> a skos:Concept ;
    skos:definition "A notification of a circumstance resulting in a truck parking area being wholly or partly out of use, such as maintenance, an incident or an emergency, including its reason."@en,
        "Een melding van een omstandigheid die leidt tot het geheel of gedeeltelijk buiten gebruik zijn van een vrachtwagenparkeerterrein, zoals onderhoud, een incident of een noodsituatie, inclusief de reden daarvan."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Temporary Closure"@en,
        "_Tijdelijke buitengebruikstelling"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747> a skos:Concept ;
    skos:definition "The estimated time a vehicle has to wait at the entrance or access control of a truck parking area before it can enter."@en,
        "De geschatte tijd die een voertuig moet wachten bij de ingang of toegangscontrole van een vrachtwagenparkeerterrein voordat het kan binnenrijden."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Entry Waiting Time"@en,
        "_Wachttijd bij toegang"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773739249931> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-certificering> a skos:Concept ;
    skos:definition "The formal attestation by an accredited conformity assessment body that a truck parking area meets the requirements of a specified security tier under Delegated Regulation (EU) 2022/1012, including the certification name, issuing body, and date of issue."@en,
        "De formele bevestiging door een geaccrediteerde conformiteitsbeoordelingsinstantie dat een vrachtwagenparkeerterrein voldoet aan de vereisten van een bepaald beveiligingsniveau onder Gedelegeerde Verordening (EU) 2022/1012, inclusief de certificaatnaam, uitgevende instantie en datum van afgifte."@nl ;
    skos:example "Certificate: 'SSTPA Gold', issued by SecureNL, certification date: 2024-03-15, valid until: 2027-03-14."@en,
        "Certificaat: 'SSTPA Goud', afgegeven door SecureNL, certificeringsdatum: 15-03-2024, geldig tot: 14-03-2027."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Certification"@en,
        "Certificering"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> ;
    skos:scopeNote """Certification is voluntary under Delegated Regulation 2022/1012 but enables the parking area to be included in the EU's publicly accessible list of certified SSTPAs. Certification bodies must be accredited under EN ISO/IEC 17021-1. In the Netherlands, ESPORG and the SecureNL consortium are active in this domain. 

Gold and Platinum certified parking areas are required to have a functioning DATEX II data connection to the national access point."""@en,
        """Certificering is vrijwillig onder Gedelegeerde Verordening 2022/1012 maar maakt het mogelijk dat het parkeerterrein wordt opgenomen in de EU-lijst van gecertificeerde SSTPA's. Certificeringsinstanties moeten zijn geaccrediteerd onder EN ISO/IEC 17021-1. In Nederland zijn ESPORG en het SecureNL-consortium actief op dit gebied. 

Goud- en Platina-gecertificeerde parkeerterreinen zijn verplicht een werkende DATEX II-dataverbinding met het nationaal toegangspunt te hebben."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit> a skos:Concept ;
    skos:definition "Equipment, amenities, or services available to drivers and vehicles at a truck parking area, beyond the basic parking provision, as required by Delegated Regulation (EU) No 885/2013."@en,
        "Uitrusting, voorzieningen of diensten die beschikbaar zijn voor chauffeurs en voertuigen op een vrachtwagenparkeerterrein, buiten de basisparkeervoorziening, zoals vereist door Gedelegeerde Verordening (EU) nr. 885/2013."@nl ;
    skos:example "Showers (8 cabins), toilets (24/7 accessible), restaurant (06:00–22:00), AdBlue dispenser, high-pressure truck wash, weighbridge, 8 refrigerated vehicle electrical connections (CEE 63A)."@en,
        "Douches (8 cabines), toiletten (24/7 toegankelijk), restaurant (06:00–22:00), AdBlue-dispenser, hogedruk vrachtwagenwasstraat, weegbrug, 8 elektrische aansluitingen voor koelvoertuigen (CEE 63A)."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Service Facility"@en,
        "Faciliteit"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats> ;
    skos:scopeNote "This covers approximately 60 equipment types including showers, toilets, restaurant, fuel station, AdBlue dispensers, electric vehicle charging points, weighbridge, and tyre inflation. For verzorgingsplaatsen on the national highway network, minimum facility requirements are set by the CROW KIVZP criteria as applied by Rijkswaterstaat. Facilities influence the commercial attractiveness of a truck parking area but are secondary to the mandatory static data fields."@en,
        "Dit omvat circa 60 apparatuurtypen waaronder douches, toiletten, restaurant, tankstation, AdBlue-dispensers, laadpunten voor elektrische voertuigen, weegbrug en bandenspanning. Voor verzorgingsplaatsen op het rijkswegennet stelt Rijkswaterstaat minimale voorzieningenvereisten op basis van de CROW KIVZP-criteria. Faciliteiten beïnvloeden de commerciële aantrekkelijkheid van een vrachtwagenparkeerterrein maar zijn secundair aan de verplichte statische gegevensvelden."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres> a skos:Concept ;
    skos:definition "The information enabling users of a truck parking area to contact the parking operator or an associated company, comprising the telephone number and e-mail address of the contact point and, optionally, the name of the contact person."@en,
        "De gegevens waarmee gebruikers van een vrachtwagenparkeerterrein contact kunnen opnemen met de exploitant of een daaraan verbonden onderneming, bestaande uit het telefoonnummer en het e-mailadres van het contactpunt en optioneel de naam van de contactpersoon."@nl ;
    skos:example "Fictitious example — contact point: reception Truckparking Voorbeeldstad; telephone: +31 00 000 0000; e-mail: contact@voorbeeldparking.example."@en,
        "Fictief voorbeeld — contactpunt: receptie Truckparking Voorbeeldstad; telefoon: +31 00 000 0000; e-mail: contact@voorbeeldparking.example."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Operator Contact Details"@en,
        "Contactgegevens exploitant"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant> ;
    skos:scopeNote "These details are only made public if the operator consents; Delegated Regulation (EU) No 885/2013 records that consent as a separate data item."@en,
        "Deze gegevens worden alleen openbaar gemaakt als de exploitant daarmee instemt; Gedelegeerde Verordening (EU) nr. 885/2013 legt die instemming als afzonderlijk gegeven vast."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype> a skos:Concept ;
    skos:definition "Data type within the SSTP context that describes the collection of concepts required to unambiguously record and exchange static information about safe and secure truck parking areas on the trans-European road network."@en,
        "Gegevenstype binnen de SSTP-context dat de verzameling van concepten beschrijft die nodig zijn om statische informatie over veilige en beveiligde vrachtwagenparkeerterreinen op het trans-Europees wegennet eenduidig vast te leggen en uit te wisselen."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "SSTP Data Type – Static Parking Data"@en,
        "Gegevenstype SSTP – Statische parkeergegevens"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit> ;
    skos:scopeNote "This data type is defined as part of the Dutch implementation of the ITS Directive (2010/40/EU) and Delegated Regulation (EU) No 885/2013 on information services for safe and secure parking places for trucks and commercial vehicles. Static data must be made available via the national access point (NTM/NDW) and updated at least annually."@en,
        "Dit gegevenstype is gedefinieerd als onderdeel van de Nederlandse implementatie van de ITS-richtlijn (2010/40/EU) en Gedelegeerde Verordening (EU) nr. 885/2013 inzake informatiediensten voor veilige en beveiligde parkeerplaatsen voor vrachtwagens en bedrijfsvoertuigen. Statische gegevens moeten beschikbaar zijn via het nationaal toegangspunt (NTM/NDW) en minimaal jaarlijks worden bijgewerkt."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief> a skos:Concept ;
    skos:definition "The parking fee and currency applicable at a truck parking area, or an indication that parking is free of charge, as required by Delegated Regulation (EU) No 885/2013."@en,
        "De parkeervergoeding en valuta die van toepassing zijn op een vrachtwagenparkeerterrein, of een aanduiding dat parkeren kosteloos is, zoals vereist door Gedelegeerde Verordening (EU) nr. 885/2013."@nl ;
    skos:example "€ 30,00 per 24-hour period (EUR); or: free of charge (for short stops at verzorgingsplaatsen without a parking management system)."@en,
        "€ 30,00 per etmaal (EUR); of: gratis (voor korte stops op verzorgingsplaatsen zonder parkeermanagementsysteem)."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Tariff"@en,
        "Tarief"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster> ;
    skos:scopeNote "Tariff information is governed by private law between the parking operator and the user (exploitatieovereenkomst). There is no Dutch public law obligation for truck parking tariff levels. The tariff published through NTM/NDW must be updated whenever the commercial tariff changes; the general minimum update frequency of annually applies."@en,
        "Tariefinformatie is geregeld door het privaatrecht tussen de parkeerexploitant en de gebruiker (exploitatieovereenkomst). Er bestaat geen Nederlandse publiekrechtelijke verplichting voor tarifering van vrachtwagenparkeren. Het via NTM/NDW gepubliceerde tarief dient te worden bijgewerkt wanneer het commerciële tarief wijzigt; de algemene minimale updatefrequentie van jaarlijks is van toepassing."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats> a skos:Concept ;
    skos:broader <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> ;
    skos:definition "A rest area alongside a national highway (Rijkswaterstaat) providing at minimum a parking zone and sanitary facilities, and often incorporating designated truck parking bays. Managed by Rijkswaterstaat under the CROW KIVZP criteria."@en,
        "Een rustplaats langs een rijksweg (Rijkswaterstaat) die minimaal een parkeerzone en sanitaire voorzieningen biedt, en vaak aangewezen vrachtwagenparkeerplaatsen bevat. Beheerd door Rijkswaterstaat op basis van de CROW KIVZP-criteria."@nl ;
    skos:example "Verzorgingsplaats De Lucht (A2, Noord-Brabant) — includes a separate fenced truck parking zone with sanitary facilities and a restaurant."@en,
        "Verzorgingsplaats De Lucht (A2, Noord-Brabant) — inclusief afzonderlijke omheinde vrachtwagenzone met sanitair en restaurant."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Motorway Service Area"@en,
        "Verzorgingsplaats"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit> ;
    skos:scopeNote "Verzorgingsplaatsen are formally registered by Rijkswaterstaat and appear in the NDW truck parking register. They carry the E8a sign for the truck section and are bound by Rijkswaterstaat's concession or management agreements for service facilities. Not all verzorgingsplaatsen meet the security classification thresholds of Delegated Regulation (EU) 2022/1012."@en,
        "Verzorgingsplaatsen zijn formeel geregistreerd door Rijkswaterstaat en zijn opgenomen in het NDW-truckparkingregister. De vrachtwagenzone draagt bord E8a en valt onder concessie- of beheersovereenkomsten van Rijkswaterstaat voor servicevoorzieningen. Niet alle verzorgingsplaatsen voldoen aan de beveiligingsclassificatiedrempels van Gedelegeerde Verordening (EU) 2022/1012."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie> a skos:Concept ;
    skos:definition "The category of vehicles for which a parking area or specific parking spaces are designated, based on the physical and operational characteristics of the vehicle, as defined in the RVV 1990 and EU vehicle classification standards."@en,
        "De categorie voertuigen waarvoor een parkeerterrein of specifieke parkeerplaatsen zijn bestemd, op basis van de fysieke en operationele kenmerken van het voertuig, zoals gedefinieerd in RVV en EU-voertuigclassificatienormen."@nl ;
    skos:example "A parking area signed E8a may only be used by trucks (motor vehicles with a maximum authorised mass exceeding 3,500 kg) and buses. Passenger cars and vans up to 3,500 kg are excluded."@en,
        "Een parkeerterrein aangeduid met bord E8a mag uitsluitend worden gebruikt door vrachtwagens (motorrijtuigen met een toegestane maximummassa van meer dan 3.500 kg) en bussen. Personenauto's en bestelauto's tot 3.500 kg zijn uitgesloten."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Vehicle Category"@en,
        "Voertuigcategorie"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit> ;
    skos:scopeNote """In the context of DR 885/2013, the relevant vehicle categories are trucks (vrachtauto's), articulated lorries (opleggers), and buses (bussen). Access restrictions based on vehicle category are governed by RVV, which prohibits parking at an E4–E13 designated location for vehicles not belonging to the indicated category. 

Sign E8a specifically covers lorries and buses."""@en,
        """In de context van DR 885/2013 zijn de relevante voertuigcategorieën vrachtauto's, opleggers en bussen. Toegangsbeperkingen op basis van voertuigcategorie worden geregeld door RVV, dat parkeren verbiedt op een E4–E13-aangewezen locatie voor voertuigen die niet tot de aangewezen categorie behoren. 

Bord E8a betreft specifiek vrachtwagens en bussen."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder> a skos:Concept ;
    skos:definition "The public body legally responsible for a road and any associated infrastructure, including truck parking areas on or adjacent to that road. The wegbeheerder is also the competent authority for issuing a verkeersbesluit."@en,
        "Het publiekrechtelijk orgaan dat juridisch verantwoordelijk is voor een weg en de daarmee verbonden infrastructuur, inclusief vrachtwagenparkeerterreinen op of naast die weg. De wegbeheerder is tevens het bevoegd gezag voor het nemen van een verkeersbesluit."@nl ;
    skos:example "Rijkswaterstaat (for A2 Truck Parking along the A2); Gemeente Amsterdam (for a municipally designated truck parking area within city limits)."@en,
        "Rijkswaterstaat (voor A2 Truck Parking langs de A2); Gemeente Amsterdam (voor een gemeentelijk aangewezen vrachtwagenparkeerterrein binnen de gemeentegrenzen)."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Road Authority"@en,
        "Wegbeheerder"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit> ;
    skos:scopeNote "Authority is determined by WVW 1994 Article 18: Rijkswaterstaat for national highways (A-wegen and certain N-wegen), the provincial executive (Gedeputeerde Staten) for provincial roads, and the municipal executive (B&W) for municipal roads. On verzorgingsplaatsen, Rijkswaterstaat is both wegbeheerder and often concession grantor for the service operator."@en,
        "De bevoegdheid is geregeld in WVW 1994 artikel 18: Rijkswaterstaat voor rijkswegen (A-wegen en bepaalde N-wegen), het college van Gedeputeerde Staten voor provinciale wegen, en het college van B&W voor gemeentelijke wegen. Op verzorgingsplaatsen is Rijkswaterstaat zowel wegbeheerder als doorgaans concessieverlener voor de serviceexploitant."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023> a skos:Concept ;
    skos:definition "A person or body that makes use of the truck parking area or of the information about it."@en,
        "Een persoon of instantie die gebruikmaakt van het vrachtwagenparkeerterrein of van de informatie daarover."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "User"@en,
        "Gebruiker"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> ;
    skos:scopeNote "Any truck or commercial vehicle driver, dispatcher, haulier, traffic management body, or any other body such as cargo owners, insurance companies, road authorities and police forces. They should obtain the information from the service providers."@en,
        "Iedere chauffeur van een vrachtwagen of bedrijfsvoertuig, planner, transporteur, verkeersregelaar of andere instantie zoals ladingeigenaren, verzekeringsmaatschappijen, wegbeheerders en politie. Zij dienen de informatie te verkrijgen van de dienstverleners."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821> a skos:Concept ;
    skos:altLabel "Availability"@nl,
        "Beschikbaarheid"@nl ;
    skos:definition "The current operational condition of a truck parking area, indicating whether parking spaces are available, whether the area is almost full or full, or whether it is closed."@en,
        "De actuele operationele toestand van een vrachtwagenparkeerterrein, die aangeeft of er parkeerplaatsen beschikbaar zijn, of het terrein bijna vol of vol is, of dat het gesloten is."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:narrowMatch <https://docs.datex2.eu/_static/data/v3.2/umlmodel/html/index.htm?goto=3:4:2:994> ;
    skos:prefLabel "Status"@en,
        "Status"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132848912>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371> a skos:Concept ;
    skos:definition "The current percentage of the total truck parking capacity at a truck parking area that is occupied."@en,
        "Het actuele percentage van de totale parkeercapaciteit voor vrachtwagens op een vrachtwagenparkeerterrein dat bezet is."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Occupancy Rate"@en,
        "_Bezettingsgraad"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit> .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit> a skos:Concept ;
    skos:definition "The exit or exits that a truck driver must take to reach the truck parking area from the primary road or to leave the area."@en,
        "De afrit of afritten die een vrachtwagenchauffeur moet nemen om het vrachtwagenparkeerterrein vanaf de primaire weg te bereiken of om het terrein te verlaten."@nl ;
    skos:example "Fictitious example — exit 99 'Voorbeeldstad' on the A99."@en,
        "Fictief voorbeeld — afrit 99 'Voorbeeldstad' van de A99."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Motorway Exit"@en,
        "Afrit"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> ;
    skos:scopeNote "The exit is indicated by the number, location code and/or name of the junction or interchange. In the Netherlands, motorway exit numbers are assigned by Rijkswaterstaat and published in the NWB."@en,
        "De afrit wordt aangeduid met het nummer, de locatiecode en/of de naam van het knooppunt of de aansluiting. In Nederland worden afritnummers van autosnelwegen toegekend door Rijkswaterstaat en gepubliceerd in het NWB."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg> a skos:Concept ;
    skos:definition "The distance between the exit to be taken and the entry point of the truck parking area."@en,
        "De afstand tussen de te nemen afrit en het toegangspunt van het vrachtwagenparkeerterrein."@nl ;
    skos:example "Fictitious example — travel distance from exit 99 to the entry point: 850 m."@en,
        "Fictief voorbeeld — rijafstand van afrit 99 tot het toegangspunt: 850 m."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Distance from Primary Road"@en,
        "Afstand tot primaire weg"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> ;
    skos:scopeNote "Preferably expressed as the travel distance by road in metres, not as the straight-line distance. For truck parking areas not located along a motorway, the road of the highest order in the vicinity is regarded as the primary road; this data item may then be optional."@en,
        "Bij voorkeur uitgedrukt als rijafstand over de weg in meters, niet als hemelsbrede afstand. Voor vrachtwagenparkeerterreinen die niet langs een autosnelweg liggen, geldt de weg van de hoogste orde in de nabijheid als primaire weg; dit gegeven kan dan optioneel zijn."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau> a skos:Concept ;
    skos:definition "The tier of security certification achieved by a truck parking area under the European classification framework established by Delegated Regulation (EU) 2022/1012, or an equivalent national classification system. The four European tiers are Bronze, Silver, Gold, and Platinum."@en,
        "Het niveau van beveiligingscertificering dat een vrachtwagenparkeerterrein heeft behaald onder het Europese classificatiekader van Gedelegeerde Verordening (EU) 2022/1012, of een gelijkwaardig nationaal classificatiesysteem. De vier Europese niveaus zijn Brons, Zilver, Goud en Platina."@nl ;
    skos:example "Gold level: 24/7 remote CCTV surveillance, automated entry/exit barriers, DATEX II data feed to NDW, minimum 15 Lux lighting at ground level, perimeter fencing ≥ 1.8 m."@en,
        "Goud-niveau: 24/7 CCTV-bewaking op afstand, automatische inrij-/uitrijbarrières, DATEX II-datafeed naar NDW, minimale verlichting 15 lux op maaiveld, hekwerk ≥ 1,8 m."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Security Level"@en,
        "Beveiligingsniveau"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-certificering>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> ;
    skos:scopeNote "Bronze requires basic perimeter fencing and lighting. Silver adds CCTV coverage. Gold additionally requires 24/7 staffed or remote surveillance and a parking management system with DATEX II output capability. Platinum requires all Gold features plus active threat monitoring and an integrated security operations centre. Certification is performed by accredited conformity assessment bodies under EN ISO/IEC 17021-1. In the Netherlands, the SecureNL consortium is a relevant certification body."@en,
        "Brons vereist basishekwerk en verlichting. Zilver voegt CCTV-dekking toe. Goud vereist daarnaast 24/7 bemand of op afstand toezicht en een parkeermanagementsysteem met DATEX II-uitvoermogelijkheid. Platina vereist alle Goud-kenmerken plus actieve dreigingsbewaking en een geïntegreerd beveiligingsoperatiecentrum. Certificering wordt uitgevoerd door geaccrediteerde conformiteitsbeoordelingsinstanties onder EN ISO/IEC 17021-1. In Nederland is het SecureNL-consortium een relevante certificerende instantie."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats> a skos:Concept ;
    skos:definition "A parking space specifically designated and equipped for refrigerated goods vehicles (koelwagens), including provision for powered reefer units (stroomaansluitingen), reported separately from total truck capacity as required by Delegated Regulation (EU) No 885/2013."@en,
        "Een parkeerplaats die specifiek is aangewezen en ingericht voor koelvoertuigen (koelwagens), inclusief voorzieningen voor aangesloten koelunits (stroomaansluitingen), afzonderlijk gerapporteerd naast de totale vrachtwagenplaatsen zoals vereist in Gedelegeerde Verordening (EU) nr. 885/2013."@nl ;
    skos:example "A parking area with 120 total truck spaces of which 8 are designated for refrigerated goods vehicles, each equipped with a CEE 63A connection for the reefer unit."@en,
        "Een parkeerterrein met 120 vrachtwagenplaatsen totaal, waarvan 8 bestemd voor koelvoertuigen, elk voorzien van een CEE 63A-aansluiting voor de koelaggregaat."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Refrigerated Goods Vehicle Space"@en,
        "Koelvoertuigplaats"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit> ;
    skos:scopeNote """The number of spaces available for refrigerated goods vehicles in accordance with Delegated Regulation (EU) No 885/2013.

Operators usually report this number based on installed electrical connection points (CEE 32A or CEE 63A sockets)."""@en,
        """Het aantal beschikbare plaatsen ten behove van koelvoertuigen conform Gedelegeerde Verordening (EU) nr. 885/2013. 

Exploitanten rapporteren dit aantal doorgaans op basis van geïnstalleerde elektrische aansluitpunten (CEE 32A of CEE 63A stopcontacten)."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg> a skos:Concept ;
    skos:definition "The identifier and travel direction of the road or roads (maximum two) from which the truck parking area is directly accessible."@en,
        "De identificatie en rijrichting van de weg of wegen (maximaal twee) waarvan het vrachtwagenparkeerterrein direct toegankelijk is."@nl ;
    skos:example "Road: A2, direction: Den Haag; secondary road: N2, direction: Eindhoven-Centrum."@en,
        "Weg: A2, richting: Den Haag; nevenweg: N2, richting: Eindhoven-Centrum."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Primary Road"@en,
        "Primaire weg"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> ;
    skos:scopeNote "Road identifiers follow the Dutch national numbering convention: A-wegen (autosnelwegen), N-wegen (nationale wegen), and S-wegen (stadsroutes). Road identifiers are maintained in the NWB (Nationaal Wegenbestand). The direction field indicates the main destination served, enabling drivers to identify the relevant parking area from route guidance."@en,
        "Wegidentificatoren volgen de Nederlandse nationale nummeringsconventie: A-wegen (autosnelwegen), N-wegen (nationale wegen) en S-wegen (stadsroutes). Wegidentificatoren worden bijgehouden in het NWB (Nationaal Wegenbestand). Het richtingsveld geeft de hoofdbestemming aan die wordt bediend, zodat bestuurders het relevante parkeerterrein kunnen identificeren vanuit routegeleiding."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster> a skos:Concept ;
    skos:definition "The periods during which a truck parking area is open and accessible to vehicles, including any restrictions by day of week or time of day. Relevant both to access conditions and to the validity of tariff information."@en,
        "De perioden gedurende welke een vrachtwagenparkeerterrein open en toegankelijk is voor voertuigen, inclusief eventuele beperkingen per dag van de week of tijdstip. Relevant zowel voor toegangsvoorwaarden als voor de geldigheid van tariefinformatie."@nl ;
    skos:example "Open 24/7 all year; or: Monday–Friday 06:00–22:00, Saturday 08:00–18:00, closed on Sundays and public holidays."@en,
        "Open 24/7 het hele jaar; of: maandag–vrijdag 06:00–22:00, zaterdag 08:00–18:00, gesloten op zondag en feestdagen."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Operating Hours"@en,
        "Tijdvenster"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief> ;
    skos:scopeNote "24/7 availability is a prerequisite for Gold and Platinum certification under DR (EU) 2022/1012 Annex I. Operating hours may affect the reliability of real-time availability data: a closed parking area should be reflected in the dynamic data type as 'closed'. In DATEX II this maps to OpeningTimes within the ParkingRecord structure."@en,
        "24/7-beschikbaarheid is een vereiste voor Goud- en Platina-certificering onder DR (EU) 2022/1012 Bijlage I. Openingstijden kunnen de betrouwbaarheid van real-time beschikbaarheidsgegevens beïnvloeden: een gesloten parkeerterrein dient in het dynamische gegevenstype als 'gesloten' te worden weergegeven. In DATEX II correspondeert dit met OpeningTimes binnen de ParkingRecord-structuur."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant> a skos:Concept ;
    skos:definition "The legal entity responsible for the day-to-day management and operation of a truck parking area, including the provision of contact information for publication, as required by Delegated Regulation (EU) No 885/2013."@en,
        "De rechtspersoon die verantwoordelijk is voor het dagelijks beheer en de exploitatie van een vrachtwagenparkeerterrein, inclusief het verstrekken van contactgegevens voor publicatie, zoals vereist door de Gedelegeerde Verordening (EU) nr. 885/2013."@nl ;
    skos:example "Fictitious example — operator: Voorbeeldparking B.V., Chamber of Commerce (KvK) number 00000000; consent to publish contact details: yes."@en,
        "Fictief voorbeeld — exploitant: Voorbeeldparking B.V., KvK 00000000; publicatietoestemming contactgegevens: ja."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Operator"@en,
        "Exploitant"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder> ;
    skos:scopeNote "The operator's identity can be verified against the Dutch Chamber of Commerce (Kamer van Koophandel) registration. The information records whether the operator has consented to their contact details being made publicly available via the national access point. The operator may differ from the wegbeheerder (road authority), particularly at privately operated truck parking facilities."@en,
        "De identiteit van de exploitant kan worden geverifieerd via de Nederlandse KvK-registratie (Kamer van Koophandel). Het registreert of de exploitant heeft ingestemd met het openbaar beschikbaar stellen van zijn contactgegevens via het nationaal toegangspunt. De exploitant kan afwijken van de wegbeheerder, met name bij particulier geëxploiteerde vrachtwagenparkeerterreinen."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit> a skos:Concept ;
    skos:definition "A formal administrative decision by the competent road authority (wegbeheerder) designating a location as a truck parking area, establishing the legal basis for placing a E8a sign and enforcing access restrictions."@en,
        "Een formeel administratief besluit van het bevoegde gezag (wegbeheerder) waarbij een locatie wordt aangewezen als vrachtwagenparkeerterrein, dat de juridische grondslag vormt voor de plaatsing van het E8a bord en de handhaving van toegangsbeperkingen."@nl ;
    skos:example "Traffic order (verkeersbesluit) by Rijkswaterstaat, reference RWS-2021/12345, published in the Staatscourant on 14 April 2021: designation of service area X as a truck parking area with sign E8a."@en,
        "Verkeersbesluit Rijkswaterstaat, kenmerk RWS-2021/12345, gepubliceerd Staatscourant 14 april 2021: aanwijzing verzorgingsplaats X als vrachtwagenparkeerterrein met bord E8a."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Traffic Order"@en,
        "Verkeersbesluit"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder> ;
    skos:scopeNote """A verkeersbesluit for truck parking is taken. The procedure requires mandatory consultation with the police and publication in the Staatscourant, followed by a six-week objection and appeal period.

Verkeersbesluiten are publicly accessible via officielebekendmakingen.nl and the LVBB. 

Not all truck parking areas have a dedicated verkeersbesluit — areas regulated under APV use an aanwijzingsbesluit instead."""@en,
        """Een verkeersbesluit voor vrachtwagenparkeren wordt genomen. De procedure vereist verplichte advisering door de politie en bekendmaking in de Staatscourant, gevolgd door een bezwaar- en beroepstermijn van zes weken. 

Verkeersbesluiten zijn openbaar toegankelijk via officielebekendmakingen.nl en het LVBB. 

Niet alle vrachtwagenparkeerterreinen hebben een specifiek verkeersbesluit — terreinen die worden gereguleerd via APV gebruiken in plaats daarvan een aanwijzingsbesluit."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie> a skos:Concept ;
    skos:definition "A structured description of the security measures, safety provisions, and supervision arrangements present at a truck parking area, as required by Article 4(2)(a) of DR (EU) No 885/2013, including any applicable national or European certification classification. Maps to DATEX II SafetyStandardClassification."@en,
        "Een gestructureerde beschrijving van de beveiligingsmaatregelen, veiligheidsvoorzieningen en toezichtregelingen die aanwezig zijn op een vrachtwagenparkeerterrein, zoals vereist door artikel 4 lid 2 sub a van Gedelegeerde Verordening (EU) nr. 885/2013, inclusief eventuele nationale of Europese certificeringsclassificatie. Komt overeen met DATEX II SafetyStandardClassification."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:narrower <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsvoorziening>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toezicht>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsvoorziening> ;
    skos:prefLabel "Safety and Security Classification"@en,
        "Veiligheids- en beveiligingsclassificatie"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-certificering>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> ;
    skos:scopeNote "The classification encompasses three sub-dimensions: security features (beveiligingsvoorzieningen), safety provisions (veiligheidsvoorzieningen), and supervision type (toezicht). DR (EU) 2022/1012 Annex I defines the European four-tier certification framework (Bronze, Silver, Gold, Platinum) that specifies minimum requirements per tier. Where a national classification system exists, it must be reported in the securityNationalClassification field."@en,
        "De classificatie omvat drie subdimensies: beveiligingsvoorzieningen, veiligheidsvoorzieningen en toezicht. DR (EU) 2022/1012 Bijlage I definieert het Europese vierniveaucertificeringskader (Brons, Zilver, Goud, Platina) met minimumvereisten per niveau. Waar een nationaal classificatiesysteem bestaat, dient dit te worden gerapporteerd in het veld securityNationalClassification."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt> a skos:Concept ;
    skos:definition "The location of the point at which vehicles enter the truck parking area."@en,
        "De locatie van het punt waar voertuigen het vrachtwagenparkeerterrein binnenrijden."@nl ;
    skos:example "Fictitious example — coordinates: latitude 52.00000, longitude 5.00000 (ETRS89); or as a location reference: a point on an NWB road section of the N999."@en,
        "Fictief voorbeeld — coördinaten: breedtegraad 52.00000, lengtegraad 5.00000 (ETRS89); of als locatiereferentie: punt op een NWB-wegvak van de N999."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Entry Point"@en,
        "Toegangspunt"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg> ;
    skos:scopeNote "The position may be expressed as geographic coordinates (ETRS89 recommended) or as a location reference along the road network (point or linear reference, e.g. via the NWB). A truck parking area may have more than one entry point."@en,
        "De positie kan worden uitgedrukt als geografische coördinaten (ETRS89 aanbevolen) of als locatiereferentie langs het wegennet (punt- of lineaire referentie, bijvoorbeeld via het NWB). Een vrachtwagenparkeerterrein kan meer dan één toegangspunt hebben."@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit> a skos:Concept ;
    skos:definition "The total number of parking spaces designated for trucks and commercial vehicles at a parking area, as required by Delegated Regulation (EU) No 885/2013."@en,
        "Het totale aantal parkeerplaatsen dat op een parkeerterrein is bestemd voor vrachtwagens en bedrijfsvoertuigen, zoals vereist in Gedelegeerde Verordening (EU) nr. 885/2013."@nl ;
    skos:example "Total truck spaces: 120 (of which 8 refrigerated). The static capacity remains 120 regardless of current occupancy."@en,
        "Totaal vrachtwagenplaatsen: 120 (waarvan 8 koelplaatsen). De statische capaciteit blijft 120 ongeacht de actuele bezetting."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:prefLabel "Parking Capacity"@en,
        "Parkeercapaciteit"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie> ;
    skos:scopeNote """The capacity figure refers exclusively to spaces dimensioned for articulated lorries (opleggers/semi-trailers) unless otherwise specified. 

Spaces for refrigerated goods vehicles are reported separately. 

The capacity can concern static and dynamic figures."""@en,
        """Het capaciteitscijfer betreft uitsluitend plaatsen gedimensioneerd voor vrachtwagencombinaties (opleggers/semi-trailers) tenzij anders aangegeven. 

Plaatsen voor koelvoertuigen worden afzonderlijk gerapporteerd. 

De capaciteit kan een statisch of een dynamisch gegeven zijn."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein> a skos:Concept ;
    skos:definition "An identifiable and designated, off-street area specifically intended for the overnight or rest-period parking of trucks and commercial vehicles, providing safe and secure conditions."@en,
        "Een identificeerbaar en aangewezen, niet op de rijbaan gelegen terrein dat specifiek bestemd is voor het nacht- of rustperiodeparkeren van vrachtwagens en bedrijfsvoertuigen, waarbij veilige en beveiligde omstandigheden worden geboden."@nl ;
    skos:example "A2 Truck Parking at Eindhoven (N2 corridor); a verzorgingsplaats along the A16 near Breda equipped with dedicated truck bays and security fencing."@en,
        "A2 Truck Parking bij Eindhoven (N2-corridor); een verzorgingsplaats langs de A16 bij Breda voorzien van afgebakende vrachtwagenparkeerplaatsen en hekwerk."@nl ;
    skos:inScheme <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> ;
    skos:narrower <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats> ;
    skos:prefLabel "Truck Parking Area"@en,
        "Vrachtwagenparkeerterrein"@nl ;
    skos:related <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-identificatiegegevens>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie>,
        <https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit> ;
    skos:scopeNote """In the Netherlands, a truck parking area is formally designated by a traffic order (verkeersbesluit), resulting in the placement of RVV 1990 sign E8a ('Parking for trucks and buses').

On the national road network (Rijkswaterstaat), truck parking is often integrated into motorway service areas (verzorgingsplaatsen). In addition, municipalities may designate truck parking areas."""@en,
        """In Nederland wordt een vrachtwagenparkeerterrein formeel aangewezen via een verkeersbesluit, resulterend in de plaatsing van RVV 1990-bord E8a ('Parkeergelegenheid voor vrachtwagens en bussen').

Op het rijkswegennet (Rijkswaterstaat) is vrachtwagenparkeren vaak geïntegreerd in verzorgingsplaatsen. Daarnaast kunnen gemeenten vrachtwagenparkeerterreinen aanwijzen."""@nl .

<https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb> a skos:ConceptScheme ;
    dct:created "2026-03-05T10:17:06.728009+00:00"^^xsd:dateTime ;
    dct:description "The Dutch perspective on the concepts representing static data related to parking areas. This data type is defined in the Safe and Secure Truck Parking regulation, which forms part of the ITS legislation."@en,
        "De Nederlandse zienswijze van de concepten die Statische gegevens met betrekking tot het parkeerterrein weergeeft. Dit gegevenstype is vastgelegd in de Safe and Secure TruckParking regulation die onderdeel uitmaakt van de ITS wetgeving."@nl ;
    dct:modified "2026-10-15T10:07:57.580659+00:00"^^xsd:dateTime ;
    dct:title "SSTP - Static and dynamic data relating to the parking area"@en,
        "SSTP - Statische en dynamische gegevens met betrekking tot het parkeerterrein"@nl ;
    dct:type <http://purl.org/adms/assettype/Thesaurus> ;
    owl:versionInfo "0.5.0" ;
    adms:status <http://purl.org/adms/status/UnderDevelopment> .

