    <skos:memberList rdf:nodeID="Ne1a76dd4473a4bdab824a4ff57afc5f1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">_Aantal vrije parkeerplaatsen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Number of Vacant Spaces</skos:prefLabel>
    <skos:definition xml:lang="nl">Het actuele aantal onbezette parkeerplaatsen voor vrachtwagens op een vrachtwagenparkeerterrein.</skos:definition>
    <skos:definition xml:lang="en">The current number of unoccupied truck parking spaces at a truck parking area.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Vrachtwagenparkeerterrein</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Truck Parking Area</skos:prefLabel>
    <skos:definition xml:lang="nl">Een identificeerbaar en aangewezen, niet op de rijbaan gelegen terrein dat specifiek bestemd is voor het nacht- of rustperiodeparkeren van vrachtwagens en bedrijfsvoertuigen, waarbij veilige en beveiligde omstandigheden worden geboden.</skos:definition>
    <skos:definition xml:lang="en">An identifiable and designated, off-street area specifically intended for the overnight or rest-period parking of trucks and commercial vehicles, providing safe and secure conditions.</skos:definition>
    <skos:example xml:lang="nl">A2 Truck Parking bij Eindhoven (N2-corridor); een verzorgingsplaats langs de A16 bij Breda voorzien van afgebakende vrachtwagenparkeerplaatsen en hekwerk.</skos:example>
    <skos:example xml:lang="en">A2 Truck Parking at Eindhoven (N2 corridor); a verzorgingsplaats along the A16 near Breda equipped with dedicated truck bays and security fencing.</skos:example>
    <skos:scopeNote xml:lang="nl">In Nederland wordt een vrachtwagenparkeerterrein formeel aangewezen via een verkeersbesluit, resulterend in de plaatsing van RVV 1990-bord E8a ('Parkeergelegenheid voor vrachtwagens en bussen').

Op het rijkswegennet (Rijkswaterstaat) is vrachtwagenparkeren vaak geïntegreerd in verzorgingsplaatsen. Daarnaast kunnen gemeenten vrachtwagenparkeerterreinen aanwijzen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In the Netherlands, a truck parking area is formally designated by a traffic order (verkeersbesluit), resulting in the placement of RVV 1990 sign E8a ('Parking for trucks and buses').

On the national road network (Rijkswaterstaat), truck parking is often integrated into motorway service areas (verzorgingsplaatsen). In addition, municipalities may designate truck parking areas.</skos:scopeNote>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-identificatiegegevens"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">_Wachttijd bij toegang</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Entry Waiting Time</skos:prefLabel>
    <skos:definition xml:lang="nl">De geschatte tijd die een voertuig moet wachten bij de ingang of toegangscontrole van een vrachtwagenparkeerterrein voordat het kan binnenrijden.</skos:definition>
    <skos:definition xml:lang="en">The estimated time a vehicle has to wait at the entrance or access control of a truck parking area before it can enter.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773739249931"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Gebruikersfeedback</skos:prefLabel>
    <skos:prefLabel xml:lang="en">User Feedback</skos:prefLabel>
    <skos:definition xml:lang="nl">De terugkoppeling van een gebruiker over een vrachtwagenparkeerterrein of over de verstrekte informatie daarover, zoals een beoordeling, een opmerking of een melding van onjuiste gegevens.</skos:definition>
    <skos:definition xml:lang="en">The response from a user about a truck parking area or about the information provided on it, such as a rating, a comment or a report of incorrect data.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gebruikersfeedback mag anoniem worden gegeven. De feedback kan worden gebruikt om de kwaliteit van de gepubliceerde statische en dynamische gegevens te verbeteren.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">User feedback may be given anonymously. The feedback can be used to improve the quality of the published static and dynamic data.</skos:scopeNote>
    <skos:example xml:lang="nl">Fictief voorbeeld — een chauffeur meldt anoniem via een app dat het gepubliceerde aantal vrije plaatsen op Truckparking Voorbeeldstad niet overeenkomt met de werkelijke bezetting.</skos:example>
    <skos:example xml:lang="en">Fictitious example — a driver anonymously reports via an app that the published number of available spaces at Truckparking Voorbeeldstad does not match the actual occupancy.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsvoorziening">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Beveiligingsvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Security Feature</skos:prefLabel>
    <skos:definition xml:lang="nl">Een fysieke of technologische maatregel die is geïnstalleerd op een vrachtwagenparkeerterrein om diefstal, lading manipulatie of ongeoorloofde toegang te voorkomen.</skos:definition>
    <skos:definition xml:lang="en">A physical or technological measure installed at a truck parking area to prevent theft, cargo tampering, or unauthorised access.</skos:definition>
    <skos:example xml:lang="nl">CCTV met dekking van alle vrachtwagenparkeerplaatsen en toegangspunten, minimaal HD 720p, bewaarintermijn opnames 30 dagen; hekwerk 2,0 m gegalvaniseerd staalvlechtwerk met anti-klimrail.</skos:example>
    <skos:example xml:lang="en">CCTV covering all truck bays and entry/exit points, HD 720p minimum, 30-day recording retention; perimeter fencing 2.0 m galvanised steel mesh with anti-climb top rail.</skos:example>
    <skos:scopeNote xml:lang="nl">Gedelegeerde Verordening 2022/1012 Bijlage I specificeert minimale technische vereisten per voorziening per niveau (bijv. CCTV minimaal HD 720p resolutie bij 5 fps voor Zilver en hoger).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Delegated Regulation 2022/1012 Annex I specifies minimum technical requirements per feature per tier (e.g. CCTV minimum HD 720p resolution at 5 fps for Silver and above).</skos:scopeNote>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Verzorgingsplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Motorway Service Area</skos:prefLabel>
    <skos:definition xml:lang="nl">Een rustplaats langs een rijksweg (Rijkswaterstaat) die minimaal een parkeerzone en sanitaire voorzieningen biedt, en vaak aangewezen vrachtwagenparkeerplaatsen bevat. Beheerd door Rijkswaterstaat op basis van de CROW KIVZP-criteria.</skos:definition>
    <skos:definition xml:lang="en">A rest area alongside a national highway (Rijkswaterstaat) providing at minimum a parking zone and sanitary facilities, and often incorporating designated truck parking bays. Managed by Rijkswaterstaat under the CROW KIVZP criteria.</skos:definition>
    <skos:example xml:lang="nl">Verzorgingsplaats De Lucht (A2, Noord-Brabant) — inclusief afzonderlijke omheinde vrachtwagenzone met sanitair en restaurant.</skos:example>
    <skos:example xml:lang="en">Verzorgingsplaats De Lucht (A2, Noord-Brabant) — includes a separate fenced truck parking zone with sanitary facilities and a restaurant.</skos:example>
    <skos:scopeNote xml:lang="nl">Verzorgingsplaatsen zijn formeel geregistreerd door Rijkswaterstaat en zijn opgenomen in het NDW-truckparkingregister. De vrachtwagenzone draagt bord E8a en valt onder concessie- of beheersovereenkomsten van Rijkswaterstaat voor servicevoorzieningen. Niet alle verzorgingsplaatsen voldoen aan de beveiligingsclassificatiedrempels van Gedelegeerde Verordening (EU) 2022/1012.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Verzorgingsplaatsen are formally registered by Rijkswaterstaat and appear in the NDW truck parking register. They carry the E8a sign for the truck section and are bound by Rijkswaterstaat's concession or management agreements for service facilities. Not all verzorgingsplaatsen meet the security classification thresholds of Delegated Regulation (EU) 2022/1012.</skos:scopeNote>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Voertuigcategorie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Vehicle Category</skos:prefLabel>
    <skos:definition xml:lang="nl">De categorie voertuigen waarvoor een parkeerterrein of specifieke parkeerplaatsen zijn bestemd, op basis van de fysieke en operationele kenmerken van het voertuig, zoals gedefinieerd in RVV en EU-voertuigclassificatienormen.</skos:definition>
    <skos:definition xml:lang="en">The category of vehicles for which a parking area or specific parking spaces are designated, based on the physical and operational characteristics of the vehicle, as defined in the RVV 1990 and EU vehicle classification standards.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de context van DR 885/2013 zijn de relevante voertuigcategorieën vrachtauto's, opleggers en bussen. Toegangsbeperkingen op basis van voertuigcategorie worden geregeld door RVV, dat parkeren verbiedt op een E4–E13-aangewezen locatie voor voertuigen die niet tot de aangewezen categorie behoren. 

Bord E8a betreft specifiek vrachtwagens en bussen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In the context of DR 885/2013, the relevant vehicle categories are trucks (vrachtauto's), articulated lorries (opleggers), and buses (bussen). Access restrictions based on vehicle category are governed by RVV, which prohibits parking at an E4–E13 designated location for vehicles not belonging to the indicated category. 

Sign E8a specifically covers lorries and buses.</skos:scopeNote>
    <skos:example xml:lang="nl">Een parkeerterrein aangeduid met bord E8a mag uitsluitend worden gebruikt door vrachtwagens (motorrijtuigen met een toegestane maximummassa van meer dan 3.500 kg) en bussen. Personenauto's en bestelauto's tot 3.500 kg zijn uitgesloten.</skos:example>
    <skos:example xml:lang="en">A parking area signed E8a may only be used by trucks (motor vehicles with a maximum authorised mass exceeding 3,500 kg) and buses. Passenger cars and vans up to 3,500 kg are excluded.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Status</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Status</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Beschikbaarheid</skos:altLabel>
    <skos:altLabel xml:lang="nl">Availability</skos:altLabel>
    <skos:definition xml:lang="nl">De actuele operationele toestand van een vrachtwagenparkeerterrein, die aangeeft of er parkeerplaatsen beschikbaar zijn, of het terrein bijna vol of vol is, of dat het gesloten is.</skos:definition>
    <skos:definition xml:lang="en">The current operational condition of a truck parking area, indicating whether parking spaces are available, whether the area is almost full or full, or whether it is closed.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132751226"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132848912"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747"/>
    <skos:narrowMatch rdf:resource="https://docs.datex2.eu/_static/data/v3.2/umlmodel/html/index.htm?goto=3:4:2:994"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Primaire weg</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Primary Road</skos:prefLabel>
    <skos:definition xml:lang="nl">De identificatie en rijrichting van de weg of wegen (maximaal twee) waarvan het vrachtwagenparkeerterrein direct toegankelijk is.</skos:definition>
    <skos:definition xml:lang="en">The identifier and travel direction of the road or roads (maximum two) from which the truck parking area is directly accessible.</skos:definition>
    <skos:scopeNote xml:lang="nl">Wegidentificatoren volgen de Nederlandse nationale nummeringsconventie: A-wegen (autosnelwegen), N-wegen (nationale wegen) en S-wegen (stadsroutes). Wegidentificatoren worden bijgehouden in het NWB (Nationaal Wegenbestand). Het richtingsveld geeft de hoofdbestemming aan die wordt bediend, zodat bestuurders het relevante parkeerterrein kunnen identificeren vanuit routegeleiding.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Road identifiers follow the Dutch national numbering convention: A-wegen (autosnelwegen), N-wegen (nationale wegen), and S-wegen (stadsroutes). Road identifiers are maintained in the NWB (Nationaal Wegenbestand). The direction field indicates the main destination served, enabling drivers to identify the relevant parking area from route guidance.</skos:scopeNote>
    <skos:example xml:lang="nl">Weg: A2, richting: Den Haag; nevenweg: N2, richting: Eindhoven-Centrum.</skos:example>
    <skos:example xml:lang="en">Road: A2, direction: Den Haag; secondary road: N2, direction: Eindhoven-Centrum.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Koelvoertuigplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Refrigerated Goods Vehicle Space</skos:prefLabel>
    <skos:definition xml:lang="nl">Een parkeerplaats die specifiek is aangewezen en ingericht voor koelvoertuigen (koelwagens), inclusief voorzieningen voor aangesloten koelunits (stroomaansluitingen), afzonderlijk gerapporteerd naast de totale vrachtwagenplaatsen zoals vereist in Gedelegeerde Verordening (EU) nr. 885/2013.</skos:definition>
    <skos:definition xml:lang="en">A parking space specifically designated and equipped for refrigerated goods vehicles (koelwagens), including provision for powered reefer units (stroomaansluitingen), reported separately from total truck capacity as required by Delegated Regulation (EU) No 885/2013.</skos:definition>
    <skos:example xml:lang="nl">Een parkeerterrein met 120 vrachtwagenplaatsen totaal, waarvan 8 bestemd voor koelvoertuigen, elk voorzien van een CEE 63A-aansluiting voor de koelaggregaat.</skos:example>
    <skos:example xml:lang="en">A parking area with 120 total truck spaces of which 8 are designated for refrigerated goods vehicles, each equipped with a CEE 63A connection for the reefer unit.</skos:example>
    <skos:scopeNote xml:lang="nl">Het aantal beschikbare plaatsen ten behove van koelvoertuigen conform Gedelegeerde Verordening (EU) nr. 885/2013. 

Exploitanten rapporteren dit aantal doorgaans op basis van geïnstalleerde elektrische aansluitpunten (CEE 32A of CEE 63A stopcontacten).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The number of spaces available for refrigerated goods vehicles in accordance with Delegated Regulation (EU) No 885/2013.

Operators usually report this number based on installed electrical connection points (CEE 32A or CEE 63A sockets).</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Tijdvenster</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Operating Hours</skos:prefLabel>
    <skos:definition xml:lang="nl">De perioden gedurende welke een vrachtwagenparkeerterrein open en toegankelijk is voor voertuigen, inclusief eventuele beperkingen per dag van de week of tijdstip. Relevant zowel voor toegangsvoorwaarden als voor de geldigheid van tariefinformatie.</skos:definition>
    <skos:definition xml:lang="en">The periods during which a truck parking area is open and accessible to vehicles, including any restrictions by day of week or time of day. Relevant both to access conditions and to the validity of tariff information.</skos:definition>
    <skos:scopeNote xml:lang="nl">24/7-beschikbaarheid is een vereiste voor Goud- en Platina-certificering onder DR (EU) 2022/1012 Bijlage I. Openingstijden kunnen de betrouwbaarheid van real-time beschikbaarheidsgegevens beïnvloeden: een gesloten parkeerterrein dient in het dynamische gegevenstype als 'gesloten' te worden weergegeven. In DATEX II correspondeert dit met OpeningTimes binnen de ParkingRecord-structuur.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">24/7 availability is a prerequisite for Gold and Platinum certification under DR (EU) 2022/1012 Annex I. Operating hours may affect the reliability of real-time availability data: a closed parking area should be reflected in the dynamic data type as 'closed'. In DATEX II this maps to OpeningTimes within the ParkingRecord structure.</skos:scopeNote>
    <skos:example xml:lang="nl">Open 24/7 het hele jaar; of: maandag–vrijdag 06:00–22:00, zaterdag 08:00–18:00, gesloten op zondag en feestdagen.</skos:example>
    <skos:example xml:lang="en">Open 24/7 all year; or: Monday–Friday 06:00–22:00, Saturday 08:00–18:00, closed on Sundays and public holidays.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736227821"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Parkeercapaciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Parking Capacity</skos:prefLabel>
    <skos:example xml:lang="nl">Totaal vrachtwagenplaatsen: 120 (waarvan 8 koelplaatsen). De statische capaciteit blijft 120 ongeacht de actuele bezetting.</skos:example>
    <skos:example xml:lang="en">Total truck spaces: 120 (of which 8 refrigerated). The static capacity remains 120 regardless of current occupancy.</skos:example>
    <skos:definition xml:lang="nl">Het totale aantal parkeerplaatsen dat op een parkeerterrein is bestemd voor vrachtwagens en bedrijfsvoertuigen, zoals vereist in Gedelegeerde Verordening (EU) nr. 885/2013.</skos:definition>
    <skos:definition xml:lang="en">The total number of parking spaces designated for trucks and commercial vehicles at a parking area, as required by Delegated Regulation (EU) No 885/2013.</skos:definition>
    <skos:scopeNote xml:lang="nl">Het capaciteitscijfer betreft uitsluitend plaatsen gedimensioneerd voor vrachtwagencombinaties (opleggers/semi-trailers) tenzij anders aangegeven. 

Plaatsen voor koelvoertuigen worden afzonderlijk gerapporteerd. 

De capaciteit kan een statisch of een dynamisch gegeven zijn.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The capacity figure refers exclusively to spaces dimensioned for articulated lorries (opleggers/semi-trailers) unless otherwise specified. 

Spaces for refrigerated goods vehicles are reported separately. 

The capacity can concern static and dynamic figures.</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773737661675">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Uitgang</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Exit</skos:prefLabel>
    <skos:definition xml:lang="nl">De uitgang van het vrachtwagenparkeerterrein.</skos:definition>
    <skos:definition xml:lang="en">The exit of the truck parking area.</skos:definition>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-identificatiegegevens">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Identificatiegegevens vrachtwagenparkeerterrein</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Truck Parking Area Identification Information</skos:prefLabel>
    <skos:definition xml:lang="nl">De gegevens waarmee een vrachtwagenparkeerterrein eenduidig kan worden geïdentificeerd, bestaande uit de naam, de nationale identificatie (indien beschikbaar) en het adres, inclusief het land en de territoriale eenheid waarin het terrein ligt.</skos:definition>
    <skos:definition xml:lang="en">The information by which a truck parking area can be unambiguously identified, comprising its name, its national identifier (if available) and its address, including the country and territorial unit in which it is located.</skos:definition>
    <skos:scopeNote xml:lang="nl">Maximaal 200 tekens per veld. In Nederland dient het adres te zijn afgestemd op de BAG (Basisregistratie Adressen en Gebouwen) waar een BAG-adres beschikbaar is. Ligt het terrein langs een autosnelweg zonder straatadres, dan kan het adres worden aangevuld met de naam of het nummer van de weg, de hectometerpositie en de rijrichting waarlangs het terrein bereikbaar is.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Maximum 200 characters per field. In the Netherlands, the address must be consistent with the BAG (Basisregistratie Adressen en Gebouwen) where a BAG address exists. If the area is located along a motorway without a street address, the address may be supplemented with the name or number of the road, the hectometre position and the direction of travel from which the area is accessible.</skos:scopeNote>
    <skos:example xml:lang="nl">Fictief voorbeeld — naam: 'Truckparking Voorbeeldstad'; nationale identificatie: NL-TP-0000; adres: Fictieweg 1, 9999 ZZ Voorbeeldstad, Nederland.</skos:example>
    <skos:example xml:lang="en">Fictitious example — name: 'Truckparking Voorbeeldstad'; national identifier: NL-TP-0000; address: Fictieweg 1, 9999 ZZ Voorbeeldstad, the Netherlands.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773739249931">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Ingang</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Entrence</skos:prefLabel>
    <skos:definition xml:lang="nl">De toegang tot het vrachtwagenparkeerterrein.</skos:definition>
    <skos:definition xml:lang="en">The entrance to the truck parking area.</skos:definition>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-faciliteit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Faciliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Service Facility</skos:prefLabel>
    <skos:definition xml:lang="nl">Uitrusting, voorzieningen of diensten die beschikbaar zijn voor chauffeurs en voertuigen op een vrachtwagenparkeerterrein, buiten de basisparkeervoorziening, zoals vereist door Gedelegeerde Verordening (EU) nr. 885/2013.</skos:definition>
    <skos:definition xml:lang="en">Equipment, amenities, or services available to drivers and vehicles at a truck parking area, beyond the basic parking provision, as required by Delegated Regulation (EU) No 885/2013.</skos:definition>
    <skos:scopeNote xml:lang="nl">Dit omvat circa 60 apparatuurtypen waaronder douches, toiletten, restaurant, tankstation, AdBlue-dispensers, laadpunten voor elektrische voertuigen, weegbrug en bandenspanning. Voor verzorgingsplaatsen op het rijkswegennet stelt Rijkswaterstaat minimale voorzieningenvereisten op basis van de CROW KIVZP-criteria. Faciliteiten beïnvloeden de commerciële aantrekkelijkheid van een vrachtwagenparkeerterrein maar zijn secundair aan de verplichte statische gegevensvelden.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">This covers approximately 60 equipment types including showers, toilets, restaurant, fuel station, AdBlue dispensers, electric vehicle charging points, weighbridge, and tyre inflation. For verzorgingsplaatsen on the national highway network, minimum facility requirements are set by the CROW KIVZP criteria as applied by Rijkswaterstaat. Facilities influence the commercial attractiveness of a truck parking area but are secondary to the mandatory static data fields.</skos:scopeNote>
    <skos:example xml:lang="nl">Douches (8 cabines), toiletten (24/7 toegankelijk), restaurant (06:00–22:00), AdBlue-dispenser, hogedruk vrachtwagenwasstraat, weegbrug, 8 elektrische aansluitingen voor koelvoertuigen (CEE 63A).</skos:example>
    <skos:example xml:lang="en">Showers (8 cabins), toilets (24/7 accessible), restaurant (06:00–22:00), AdBlue dispenser, high-pressure truck wash, weighbridge, 8 refrigerated vehicle electrical connections (CEE 63A).</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verzorgingsplaats"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-koelvoertuigplaats"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toezicht">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Toezicht</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Supervision</skos:prefLabel>
    <skos:definition xml:lang="nl">Het type bewakings- en toezichtregeling op een vrachtwagenparkeerterrein, die aangeeft of het terrein is bemand, op afstand wordt bewaakt of onbemand is.</skos:definition>
    <skos:definition xml:lang="en">The type of monitoring and supervision arrangement in place at a truck parking area, indicating whether the site is staffed, remotely monitored, or unattended.</skos:definition>
    <skos:scopeNote xml:lang="nl">DATEX II ParkingSupervisionEnum omvat: patrolled, remoteSurveillance, staffOnSite, controlCentre, none. Goud- en Platina-certificering onder DR 2022/1012 vereisen minimaal remoteSurveillance met 24/7-dekking. Het type toezicht heeft direct invloed op de responstijd bij incidenten en is relevant voor het dynamische gegevenstype.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">DATEX II ParkingSupervisionEnum includes: patrolled, remoteSurveillance, staffOnSite, controlCentre, none. Gold and Platinum certification under DR 2022/1012 require at minimum remoteSurveillance with 24/7 coverage. Supervision type directly affects the real-time responsiveness to incidents and is relevant to the dynamic data type.</skos:scopeNote>
    <skos:example xml:lang="nl">staffOnSite: een beveiliger die 24/7 op het terrein aanwezig is; remoteSurveillance: CCTV-beelden worden bewaakt vanuit een centrale meldkamer in Amsterdam, met interventiemogelijkheid via een gecontracteerde responsdienst.</skos:example>
    <skos:example xml:lang="en">staffOnSite: a security guard present at the site 24/7; remoteSurveillance: CCTV feeds monitored from a central control room in Amsterdam, with intervention capability via contracted response service.</skos:example>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Verkeersbesluit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic Order</skos:prefLabel>
    <skos:definition xml:lang="nl">Een formeel administratief besluit van het bevoegde gezag (wegbeheerder) waarbij een locatie wordt aangewezen als vrachtwagenparkeerterrein, dat de juridische grondslag vormt voor de plaatsing van het E8a bord en de handhaving van toegangsbeperkingen.</skos:definition>
    <skos:definition xml:lang="en">A formal administrative decision by the competent road authority (wegbeheerder) designating a location as a truck parking area, establishing the legal basis for placing a E8a sign and enforcing access restrictions.</skos:definition>
    <skos:scopeNote xml:lang="nl">Een verkeersbesluit voor vrachtwagenparkeren wordt genomen. De procedure vereist verplichte advisering door de politie en bekendmaking in de Staatscourant, gevolgd door een bezwaar- en beroepstermijn van zes weken. 

Verkeersbesluiten zijn openbaar toegankelijk via officielebekendmakingen.nl en het LVBB. 

Niet alle vrachtwagenparkeerterreinen hebben een specifiek verkeersbesluit — terreinen die worden gereguleerd via APV gebruiken in plaats daarvan een aanwijzingsbesluit.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A verkeersbesluit for truck parking is taken. The procedure requires mandatory consultation with the police and publication in the Staatscourant, followed by a six-week objection and appeal period.

Verkeersbesluiten are publicly accessible via officielebekendmakingen.nl and the LVBB. 

Not all truck parking areas have a dedicated verkeersbesluit — areas regulated under APV use an aanwijzingsbesluit instead.</skos:scopeNote>
    <skos:example xml:lang="nl">Verkeersbesluit Rijkswaterstaat, kenmerk RWS-2021/12345, gepubliceerd Staatscourant 14 april 2021: aanwijzing verzorgingsplaats X als vrachtwagenparkeerterrein met bord E8a.</skos:example>
    <skos:example xml:lang="en">Traffic order (verkeersbesluit) by Rijkswaterstaat, reference RWS-2021/12345, published in the Staatscourant on 14 April 2021: designation of service area X as a truck parking area with sign E8a.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-voertuigcategorie"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Exploitant</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Operator</skos:prefLabel>
    <skos:definition xml:lang="nl">De rechtspersoon die verantwoordelijk is voor het dagelijks beheer en de exploitatie van een vrachtwagenparkeerterrein, inclusief het verstrekken van contactgegevens voor publicatie, zoals vereist door de Gedelegeerde Verordening (EU) nr. 885/2013.</skos:definition>
    <skos:definition xml:lang="en">The legal entity responsible for the day-to-day management and operation of a truck parking area, including the provision of contact information for publication, as required by Delegated Regulation (EU) No 885/2013.</skos:definition>
    <skos:scopeNote xml:lang="nl">De identiteit van de exploitant kan worden geverifieerd via de Nederlandse KvK-registratie (Kamer van Koophandel). Het registreert of de exploitant heeft ingestemd met het openbaar beschikbaar stellen van zijn contactgegevens via het nationaal toegangspunt. De exploitant kan afwijken van de wegbeheerder, met name bij particulier geëxploiteerde vrachtwagenparkeerterreinen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The operator's identity can be verified against the Dutch Chamber of Commerce (Kamer van Koophandel) registration. The information records whether the operator has consented to their contact details being made publicly available via the national access point. The operator may differ from the wegbeheerder (road authority), particularly at privately operated truck parking facilities.</skos:scopeNote>
    <skos:example xml:lang="nl">Fictief voorbeeld — exploitant: Voorbeeldparking B.V., KvK 00000000; publicatietoestemming contactgegevens: ja.</skos:example>
    <skos:example xml:lang="en">Fictitious example — operator: Voorbeeldparking B.V., Chamber of Commerce (KvK) number 00000000; consent to publish contact details: yes.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tarief"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-wegbeheerder"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title xml:lang="nl">SSTP - Statische en dynamische gegevens met betrekking tot het parkeerterrein</dct:title>
    <dct:title xml:lang="en">SSTP - Static and dynamic data relating to the parking area</dct:title>
    <dct:description xml:lang="nl">De Nederlandse zienswijze van de concepten die Statische gegevens met betrekking tot het parkeerterrein weergeeft. Dit gegevenstype is vastgelegd in de Safe and Secure TruckParking regulation die onderdeel uitmaakt van de ITS wetgeving.</dct:description>
    <dct:description xml:lang="en">The Dutch perspective on the concepts representing static data related to parking areas. This data type is defined in the Safe and Secure Truck Parking regulation, which forms part of the ITS legislation.</dct:description>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-05T10:17:06.728009+00:00</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-15T10:07:57.580659+00:00</dct:modified>
    <owl:versionInfo>0.5.0</owl:versionInfo>
    <adms:status rdf:resource="http://purl.org/adms/status/UnderDevelopment"/>
    <dct:type rdf:resource="http://purl.org/adms/assettype/Thesaurus"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N58c3299e0dbe471d9eadb715da4c72a5">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132920747"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132889371">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">_Bezettingsgraad</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Occupancy Rate</skos:prefLabel>
    <skos:definition xml:lang="nl">Het actuele percentage van de totale parkeercapaciteit voor vrachtwagens op een vrachtwagenparkeerterrein dat bezet is.</skos:definition>
    <skos:definition xml:lang="en">The current percentage of the total truck parking capacity at a truck parking area that is occupied.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Contactgegevens exploitant</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Operator Contact Details</skos:prefLabel>
    <skos:definition xml:lang="nl">De gegevens waarmee gebruikers van een vrachtwagenparkeerterrein contact kunnen opnemen met de exploitant of een daaraan verbonden onderneming, bestaande uit het telefoonnummer en het e-mailadres van het contactpunt en optioneel de naam van de contactpersoon.</skos:definition>
    <skos:definition xml:lang="en">The information enabling users of a truck parking area to contact the parking operator or an associated company, comprising the telephone number and e-mail address of the contact point and, optionally, the name of the contact person.</skos:definition>
    <skos:scopeNote xml:lang="nl">Deze gegevens worden alleen openbaar gemaakt als de exploitant daarmee instemt; Gedelegeerde Verordening (EU) nr. 885/2013 legt die instemming als afzonderlijk gegeven vast.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">These details are only made public if the operator consents; Delegated Regulation (EU) No 885/2013 records that consent as a separate data item.</skos:scopeNote>
    <skos:example xml:lang="nl">Fictief voorbeeld — contactpunt: receptie Truckparking Voorbeeldstad; telefoon: +31 00 000 0000; e-mail: contact@voorbeeldparking.example.</skos:example>
    <skos:example xml:lang="en">Fictitious example — contact point: reception Truckparking Voorbeeldstad; telephone: +31 00 000 0000; e-mail: contact@voorbeeldparking.example.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-exploitant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afrit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Afrit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Motorway Exit</skos:prefLabel>
    <skos:definition xml:lang="nl">De afrit of afritten die een vrachtwagenchauffeur moet nemen om het vrachtwagenparkeerterrein vanaf de primaire weg te bereiken of om het terrein te verlaten.</skos:definition>
    <skos:definition xml:lang="en">The exit or exits that a truck driver must take to reach the truck parking area from the primary road or to leave the area.</skos:definition>
    <skos:scopeNote xml:lang="nl">De afrit wordt aangeduid met het nummer, de locatiecode en/of de naam van het knooppunt of de aansluiting. In Nederland worden afritnummers van autosnelwegen toegekend door Rijkswaterstaat en gepubliceerd in het NWB.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The exit is indicated by the number, location code and/or name of the junction or interchange. In the Netherlands, motorway exit numbers are assigned by Rijkswaterstaat and published in the NWB.</skos:scopeNote>
    <skos:example xml:lang="nl">Fictief voorbeeld — afrit 99 'Voorbeeldstad' van de A99.</skos:example>
    <skos:example xml:lang="en">Fictitious example — exit 99 'Voorbeeldstad' on the A99.</skos:example>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-primaire-weg"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-afstand-primaire-weg"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-sstp-gegevenstype">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Gegevenstype SSTP – Statische parkeergegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="en">SSTP Data Type – Static Parking Data</skos:prefLabel>
    <skos:definition xml:lang="nl">Gegevenstype binnen de SSTP-context dat de verzameling van concepten beschrijft die nodig zijn om statische informatie over veilige en beveiligde vrachtwagenparkeerterreinen op het trans-Europees wegennet eenduidig vast te leggen en uit te wisselen.</skos:definition>
    <skos:definition xml:lang="en">Data type within the SSTP context that describes the collection of concepts required to unambiguously record and exchange static information about safe and secure truck parking areas on the trans-European road network.</skos:definition>
    <skos:scopeNote xml:lang="nl">Dit gegevenstype is gedefinieerd als onderdeel van de Nederlandse implementatie van de ITS-richtlijn (2010/40/EU) en Gedelegeerde Verordening (EU) nr. 885/2013 inzake informatiediensten voor veilige en beveiligde parkeerplaatsen voor vrachtwagens en bedrijfsvoertuigen. Statische gegevens moeten beschikbaar zijn via het nationaal toegangspunt (NTM/NDW) en minimaal jaarlijks worden bijgewerkt.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">This data type is defined as part of the Dutch implementation of the ITS Directive (2010/40/EU) and Delegated Regulation (EU) No 885/2013 on information services for safe and secure parking places for trucks and commercial vehicles. Static data must be made available via the national access point (NTM/NDW) and updated at least annually.</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-verkeersbesluit"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773735874023">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Gebruiker</skos:prefLabel>
    <skos:prefLabel xml:lang="en">User</skos:prefLabel>
    <skos:definition xml:lang="nl">Een persoon of instantie die gebruikmaakt van het vrachtwagenparkeerterrein of van de informatie daarover.</skos:definition>
    <skos:definition xml:lang="en">A person or body that makes use of the truck parking area or of the information about it.</skos:definition>
    <skos:scopeNote xml:lang="nl">Iedere chauffeur van een vrachtwagen of bedrijfsvoertuig, planner, transporteur, verkeersregelaar of andere instantie zoals ladingeigenaren, verzekeringsmaatschappijen, wegbeheerders en politie. Zij dienen de informatie te verkrijgen van de dienstverleners.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Any truck or commercial vehicle driver, dispatcher, haulier, traffic management body, or any other body such as cargo owners, insurance companies, road authorities and police forces. They should obtain the information from the service providers.</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-naam-adres"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1773736053834"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsvoorziening">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Veiligheidsvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Safety Provision</skos:prefLabel>
    <skos:definition xml:lang="nl">Een voorziening op een vrachtwagenparkeerterrein die dient ter bescherming van de fysieke veiligheid van chauffeurs en inzittenden, onderscheiden van beveiligingsmaatregelen voor lading.</skos:definition>
    <skos:definition xml:lang="en">A facility at a truck parking area that serves to protect the physical safety of drivers and occupants, as distinct from cargo security measures.</skos:definition>
    <skos:scopeNote xml:lang="nl">Deze zijn te onderscheiden van beveiligingsvoorzieningen die betrekking hebben op misdaadpreventie.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">These are distinct from security features (beveiligingsvoorzieningen) which concern crime prevention.</skos:scopeNote>
    <skos:example xml:lang="nl">Noodtelefoon verbonden met een 24/7 bemande meldkamer; brandblusserposten elke 50 meter langs de parkeerrijen; AED (defibrillator) bij het receptiegebouw.</skos:example>
    <skos:example xml:lang="en">Emergency telephone connected to a 24/7 manned control room; fire extinguisher posts every 50 metres along the parking rows; AED (defibrillator) at the reception building.</skos:example>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Beveiligingsniveau</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Security Level</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Brons vereist basishekwerk en verlichting. Zilver voegt CCTV-dekking toe. Goud vereist daarnaast 24/7 bemand of op afstand toezicht en een parkeermanagementsysteem met DATEX II-uitvoermogelijkheid. Platina vereist alle Goud-kenmerken plus actieve dreigingsbewaking en een geïntegreerd beveiligingsoperatiecentrum. Certificering wordt uitgevoerd door geaccrediteerde conformiteitsbeoordelingsinstanties onder EN ISO/IEC 17021-1. In Nederland is het SecureNL-consortium een relevante certificerende instantie.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Bronze requires basic perimeter fencing and lighting. Silver adds CCTV coverage. Gold additionally requires 24/7 staffed or remote surveillance and a parking management system with DATEX II output capability. Platinum requires all Gold features plus active threat monitoring and an integrated security operations centre. Certification is performed by accredited conformity assessment bodies under EN ISO/IEC 17021-1. In the Netherlands, the SecureNL consortium is a relevant certification body.</skos:scopeNote>
    <skos:example xml:lang="nl">Goud-niveau: 24/7 CCTV-bewaking op afstand, automatische inrij-/uitrijbarrières, DATEX II-datafeed naar NDW, minimale verlichting 15 lux op maaiveld, hekwerk ≥ 1,8 m.</skos:example>
    <skos:example xml:lang="en">Gold level: 24/7 remote CCTV surveillance, automated entry/exit barriers, DATEX II data feed to NDW, minimum 15 Lux lighting at ground level, perimeter fencing ≥ 1.8 m.</skos:example>
    <skos:definition xml:lang="nl">Het niveau van beveiligingscertificering dat een vrachtwagenparkeerterrein heeft behaald onder het Europese classificatiekader van Gedelegeerde Verordening (EU) 2022/1012, of een gelijkwaardig nationaal classificatiesysteem. De vier Europese niveaus zijn Brons, Zilver, Goud en Platina.</skos:definition>
    <skos:definition xml:lang="en">The tier of security certification achieved by a truck parking area under the European classification framework established by Delegated Regulation (EU) 2022/1012, or an equivalent national classification system. The four European tiers are Bronze, Silver, Gold, and Platinum.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-certificering"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-tijdvenster"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-certificering">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">Certificering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Certification</skos:prefLabel>
    <skos:example xml:lang="nl">Certificaat: 'SSTPA Goud', afgegeven door SecureNL, certificeringsdatum: 15-03-2024, geldig tot: 14-03-2027.</skos:example>
    <skos:example xml:lang="en">Certificate: 'SSTPA Gold', issued by SecureNL, certification date: 2024-03-15, valid until: 2027-03-14.</skos:example>
    <skos:definition xml:lang="nl">De formele bevestiging door een geaccrediteerde conformiteitsbeoordelingsinstantie dat een vrachtwagenparkeerterrein voldoet aan de vereisten van een bepaald beveiligingsniveau onder Gedelegeerde Verordening (EU) 2022/1012, inclusief de certificaatnaam, uitgevende instantie en datum van afgifte.</skos:definition>
    <skos:definition xml:lang="en">The formal attestation by an accredited conformity assessment body that a truck parking area meets the requirements of a specified security tier under Delegated Regulation (EU) 2022/1012, including the certification name, issuing body, and date of issue.</skos:definition>
    <skos:scopeNote xml:lang="nl">Certificering is vrijwillig onder Gedelegeerde Verordening 2022/1012 maar maakt het mogelijk dat het parkeerterrein wordt opgenomen in de EU-lijst van gecertificeerde SSTPA's. Certificeringsinstanties moeten zijn geaccrediteerd onder EN ISO/IEC 17021-1. In Nederland zijn ESPORG en het SecureNL-consortium actief op dit gebied. 

Goud- en Platina-gecertificeerde parkeerterreinen zijn verplicht een werkende DATEX II-dataverbinding met het nationaal toegangspunt te hebben.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Certification is voluntary under Delegated Regulation 2022/1012 but enables the parking area to be included in the EU's publicly accessible list of certified SSTPAs. Certification bodies must be accredited under EN ISO/IEC 17021-1. In the Netherlands, ESPORG and the SecureNL consortium are active in this domain. 

Gold and Platinum certified parking areas are required to have a functioning DATEX II data connection to the national access point.</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-veiligheidsclassificatie"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-beveiligingsniveau"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N740970ccd9514f20ae2306368b662974">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-capaciteit"/>
    <rdf:rest rdf:nodeID="N5227fe48b4d64b5e8c0867828bf93b54"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-1792132848912">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb"/>
    <skos:prefLabel xml:lang="nl">_Tijdelijke buitengebruikstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Temporary Closure</skos:prefLabel>
    <skos:definition xml:lang="nl">Een melding van een omstandigheid die leidt tot het geheel of gedeeltelijk buiten gebruik zijn van een vrachtwagenparkeerterrein, zoals onderhoud, een incident of een noodsituatie, inclusief de reden daarvan.</skos:definition>
    <skos:definition xml:lang="en">A notification of a circumstance resulting in a truck parking area being wholly or partly out of use, such as maintenance, an incident or an emergency, including its reason.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-parkeerterrein"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/36d8ea00-746c-4f90-8753-48a891961bdb/concept-toegangspunt"/>
  </rdf:Description>
