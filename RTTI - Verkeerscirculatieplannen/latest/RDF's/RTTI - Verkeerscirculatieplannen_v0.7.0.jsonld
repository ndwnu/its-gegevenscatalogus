  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793106808224",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Dit is de onderste laag uit het 4 lagen model, laag 1. Het bevat gegevens van fysieke objecten, zoals afmetingen, geografische ligging en type verharding."
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Fysieke inrichting netwerk (DSM-1)"
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ],
