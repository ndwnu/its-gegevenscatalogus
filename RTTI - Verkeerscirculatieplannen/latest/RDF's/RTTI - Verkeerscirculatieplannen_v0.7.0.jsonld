      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      },
      {
        "@id": "https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een classificatie van wegen op basis van het gewenste gebruik binnen het wegennet, onafhankelijk van de fysieke wegcategorie."
      },
      {
        "@language": "en",
        "@value": "A classification of roads based on the intended use within the road network, independent of the physical road category."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Funcitonele wegclassificatie => mapping -> https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000007"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Functionele wegclassificatie"
      },
      {
        "@language": "en",
        "@value": "Functional road class"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In een VCP wordt het gewenste gebruik dmv functionele wegclassificatie ingedeeld"
      },
      {
        "@language": "nl",
        "@value": "Gebaseerd op de INSPIRE Transport Networks FunctionalRoadClass. In de POLIS/CROW-positiepaper wordt de functionele wegclassificatie voorgesteld als basis (datatype 2b) voor het digitaal verkeerscirculatieplan, met de kanttekening dat voor beleidsdoeleinden vaak meer functies nodig zijn dan de Europese FRC biedt en dat multimodaliteit nog ontbreekt."
      },
      {
        "@language": "en",
        "@value": "Based on the INSPIRE Transport Networks FunctionalRoadClass. The POLIS/CROW position paper proposes the functional road classification as the basis (data type 2b) for the digital traffic circulation plan, with the caveat that policy purposes often require more functions than the European FRC offers and that multimodality is still lacking."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000023",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied met bewust beperkt gemotoriseerd verkeer, doorgaans gerealiseerd via ontheffingen en kentekenhandhaving."
      },
      {
        "@language": "en",
        "@value": "An area with deliberately limited motorised traffic, usually realised through exemptions and licence plate enforcement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Autoluw gebied"
      },
      {
        "@language": "en",
        "@value": "Low-car zone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Niet als zodanig in het RVV gedefinieerd; in de praktijk een combinatie van geslotenverklaringen, venstertijden en ontheffingen."
      },
      {
        "@language": "en",
        "@value": "Not defined as such in the RVV; in practice a combination of closure declarations, time windows and exemptions."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000014",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://data.crow.nl/thesaurus/term/48FA2203-699F-48A2-B82F-A0C4F6CA181C"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Verkeer dat noch een herkomst, noch een bestemming heeft binnen het beschouwde gebied."
      },
      {
        "@language": "en",
        "@value": "Traffic that has neither an origin nor a destination within the area under consideration."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Doorgaand verkeer"
      },
      {
        "@language": "en",
        "@value": "Through traffic"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Term conform de CROW-thesaurus. Het weren van doorgaand verkeer uit verblijfsgebieden is een kerndoel van veel verkeerscirculatieplannen."
      },
      {
        "@language": "en",
        "@value": "Term in line with the CROW thesaurus. Keeping through traffic out of residential areas is a core objective of many traffic circulation plans."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000025",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een straat die autovrij is gedurende de begin- en eindtijden van de schooldag."
      },
      {
        "@language": "en",
        "@value": "A street that is car-free during the start and end times of the school day."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Schoolstraat"
      },
      {
        "@language": "en",
        "@value": "School street"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Als concrete maatregel genoemd in de POLIS/CROW-positiepaper; in NL doorgaans gerealiseerd via een tijdgebonden geslotenverklaring."
      },
      {
        "@language": "en",
        "@value": "Mentioned as a concrete measure in the POLIS/CROW position paper; in the Netherlands usually realised through a time-bound closure declaration."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000009",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegcategorie gericht op de doorstroming van verkeer met een constante, doorgaans hoge snelheid, met ongelijkvloerse kruisingen."
      },
      {
        "@language": "en",
        "@value": "A road category aimed at the through-flow of traffic at a constant, generally high speed, with grade-separated intersections."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "RobS: voorstel om uit dit model te laten, heeft geen meerwaarde"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Stroomweg"
      },
      {
        "@language": "en",
        "@value": "Flow road"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Duurzaam Veilig-categorie; komt vooral buiten de bebouwde kom voor."
      },
      {
        "@language": "en",
        "@value": "Sustainable Safety (Duurzaam Veilig) category; occurs mainly outside built-up areas."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000005",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.crow.nl/kennisproducten/richtlijn-en-leidraad-voor-multimodale-netwerkkaders/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een eenduidige weergave van het beleidsmatig gewenste multimodale gebruik van het wegennet, met een prioritering tussen modaliteiten per netwerkonderdeel."
      },
      {
        "@language": "en",
        "@value": "An unambiguous representation of the multimodal use of the road network desired as a matter of policy, with a prioritisation between modes per network element."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Multimodaal netwerkkader"
      },
      {
        "@language": "en",
        "@value": "Multimodal network framework"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gestandaardiseerd via de CROW/LVMB-richtlijn en -leidraad voor multimodale netwerkkaders. Vormt de modaliteitslaag waarop voorkeursroutes en wegcategorisering kunnen aansluiten."
      },
      {
        "@language": "en",
        "@value": "Standardised through the CROW/LVMB guideline and manual for multimodal network frameworks. Forms the modality layer to which preferred routes and road categorisation can connect."
      }
    ]
  },
  {
