          {
            "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000031"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Punt- en wegvakmaatregelen"
      },
      {
        "@language": "en",
        "@value": "Link & node measures"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De fysiek-functionele indeling van een weg volgens de Nederlandse wegontwerpsystematiek, bepalend voor inrichting en gewenst gebruik."
      },
      {
        "@language": "en",
        "@value": "The physical-functional classification of a road according to the Dutch road design system, determining its layout and intended use."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000010"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000009"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Wegcategorie"
      },
      {
        "@language": "en",
        "@value": "Road category"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gebaseerd op de Duurzaam Veilig-categorisering (CROW). De Nederlandse wegcategorieen corresponderen functioneel met de Europese functionele wegclassificatie, maar vormen daarmee geen een-op-een-hierarchie; daarom een skos:related-relatie in plaats van broader/narrower."
      },
      {
        "@language": "en",
        "@value": "Based on the Sustainable Safety (Duurzaam Veilig) categorisation (CROW). The Dutch road categories correspond functionally to the European functional road classification, but do not form a one-to-one hierarchy with it; hence a skos:related relation instead of broader/narrower."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502"
      },
      {
        "@id": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@id": "https://docs.geostandaarden.nl/imgeo/catalogus/imgeo/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een onderdeel van het wegennet tussen twee opeenvolgende juncties, dat als kleinste eenheid dient voor de registratie van wegkenmerken en maatregelen."
      },
      {
        "@language": "en",
        "@value": "A part of the road network between two consecutive junctions, serving as the smallest unit for recording road characteristics and measures."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Wegvak"
      },
      {
        "@language": "en",
        "@value": "Road link"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In Nederland geregistreerd in het Nationaal Wegenbestand (NWB) en als Wegdeel in de BGT/IMGeo. Deze registraties dienen hier uitsluitend als referentiebron (dct:source), niet als koppeldoel."
      },
      {
        "@language": "en",
        "@value": "Recorded in the Netherlands in the National Road Database (NWB) and as Wegdeel in the BGT/IMGeo. These registers serve here solely as a reference source (dct:source), not as a linking target."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000027",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://docs.datex2.eu/levels/mastering/trafficregulation/"
      },
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegvak waar verkeer slechts in een rijrichting is toegestaan."
      },
      {
        "@language": "en",
        "@value": "A road link where traffic is permitted in one direction of travel only."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Eenrichtingsverkeer"
      },
      {
        "@language": "en",
        "@value": "One-way street"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Aangeduid met de borden C2/C3/C4 (RVV 1990); in DATEX II te modelleren als een TrafficRegulation. Eenrichtingsverkeer is een veelgebruikte circulatiemaatregel."
      },
      {
        "@language": "en",
        "@value": "Indicated by signs C2/C3/C4 (RVV 1990); to be modelled in DATEX II as a TrafficRegulation. One-way traffic is a widely used circulation measure."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000020",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      },
      {
        "@id": "https://zoek.officielebekendmakingen.nl/stb-2025-265.html"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een zone binnen een woonplaats waar motorvoertuigen die niet aan een bepaalde emissieklasse voldoen, worden geweerd."
      },
      {
        "@language": "en",
        "@value": "A zone from which motor vehicles that do not meet a given emission class are barred, in order to improve air quality; known across Europe as a low emission zone (LEZ)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Milieuzone"
      },
      {
        "@language": "en",
        "@value": "Low emission zone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000021"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Aangeduid met bord C22a, dat samen met de overige C22-borden wordt vervangen door het geunificeerde bord C22e (Stb. 2025, 265)."
      },
      {
        "@language": "en",
        "@value": "Indicated by sign C22a, which together with the other C22 signs is being replaced by the unified sign C22e (Stb. 2025, 265)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000004",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een bestuurlijk geformuleerd doel - zoals bereikbaarheid, leefbaarheid, verkeersveiligheid of luchtkwaliteit - dat de gewenste verkeersstromen binnen een verkeerscirculatieplan stuurt."
      },
      {
        "@language": "en",
        "@value": "An objective formulated at policy level - such as accessibility, liveability, road safety or air quality - that guides the desired traffic flows within a traffic circulation plan."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Beleidsdoel"
      },
      {
        "@language": "en",
        "@value": "Policy objective"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000005"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202276603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Conform de POLIS/CROW-positiepaper vormen beleidsdoelen de aanleiding voor de keuze van maatregelen en voorkeursroutes in een verkeerscirculatieplan."
      },
      {
        "@language": "en",
        "@value": "In line with the POLIS/CROW position paper, policy objectives are the reason for the choice of measures and preferred routes in a traffic circulation plan."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000034",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://docs.geostandaarden.nl/ibro/scope/"
      },
      {
        "@id": "https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502"
      },
      {
        "@id": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een locatie waar verkeer naar een andere route kan worden geleid."
      },
      {
        "@language": "en",
        "@value": "A location where traffic can be directed onto another route."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Knooppunt"
      },
      {
        "@language": "en",
        "@value": "Junction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie junctions (NAPCORE data dictionary). Voor de geometrische realisatie gelden NWB, BGT/IMGeo en het Rotterdamse Mercator/IBRO-model als referentiebron (dct:source)."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category junctions (NAPCORE data dictionary). For the geometric realisation, NWB, BGT/IMGeo and the Rotterdam Mercator/IBRO model serve as reference sources (dct:source)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000022",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied waarin in beginsel uitsluitend voetgangers zich mogen bevinden en voorrang hebben op overig verkeer."
      },
      {
        "@language": "en",
        "@value": "An area in which, in principle, only pedestrians may be present and where they have priority over other traffic."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Voetgangerszone"
      },
      {
        "@language": "en",
        "@value": "Pedestrian zone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Ook wel voetgangersgebied genoemd; aangeduid met de borden G7/G8 (RVV 1990)."
      },
      {
        "@language": "en",
        "@value": "Also referred to as a pedestrian area; indicated by signs G7/G8 (RVV 1990)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000007",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"
      },
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De negen niveaus van de functionele wegclassificatie, oplopend van niveau 0 (hoofdweg/autosnelweg) tot niveau 8 (lokale wegen van minder belang en paden)."
      },
      {
        "@language": "en",
        "@value": "The nine levels of the functional road classification, ranging from level 0 (main road/motorway) up to level 8 (local roads of minor importance and paths)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "FRC-niveaus 0 tot 8"
      },
      {
        "@language": "en",
        "@value": "FRC levels 0 to 8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Waardenlijst conform de INSPIRE FunctionalRoadClassValue-enumeratie, zoals weergegeven in de POLIS/CROW-positiepaper. De afzonderlijke niveau-URI's volgen het patroon van het INSPIRE-codelijstregister."
      },
      {
        "@language": "en",
        "@value": "Value list in line with the INSPIRE FunctionalRoadClassValue enumeration, as presented in the POLIS/CROW position paper. The individual level URIs follow the pattern of the INSPIRE code list register."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000018",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://data.crow.nl/thesaurus/term/264DF64F-903B-49CD-A4E4-D3E235A20FF2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Niet-motorvoertuigen, fietsers, voetgangers en geleiders of berijders van een dier, alsmede motorvoertuigen die slechts een lage snelheid kunnen of mogen rijden."
      },
      {
        "@language": "en",
        "@value": "Non-motorised vehicles, cyclists, pedestrians and persons leading or riding an animal, as well as motor vehicles that can or may travel only at a low speed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Langzaam verkeer"
      },
      {
        "@language": "en",
        "@value": "Slow traffic"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Term conform de CROW-thesaurus. Relevant omdat circulatiemaatregelen langzaam verkeer doorgaans uitzonderen (bijv. een knip die wel passeerbaar is voor fietsers)."
      },
      {
        "@language": "en",
        "@value": "Term in line with the CROW thesaurus. Relevant because circulation measures usually exempt slow traffic (e.g. a traffic filter that cyclists can still pass)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-03-19T11:14:20.285419+00:00"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "nl",
        "@value": "Dit conceptschema beschrijft de samenhangende set van permanente of terugkerende verkeersmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones)."
      },
      {
        "@language": "en",
        "@value": "This conceptual scheme describes the coherent set of permanent or recurring traffic measures designed by a road authority to manage traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences, and existing constraints (e.g., school zones)."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-11-20T15:12:43.033609+00:00"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "nl",
        "@value": "RTTI — Verkeerscirculatieplannen"
      },
      {
        "@language": "en",
        "@value": "RTTI - Traffic Circulation Plans"
      }
    ],
    "http://purl.org/dc/terms/type": [
      {
        "@id": "http://purl.org/adms/assettype/Thesaurus"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.7.0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://purl.org/adms/status/UnderDevelopment"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000024",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied dat alleen op door de gemeente bepaalde tijdstippen toegankelijk is voor (bevoorradend) gemotoriseerd verkeer."
      },
      {
        "@language": "en",
        "@value": "An area accessible to (delivery) motorised traffic only at times determined by the municipality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Venstertijdengebied"
      },
      {
        "@language": "en",
        "@value": "Time-window zone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000031"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Venstertijden worden kenbaar gemaakt via onderborden bij een geslotenverklaring (BABW). Veelgebruikt voor stadslogistiek."
      },
      {
        "@language": "en",
        "@value": "Time windows are made known by means of supplementary panels accompanying a closure declaration (BABW). Widely used for urban logistics."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793286609090",
