  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000015",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Bestuurders wier reisdoel een of meer percelen betreft die aan of nabij een weg met een geslotenverklaring liggen en die daartoe uitsluitend via die weg bereikbaar zijn, alsmede bestuurders van lijnbussen."
      },
      {
        "@language": "en",
        "@value": "Drivers whose journey destination concerns one or more plots situated on or near a road subject to a closure declaration and reachable for that purpose solely via that road, as well as drivers of scheduled buses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Bestemmingsverkeer"
      },
      {
        "@language": "en",
        "@value": "Destination traffic"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Definitie ontleend aan art. 1 RVV 1990. Bestemmingsverkeer wordt veelal via een onderbord uitgezonderd van een geslotenverklaring."
      },
      {
        "@language": "en",
        "@value": "Definition derived from art. 1 RVV 1990. Destination traffic is usually exempted from a closure declaration by means of a supplementary panel."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793104839754",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Indeling van voertuigen op basis van Verordening 2018/858. De hoofdindeling is als volgt: categorie M (passagiers), N (goederen) en O (aanhangwagens).\nBron: https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX%3A32018R0858&qid=1793104078311"
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Voertuigcategorie"
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000013",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een als erf aangeduid verblijfsgebied, begrensd door de borden G5 (begin) en G6 (einde), waar voetgangers de gehele breedte van de weg mogen gebruiken en stapvoets (15 km/u) wordt gereden."
      },
      {
        "@language": "en",
        "@value": "A residential area designated as a yard (Dutch: erf), bounded by signs G5 (start) and G6 (end), where pedestrians may use the full width of the road and vehicles travel at walking pace (15 km/h)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Woonerf"
      },
      {
        "@language": "en",
        "@value": "Residential yard"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RVV 1990 (borden G5/G6). Een woonerf is de meest verblijfsgerichte uitwerking van een erftoegangsweg."
      },
      {
        "@language": "en",
        "@value": "RVV 1990 (signs G5/G6). A woonerf is the most residential-oriented elaboration of an access road."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/punt-en-wegvakmaatregelen",
