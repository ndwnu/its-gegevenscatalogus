  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793810491018",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Eigenschap die aangeeft op basis waarvan de toegang tot een zone wordt beperkt."
      },
      {
        "@language": "en",
        "@value": "Property indicating the basis on which access to a zone is restricted."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Hier zou je all type regimes onder kunnen hangen: temporeel, voertuigtype, verkeersdeelnemertype, etc"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Regime"
      },
      {
        "@language": "en",
        "@value": "Regime"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000017",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een door de wegbeheerder beleidsmatig gewenste route per modaliteit of doelgroep, bedoeld om met serviceproviders te worden gedeeld zodat navigatiediensten erop kunnen sturen."
      },
      {
        "@language": "en",
        "@value": "A route desired by the road authority as a matter of policy, per mode or target group, intended to be shared with service providers so that navigation services can guide traffic along it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Voorkeursroute"
      },
      {
        "@language": "en",
        "@value": "Preferred route"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1787733042482"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Een van de in de POLIS/CROW-positiepaper genoemde use cases van een digitaal verkeerscirculatieplan (naast te mijden gebieden en het gebruik van hoofdroutes)."
      },
      {
        "@language": "en",
        "@value": "One of the use cases of a digital traffic circulation plan mentioned in the POLIS/CROW position paper (alongside areas to be avoided and the use of main routes)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000029",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een permanente toegangsbeperking voor een of meer voertuigcategorieen op een specifiek wegvak."
      },
      {
        "@language": "en",
        "@value": "A permanent access restriction for one or more vehicle categories on a specific road link."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Inrijverbod"
      },
      {
        "@language": "en",
        "@value": "No-entry restriction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie permanente toegangsbeperkingen (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category permanent access restrictions (NAPCORE data dictionary)."
      }
    ]
  },
  {
