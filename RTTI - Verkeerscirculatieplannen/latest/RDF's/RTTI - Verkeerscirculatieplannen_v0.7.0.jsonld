    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Bijvoorbeeld een vuilniswagen (speciale vrachtwegen) of een taxi (speciale auto)"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://datex2.eu/user-domains/uvars/"
      },
      {
        "@id": "https://napcore.eu/quality/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een begrenzing of beperking van het gebruik van het wegennet op basis van een regime dat geldig is binnen het afgebakende gebied."
      },
      {
        "@language": "en",
        "@value": "A limitation or restriction on the use of the road network on the basis of a regime that is valid within the defined area."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Graag reviewcommentaar toelichten @Nuno:\n\nOok onder RTTI : he crucial types of data on regulations and restrictions:\nstatic and dynamic traffic regulations, where applicable; boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones;"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000022"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202761035"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000023"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000013"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793811380198"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000021"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000020"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000024"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000025"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Zonaal toegangsregime"
      },
      {
        "@language": "en",
        "@value": "Urban vehicle access regulation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"
      },
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793810491018"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Bekend onder de Europese term UVAR (Urban Vehicle Access Regulation). In DATEX II ondergebracht in de namespaces TrafficRegulation en ControlledZone; het NAPCORE Quality Framework for UVAR Data beschrijft de bijbehorende datakwaliteitseisen."
      },
      {
        "@language": "en",
        "@value": "Known by the European term UVAR (Urban Vehicle Access Regulation). Placed in DATEX II in the TrafficRegulation and ControlledZone namespaces; the NAPCORE Quality Framework for UVAR Data describes the associated data quality requirements."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj"
      },
      {
        "@id": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      },
      {
        "@id": "https://eur-lex.europa.eu/legal-content/nl/ALL/?uri=oj:L_202302661"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een samenhangende set van permanente of terugkerende verkeersmanagementmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones)."
      },
      {
        "@language": "en",
        "@value": "A coherent set of permanent or recurring traffic management measures designed by a road authority to guide traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences and existing restrictions (e.g. school zones)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Verkeerscirculatieplan"
      },
      {
        "@language": "en",
        "@value": "Traffic circulation plan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Definitie gebaseerd op art. 2(21) van de Gedelegeerde Verordening RTTI (EU) 2022/670. In de POLIS/CROW-positiepaper (2024) wordt voorgesteld een digitaal verkeerscirculatieplan te modelleren als RTTI-datatype 2b: de functionele wegclassificatie aangevuld met use cases. De ITS-richtlijn verplicht digitalisering van nieuw ontwikkelde verkeerscirculatieplannen vanaf 2028 (zie Herziene Richtlijn (EU) 2023/2661) ITS Directive “BIJLAGE II BEGINSELEN VOOR DE SPECIFICATIES EN DE INVOERING VAN ITS (zoals bedoeld in de artikelen 5, 6, 7 en 8))."
      },
      {
        "@language": "nl",
        "@value": "Een verkeerscirculatieplan introduceert geen beperkingen."
      },
      {
        "@language": "en",
        "@value": "A traffic circulation plan does not itself introduce restrictions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ]
  },
