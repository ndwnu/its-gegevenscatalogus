  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000032",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De ruimtelijke begrenzing van een gebied waarbinnen een zonale verkeersregel geldt."
      },
      {
        "@language": "en",
        "@value": "The spatial delimitation of an area within which a zonal traffic rule applies."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Zonegrens"
      },
      {
        "@language": "en",
        "@value": "Zone boundary"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie grenzen van zonale beperkingen, verboden of geboden (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category boundaries of zonal restrictions, prohibitions or obligations (NAPCORE data dictionary)."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793102688983",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Dit is de 2e laag uit het 4 lagen model. Het bevat gegevens van geldende regels en beperkingen, zoals voertuigcategorie, wegtype (FRC), modaliteit en zones"
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrowMatch": [
      {
        "@id": "https://pending.ontologica.local/id/ec9c4463-3781-490a-8fb0-c3c4510e59c7/concept-1794213431938"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Functionele inrichting netwerk (DSM-2)"
      },
      {
        "@language": "en",
        "@value": "t.b.d."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000030",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een fysieke afsluiting - bijvoorbeeld door beweegbare palen - die doorgaand gemotoriseerd verkeer onmogelijk maakt, terwijl fietsers, voetgangers en ontheffinghouders kunnen passeren."
      },
      {
        "@language": "en",
        "@value": "A physical closure - for example by means of retractable bollards - that makes through motorised traffic impossible, while cyclists, pedestrians and exemption holders can pass."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Knip"
      },
      {
        "@language": "en",
        "@value": "Traffic filter"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De knip is de fysieke realisatie van een geslotenverklaring en een kernmaatregel tegen sluipverkeer in verkeerscirculatieplannen."
      },
      {
        "@language": "en",
        "@value": "The traffic filter is the physical realisation of a closure declaration and a core measure against rat-running traffic in traffic circulation plans."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000031",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Regelingen voor het laden en lossen van goederen, zoals de aanwijzing van wegvakken of gebieden en tijdgebonden beperkingen."
      },
      {
        "@language": "en",
        "@value": "Regulations for the loading and unloading of goods, such as the designation of road links or areas and time-bound restrictions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Bevoorradingsregeling"
      },
      {
        "@language": "en",
        "@value": "Freight delivery regulation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000024"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie freight delivery regulations (NAPCORE data dictionary); nauw verbonden met venstertijden."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category freight delivery regulations (NAPCORE data dictionary); closely linked to time windows."
      }
    ]
  },
  {
    "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000010",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://data.crow.nl/thesaurus/term/8504D234-DD69-4A8D-BA4E-E207E57ECEAD"
      },
      {
        "@id": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegcategorie die landelijk of stedelijk gebied ontsluit: doorstroming op de wegvakken, uitwisseling op de kruispunten."
      },
      {
        "@language": "en",
        "@value": "A road category that provides access to rural or urban areas: through-flow on the links, exchange at the intersections."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "RobS: voorstel om uit dit model te laten, heeft geen meerwaarde"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Gebiedsontsluitingsweg"
      },
      {
        "@language": "en",
        "@value": "Distributor road"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Duurzaam Veilig-categorie (CROW-thesaurus). Afgekort GOW."
      },
      {
        "@language": "en",
