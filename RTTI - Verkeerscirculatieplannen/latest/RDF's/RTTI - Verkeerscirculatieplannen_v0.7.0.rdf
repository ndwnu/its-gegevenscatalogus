  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000030">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Knip</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic filter</skos:prefLabel>
    <skos:definition xml:lang="nl">Een fysieke afsluiting - bijvoorbeeld door beweegbare palen - die doorgaand gemotoriseerd verkeer onmogelijk maakt, terwijl fietsers, voetgangers en ontheffinghouders kunnen passeren.</skos:definition>
    <skos:definition xml:lang="en">A physical closure - for example by means of retractable bollards - that makes through motorised traffic impossible, while cyclists, pedestrians and exemption holders can pass.</skos:definition>
    <skos:scopeNote xml:lang="nl">De knip is de fysieke realisatie van een geslotenverklaring en een kernmaatregel tegen sluipverkeer in verkeerscirculatieplannen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The traffic filter is the physical realisation of a closure declaration and a core measure against rat-running traffic in traffic circulation plans.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2e83b4c338b74386a3d6d5a2053cfc06">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000018"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793104839754">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Voertuigcategorie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">Indeling van voertuigen op basis van Verordening 2018/858. De hoofdindeling is als volgt: categorie M (passagiers), N (goederen) en O (aanhangwagens).
Bron: https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX%3A32018R0858&amp;qid=1793104078311</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N767aaa5d0d1642f38d2c4ef68f50ea88">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"/>
    <rdf:rest rdf:nodeID="N30819c5efaf14c2f9f77ca0c99f8eb72"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:topConceptOf rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Verkeerscirculatieplan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic circulation plan</skos:prefLabel>
    <skos:definition xml:lang="nl">Een samenhangende set van permanente of terugkerende verkeersmanagementmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones).</skos:definition>
    <skos:definition xml:lang="en">A coherent set of permanent or recurring traffic management measures designed by a road authority to guide traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences and existing restrictions (e.g. school zones).</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie gebaseerd op art. 2(21) van de Gedelegeerde Verordening RTTI (EU) 2022/670. In de POLIS/CROW-positiepaper (2024) wordt voorgesteld een digitaal verkeerscirculatieplan te modelleren als RTTI-datatype 2b: de functionele wegclassificatie aangevuld met use cases. De ITS-richtlijn verplicht digitalisering van nieuw ontwikkelde verkeerscirculatieplannen vanaf 2028 (zie Herziene Richtlijn (EU) 2023/2661) ITS Directive “BIJLAGE II BEGINSELEN VOOR DE SPECIFICATIES EN DE INVOERING VAN ITS (zoals bedoeld in de artikelen 5, 6, 7 en 8)).</skos:scopeNote>
    <skos:scopeNote xml:lang="nl">Een verkeerscirculatieplan introduceert geen beperkingen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A traffic circulation plan does not itself introduce restrictions.</skos:scopeNote>
    <dct:source rdf:resource="https://eur-lex.europa.eu/eli/reg_del/2022/670/oj"/>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <dct:source rdf:resource="https://eur-lex.europa.eu/legal-content/nl/ALL/?uri=oj:L_202302661"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndb42fc8d51f04d5a94d780bd20f1faa1">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000022"/>
    <rdf:rest rdf:nodeID="N9e40b36ec9444a319541776c2178f86f"/>
  </rdf:Description>
