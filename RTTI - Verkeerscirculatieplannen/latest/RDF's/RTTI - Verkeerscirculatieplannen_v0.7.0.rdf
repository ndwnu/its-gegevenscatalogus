  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000023">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Autoluw gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Low-car zone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied met bewust beperkt gemotoriseerd verkeer, doorgaans gerealiseerd via ontheffingen en kentekenhandhaving.</skos:definition>
    <skos:definition xml:lang="en">An area with deliberately limited motorised traffic, usually realised through exemptions and licence plate enforcement.</skos:definition>
    <skos:scopeNote xml:lang="nl">Niet als zodanig in het RVV gedefinieerd; in de praktijk een combinatie van geslotenverklaringen, venstertijden en ontheffingen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Not defined as such in the RVV; in practice a combination of closure declarations, time windows and exemptions.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/verkeersstromen-en-routering">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Verkeersstromen &amp; routering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic flows &amp; routing</skos:prefLabel>
    <skos:memberList rdf:nodeID="Nf24c61025cb9412f99826afe2a98475e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000013">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Woonerf</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Residential yard</skos:prefLabel>
    <skos:definition xml:lang="nl">Een als erf aangeduid verblijfsgebied, begrensd door de borden G5 (begin) en G6 (einde), waar voetgangers de gehele breedte van de weg mogen gebruiken en stapvoets (15 km/u) wordt gereden.</skos:definition>
    <skos:definition xml:lang="en">A residential area designated as a yard (Dutch: erf), bounded by signs G5 (start) and G6 (end), where pedestrians may use the full width of the road and vehicles travel at walking pace (15 km/h).</skos:definition>
    <skos:scopeNote xml:lang="nl">RVV 1990 (borden G5/G6). Een woonerf is de meest verblijfsgerichte uitwerking van een erftoegangsweg.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RVV 1990 (signs G5/G6). A woonerf is the most residential-oriented elaboration of an access road.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000022">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Voetgangerszone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Pedestrian zone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied waarin in beginsel uitsluitend voetgangers zich mogen bevinden en voorrang hebben op overig verkeer.</skos:definition>
    <skos:definition xml:lang="en">An area in which, in principle, only pedestrians may be present and where they have priority over other traffic.</skos:definition>
    <skos:scopeNote xml:lang="nl">Ook wel voetgangersgebied genoemd; aangeduid met de borden G7/G8 (RVV 1990).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Also referred to as a pedestrian area; indicated by signs G7/G8 (RVV 1990).</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000014">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Doorgaand verkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Through traffic</skos:prefLabel>
    <skos:definition xml:lang="nl">Verkeer dat noch een herkomst, noch een bestemming heeft binnen het beschouwde gebied.</skos:definition>
    <skos:definition xml:lang="en">Traffic that has neither an origin nor a destination within the area under consideration.</skos:definition>
    <skos:scopeNote xml:lang="nl">Term conform de CROW-thesaurus. Het weren van doorgaand verkeer uit verblijfsgebieden is een kerndoel van veel verkeerscirculatieplannen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Term in line with the CROW thesaurus. Keeping through traffic out of residential areas is a core objective of many traffic circulation plans.</skos:scopeNote>
    <dct:source rdf:resource="https://data.crow.nl/thesaurus/term/48FA2203-699F-48A2-B82F-A0C4F6CA181C"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Wegvak</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Road link</skos:prefLabel>
    <skos:definition xml:lang="nl">Een onderdeel van het wegennet tussen twee opeenvolgende juncties, dat als kleinste eenheid dient voor de registratie van wegkenmerken en maatregelen.</skos:definition>
    <skos:definition xml:lang="en">A part of the road network between two consecutive junctions, serving as the smallest unit for recording road characteristics and measures.</skos:definition>
    <skos:scopeNote xml:lang="nl">In Nederland geregistreerd in het Nationaal Wegenbestand (NWB) en als Wegdeel in de BGT/IMGeo. Deze registraties dienen hier uitsluitend als referentiebron (dct:source), niet als koppeldoel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Recorded in the Netherlands in the National Road Database (NWB) and as Wegdeel in the BGT/IMGeo. These registers serve here solely as a reference source (dct:source), not as a linking target.</skos:scopeNote>
    <dct:source rdf:resource="https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502"/>
    <dct:source rdf:resource="https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"/>
    <dct:source rdf:resource="https://docs.geostandaarden.nl/imgeo/catalogus/imgeo/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000007">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">FRC-niveaus 0 tot 8</skos:prefLabel>
    <skos:prefLabel xml:lang="en">FRC levels 0 to 8</skos:prefLabel>
    <skos:definition xml:lang="nl">De negen niveaus van de functionele wegclassificatie, oplopend van niveau 0 (hoofdweg/autosnelweg) tot niveau 8 (lokale wegen van minder belang en paden).</skos:definition>
    <skos:definition xml:lang="en">The nine levels of the functional road classification, ranging from level 0 (main road/motorway) up to level 8 (local roads of minor importance and paths).</skos:definition>
    <skos:scopeNote xml:lang="nl">Waardenlijst conform de INSPIRE FunctionalRoadClassValue-enumeratie, zoals weergegeven in de POLIS/CROW-positiepaper. De afzonderlijke niveau-URI's volgen het patroon van het INSPIRE-codelijstregister.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Value list in line with the INSPIRE FunctionalRoadClassValue enumeration, as presented in the POLIS/CROW position paper. The individual level URIs follow the pattern of the INSPIRE code list register.</skos:scopeNote>
    <dct:source rdf:resource="https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"/>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000018">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Langzaam verkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Slow traffic</skos:prefLabel>
    <skos:definition xml:lang="nl">Niet-motorvoertuigen, fietsers, voetgangers en geleiders of berijders van een dier, alsmede motorvoertuigen die slechts een lage snelheid kunnen of mogen rijden.</skos:definition>
    <skos:definition xml:lang="en">Non-motorised vehicles, cyclists, pedestrians and persons leading or riding an animal, as well as motor vehicles that can or may travel only at a low speed.</skos:definition>
    <skos:scopeNote xml:lang="nl">Term conform de CROW-thesaurus. Relevant omdat circulatiemaatregelen langzaam verkeer doorgaans uitzonderen (bijv. een knip die wel passeerbaar is voor fietsers).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Term in line with the CROW thesaurus. Relevant because circulation measures usually exempt slow traffic (e.g. a traffic filter that cyclists can still pass).</skos:scopeNote>
    <dct:source rdf:resource="https://data.crow.nl/thesaurus/term/264DF64F-903B-49CD-A4E4-D3E235A20FF2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/id/concept/MATNHU">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Gewenst gedrag</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Desired behavior</skos:prefLabel>
    <skos:definition xml:lang="nl">Gewenst gedrag is één van de volgende drie mogelijkheden: voorkeur, ontmoedigen, mijden</skos:definition>
    <skos:definition xml:lang="en">Desired behavior is one of the following three options: preference, discourage, or avoid.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000017"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000020">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Milieuzone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Low emission zone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een zone binnen een woonplaats waar motorvoertuigen die niet aan een bepaalde emissieklasse voldoen, worden geweerd.</skos:definition>
    <skos:definition xml:lang="en">A zone from which motor vehicles that do not meet a given emission class are barred, in order to improve air quality; known across Europe as a low emission zone (LEZ).</skos:definition>
    <skos:scopeNote xml:lang="nl">Aangeduid met bord C22a, dat samen met de overige C22-borden wordt vervangen door het geunificeerde bord C22e (Stb. 2025, 265).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Indicated by sign C22a, which together with the other C22 signs is being replaced by the unified sign C22e (Stb. 2025, 265).</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <dct:source rdf:resource="https://zoek.officielebekendmakingen.nl/stb-2025-265.html"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000021"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4bbd7b3d1c334bfeb1dbb980c2ab6f9f">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000025"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9e40b36ec9444a319541776c2178f86f">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000023"/>
    <rdf:rest rdf:nodeID="N2702c05931d04ecf8756fa264888595c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Zonaal toegangsregime</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Urban vehicle access regulation</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Bekend onder de Europese term UVAR (Urban Vehicle Access Regulation). In DATEX II ondergebracht in de namespaces TrafficRegulation en ControlledZone; het NAPCORE Quality Framework for UVAR Data beschrijft de bijbehorende datakwaliteitseisen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Known by the European term UVAR (Urban Vehicle Access Regulation). Placed in DATEX II in the TrafficRegulation and ControlledZone namespaces; the NAPCORE Quality Framework for UVAR Data describes the associated data quality requirements.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Graag reviewcommentaar toelichten @Nuno:

Ook onder RTTI : he crucial types of data on regulations and restrictions:
static and dynamic traffic regulations, where applicable; boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones;</skos:editorialNote>
    <skos:definition xml:lang="nl">Een begrenzing of beperking van het gebruik van het wegennet op basis van een regime dat geldig is binnen het afgebakende gebied.</skos:definition>
    <skos:definition xml:lang="en">A limitation or restriction on the use of the road network on the basis of a regime that is valid within the defined area.</skos:definition>
    <dct:source rdf:resource="https://datex2.eu/user-domains/uvars/"/>
    <dct:source rdf:resource="https://napcore.eu/quality/"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000022"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202761035"/>
