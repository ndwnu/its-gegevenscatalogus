  </rdf:Description>
  <rdf:Description rdf:nodeID="N186b7c263df74781a976d9563b9fe64b">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"/>
