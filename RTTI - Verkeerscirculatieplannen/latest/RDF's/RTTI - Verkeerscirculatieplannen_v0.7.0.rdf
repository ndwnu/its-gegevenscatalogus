>
  <rdf:Description rdf:nodeID="N052abcaa50f240258049d11235e477d2">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000034"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Wegcategorie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Road category</skos:prefLabel>
    <skos:definition xml:lang="nl">De fysiek-functionele indeling van een weg volgens de Nederlandse wegontwerpsystematiek, bepalend voor inrichting en gewenst gebruik.</skos:definition>
    <skos:definition xml:lang="en">The physical-functional classification of a road according to the Dutch road design system, determining its layout and intended use.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gebaseerd op de Duurzaam Veilig-categorisering (CROW). De Nederlandse wegcategorieen corresponderen functioneel met de Europese functionele wegclassificatie, maar vormen daarmee geen een-op-een-hierarchie; daarom een skos:related-relatie in plaats van broader/narrower.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Based on the Sustainable Safety (Duurzaam Veilig) categorisation (CROW). The Dutch road categories correspond functionally to the European functional road classification, but do not form a one-to-one hierarchy with it; hence a skos:related relation instead of broader/narrower.</skos:scopeNote>
    <dct:source rdf:resource="https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000010"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000009"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N385e5f8521224736a220c08662f5c8ee">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000017"/>
    <rdf:rest rdf:nodeID="N2e83b4c338b74386a3d6d5a2053cfc06"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000025">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Schoolstraat</skos:prefLabel>
    <skos:prefLabel xml:lang="en">School street</skos:prefLabel>
    <skos:definition xml:lang="nl">Een straat die autovrij is gedurende de begin- en eindtijden van de schooldag.</skos:definition>
    <skos:definition xml:lang="en">A street that is car-free during the start and end times of the school day.</skos:definition>
    <skos:scopeNote xml:lang="nl">Als concrete maatregel genoemd in de POLIS/CROW-positiepaper; in NL doorgaans gerealiseerd via een tijdgebonden geslotenverklaring.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Mentioned as a concrete measure in the POLIS/CROW position paper; in the Netherlands usually realised through a time-bound closure declaration.</skos:scopeNote>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Erftoegangsweg</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Access road</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegcategorie gericht op het toegankelijk maken van erven en bestemmingen, met een verblijfsfunctie en een lage snelheid.</skos:definition>
    <skos:definition xml:lang="en">A road category aimed at providing access to premises and destinations, with a residential function and a low speed.</skos:definition>
    <skos:editorialNote xml:lang="nl">RobS: voorstel om uit dit model te laten, heeft geen meerwaarde</skos:editorialNote>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie (CROW). Afgekort ETW.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category (CROW). Abbreviated ETW.</skos:scopeNote>
    <dct:source rdf:resource="https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000013"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1787733042482">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Bewegwijzering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Signage</skos:prefLabel>
    <skos:editorialNote xml:lang="nl">Definities graag aanleveren. Indien er op basis van andere standaarden (bijv. DATEXII) een beschrijving wordt toegevoegd, graag URL meegeven.</skos:editorialNote>
    <skos:definition xml:lang="nl">t.b.d.</skos:definition>
    <skos:definition xml:lang="en">t.b.d</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000027">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Eenrichtingsverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">One-way street</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegvak waar verkeer slechts in een rijrichting is toegestaan.</skos:definition>
    <skos:definition xml:lang="en">A road link where traffic is permitted in one direction of travel only.</skos:definition>
    <skos:scopeNote xml:lang="nl">Aangeduid met de borden C2/C3/C4 (RVV 1990); in DATEX II te modelleren als een TrafficRegulation. Eenrichtingsverkeer is een veelgebruikte circulatiemaatregel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Indicated by signs C2/C3/C4 (RVV 1990); to be modelled in DATEX II as a TrafficRegulation. One-way traffic is a widely used circulation measure.</skos:scopeNote>
    <dct:source rdf:resource="https://docs.datex2.eu/levels/mastering/trafficregulation/"/>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000034">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Knooppunt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Junction</skos:prefLabel>
    <skos:definition xml:lang="nl">Een locatie waar verkeer naar een andere route kan worden geleid.</skos:definition>
    <skos:definition xml:lang="en">A location where traffic can be directed onto another route.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie junctions (NAPCORE data dictionary). Voor de geometrische realisatie gelden NWB, BGT/IMGeo en het Rotterdamse Mercator/IBRO-model als referentiebron (dct:source).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category junctions (NAPCORE data dictionary). For the geometric realisation, NWB, BGT/IMGeo and the Rotterdam Mercator/IBRO model serve as reference sources (dct:source).</skos:scopeNote>
    <dct:source rdf:resource="https://docs.geostandaarden.nl/ibro/scope/"/>
    <dct:source rdf:resource="https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502"/>
    <dct:source rdf:resource="https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Geslotenverklaring</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Closure declaration</skos:prefLabel>
    <skos:definition xml:lang="nl">Een verbod om de betrokken weg of het betrokken weggedeelte in te rijden of in te gaan en te gebruiken.</skos:definition>
    <skos:definition xml:lang="en">A prohibition on entering and using the road or road section concerned.</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie ontleend aan art. 1 RVV 1990; gerealiseerd via de C-bordenreeks. Vormt de juridische basis voor veel circulatiemaatregelen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Definition derived from art. 1 RVV 1990; realised through the C series of signs. Forms the legal basis for many circulation measures.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000030"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000029"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793286609090"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000006">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Functionele wegclassificatie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Functional road class</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">In een VCP wordt het gewenste gebruik dmv functionele wegclassificatie ingedeeld</skos:scopeNote>
    <skos:scopeNote xml:lang="nl">Gebaseerd op de INSPIRE Transport Networks FunctionalRoadClass. In de POLIS/CROW-positiepaper wordt de functionele wegclassificatie voorgesteld als basis (datatype 2b) voor het digitaal verkeerscirculatieplan, met de kanttekening dat voor beleidsdoeleinden vaak meer functies nodig zijn dan de Europese FRC biedt en dat multimodaliteit nog ontbreekt.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Based on the INSPIRE Transport Networks FunctionalRoadClass. The POLIS/CROW position paper proposes the functional road classification as the basis (data type 2b) for the digital traffic circulation plan, with the caveat that policy purposes often require more functions than the European FRC offers and that multimodality is still lacking.</skos:scopeNote>
    <skos:definition xml:lang="nl">Een classificatie van wegen op basis van het gewenste gebruik binnen het wegennet, onafhankelijk van de fysieke wegcategorie.</skos:definition>
    <skos:definition xml:lang="en">A classification of roads based on the intended use within the road network, independent of the physical road category.</skos:definition>
    <skos:editorialNote xml:lang="nl">Funcitonele wegclassificatie =&gt; mapping -&gt; https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/</skos:editorialNote>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <dct:source rdf:resource="https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"/>
    <skos:narrower rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000007"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"/>
    <skos:exactMatch rdf:resource="https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000009">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Stroomweg</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Flow road</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegcategorie gericht op de doorstroming van verkeer met een constante, doorgaans hoge snelheid, met ongelijkvloerse kruisingen.</skos:definition>
    <skos:definition xml:lang="en">A road category aimed at the through-flow of traffic at a constant, generally high speed, with grade-separated intersections.</skos:definition>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie; komt vooral buiten de bebouwde kom voor.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category; occurs mainly outside built-up areas.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">RobS: voorstel om uit dit model te laten, heeft geen meerwaarde</skos:editorialNote>
    <dct:source rdf:resource="https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793810491018">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Regime</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Regime</skos:prefLabel>
    <skos:definition xml:lang="nl">Eigenschap die aangeeft op basis waarvan de toegang tot een zone wordt beperkt.</skos:definition>
    <skos:definition xml:lang="en">Property indicating the basis on which access to a zone is restricted.</skos:definition>
    <skos:editorialNote xml:lang="nl">Hier zou je all type regimes onder kunnen hangen: temporeel, voertuigtype, verkeersdeelnemertype, etc</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000021">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Nul-emissiezone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Zero-emission zone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een zone waar voor bedrijfs- en vrachtauto's uitsluitend emissieloze voertuigen zijn toegestaan.</skos:definition>
    <skos:definition xml:lang="en">A zone where only zero-emission vehicles are permitted for vans and lorries.</skos:definition>
    <skos:scopeNote xml:lang="nl">Sinds 1 januari 2025 voeren gemeenten nul-emissiezones voor stadslogistiek in. Aangeduid met bord C22c, dat opgaat in het geunificeerde bord C22e (Stb. 2025, 265).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Since 1 January 2025 municipalities have been introducing zero-emission zones for urban logistics. Indicated by sign C22c, which is being merged into the unified sign C22e (Stb. 2025, 265).</skos:scopeNote>
    <dct:source rdf:resource="https://zoek.officielebekendmakingen.nl/stb-2025-265.html"/>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000010">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Gebiedsontsluitingsweg</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Distributor road</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie (CROW-thesaurus). Afgekort GOW.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category (CROW thesaurus). Abbreviated GOW.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">RobS: voorstel om uit dit model te laten, heeft geen meerwaarde</skos:editorialNote>
    <skos:definition xml:lang="nl">Een wegcategorie die landelijk of stedelijk gebied ontsluit: doorstroming op de wegvakken, uitwisseling op de kruispunten.</skos:definition>
    <skos:definition xml:lang="en">A road category that provides access to rural or urban areas: through-flow on the links, exchange at the intersections.</skos:definition>
    <dct:source rdf:resource="https://data.crow.nl/thesaurus/term/8504D234-DD69-4A8D-BA4E-E207E57ECEAD"/>
    <dct:source rdf:resource="https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202276603">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Bedrijfsregels</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Business rules</skos:prefLabel>
    <skos:definition xml:lang="nl">Een regel die aangeeft hoe routering zich onder bepaalde omstandigheden hoort te gedragen (voorkeur, ontmoedigen, mijden), verwijzend naar een FRC of zone en afhankelijk van verkeerscontext en verkeersdoel.</skos:definition>
    <skos:definition xml:lang="en">A rule indicating how routing should behave under certain circumstances (prefer, discourage, or avoid), referring to an FRC or zone and depending on the traffic context and purpose.</skos:definition>
    <skos:editorialNote xml:lang="nl">Definitie is nog in wording in TISGRADE</skos:editorialNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793104839754"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793286609090"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793109418297"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/id/concept/MATNHU"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000007"/>
  </rdf:Description>
