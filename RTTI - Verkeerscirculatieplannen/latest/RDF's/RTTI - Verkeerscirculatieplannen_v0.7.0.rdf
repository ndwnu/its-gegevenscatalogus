  <rdf:Description rdf:nodeID="Nb4f7524dc06e4a3a991726359ff21d68">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"/>
    <rdf:rest rdf:nodeID="N960ce5b4da4e45b5ac22e70a0e451b14"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf78f8f8c5d624a5ebbe8b091136cbc7b">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000030"/>
    <rdf:rest rdf:nodeID="N059a98a9e72b41729dd3bab09c428cbb"/>
