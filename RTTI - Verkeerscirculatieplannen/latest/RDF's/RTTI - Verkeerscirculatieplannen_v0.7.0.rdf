  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793106808224">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Fysieke inrichting netwerk (DSM-1)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">Dit is de onderste laag uit het 4 lagen model, laag 1. Het bevat gegevens van fysieke objecten, zoals afmetingen, geografische ligging en type verharding.</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000033"/>
  </rdf:Description>
