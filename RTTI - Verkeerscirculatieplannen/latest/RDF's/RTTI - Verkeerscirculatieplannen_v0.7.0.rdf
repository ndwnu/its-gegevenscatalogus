  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000031">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Bevoorradingsregeling</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Freight delivery regulation</skos:prefLabel>
    <skos:definition xml:lang="nl">Regelingen voor het laden en lossen van goederen, zoals de aanwijzing van wegvakken of gebieden en tijdgebonden beperkingen.</skos:definition>
    <skos:definition xml:lang="en">Regulations for the loading and unloading of goods, such as the designation of road links or areas and time-bound restrictions.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie freight delivery regulations (NAPCORE data dictionary); nauw verbonden met venstertijden.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category freight delivery regulations (NAPCORE data dictionary); closely linked to time windows.</skos:scopeNote>
    <dct:source rdf:resource="https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000024"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000015">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Bestemmingsverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Destination traffic</skos:prefLabel>
    <skos:definition xml:lang="nl">Bestuurders wier reisdoel een of meer percelen betreft die aan of nabij een weg met een geslotenverklaring liggen en die daartoe uitsluitend via die weg bereikbaar zijn, alsmede bestuurders van lijnbussen.</skos:definition>
    <skos:definition xml:lang="en">Drivers whose journey destination concerns one or more plots situated on or near a road subject to a closure declaration and reachable for that purpose solely via that road, as well as drivers of scheduled buses.</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie ontleend aan art. 1 RVV 1990. Bestemmingsverkeer wordt veelal via een onderbord uitgezonderd van een geslotenverklaring.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Definition derived from art. 1 RVV 1990. Destination traffic is usually exempted from a closure declaration by means of a supplementary panel.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004825"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202761035">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Schoolzone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">School zone</skos:prefLabel>
    <skos:definition xml:lang="nl">nader te bepalen. In deze zone geldt geen beperking of een verbod. Het is 'slechts' een waarschuwing. Vergelijkbaar met een "te mijden gebied"?: ook geen verbod, alleen een advies?</skos:definition>
    <skos:definition xml:lang="en">to be decided later</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf24c61025cb9412f99826afe2a98475e">
