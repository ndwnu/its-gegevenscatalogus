    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793810491018"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title xml:lang="nl">RTTI — Verkeerscirculatieplannen</dct:title>
    <dct:title xml:lang="en">RTTI - Traffic Circulation Plans</dct:title>
    <dct:description xml:lang="nl">Dit conceptschema beschrijft de samenhangende set van permanente of terugkerende verkeersmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones).</dct:description>
    <dct:description xml:lang="en">This conceptual scheme describes the coherent set of permanent or recurring traffic measures designed by a road authority to manage traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences, and existing constraints (e.g., school zones).</dct:description>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T11:14:20.285419+00:00</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-20T15:12:43.033609+00:00</dct:modified>
    <owl:versionInfo>0.7.0</owl:versionInfo>
    <adms:status rdf:resource="http://purl.org/adms/status/UnderDevelopment"/>
    <dct:type rdf:resource="http://purl.org/adms/assettype/Thesaurus"/>
    <skos:hasTopConcept rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793109418297">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Modaliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">Wijze van vervoeren</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
    <skos:editorialNote xml:lang="nl">In een presentatie van TISGRADE staat:
Digitized TCP/TMM:
- private motorized traffic only
- no public transport
- no multimodal traffic</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000004">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Beleidsdoel</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Policy objective</skos:prefLabel>
    <skos:definition xml:lang="nl">Een bestuurlijk geformuleerd doel - zoals bereikbaarheid, leefbaarheid, verkeersveiligheid of luchtkwaliteit - dat de gewenste verkeersstromen binnen een verkeerscirculatieplan stuurt.</skos:definition>
    <skos:definition xml:lang="en">An objective formulated at policy level - such as accessibility, liveability, road safety or air quality - that guides the desired traffic flows within a traffic circulation plan.</skos:definition>
    <skos:scopeNote xml:lang="nl">Conform de POLIS/CROW-positiepaper vormen beleidsdoelen de aanleiding voor de keuze van maatregelen en voorkeursroutes in een verkeerscirculatieplan.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In line with the POLIS/CROW position paper, policy objectives are the reason for the choice of measures and preferred routes in a traffic circulation plan.</skos:scopeNote>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000001"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000005"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1784202276603"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N30819c5efaf14c2f9f77ca0c99f8eb72">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000009"/>
    <rdf:rest rdf:nodeID="N7ba3e08e01e74c1086d9c470762c2093"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/zonale-toegangsregimes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Zonale toegangsregimes</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Urban vehicle access regulations</skos:prefLabel>
    <skos:memberList rdf:nodeID="N77c0d3faa59b49998e35af4a17a06d75"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N72992120d2f14a0599de5df73d16c40d">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000021"/>
    <rdf:rest rdf:nodeID="Ndb42fc8d51f04d5a94d780bd20f1faa1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000017">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Voorkeursroute</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Preferred route</skos:prefLabel>
    <skos:definition xml:lang="nl">Een door de wegbeheerder beleidsmatig gewenste route per modaliteit of doelgroep, bedoeld om met serviceproviders te worden gedeeld zodat navigatiediensten erop kunnen sturen.</skos:definition>
    <skos:definition xml:lang="en">A route desired by the road authority as a matter of policy, per mode or target group, intended to be shared with service providers so that navigation services can guide traffic along it.</skos:definition>
    <skos:scopeNote xml:lang="nl">Een van de in de POLIS/CROW-positiepaper genoemde use cases van een digitaal verkeerscirculatieplan (naast te mijden gebieden en het gebruik van hoofdroutes).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">One of the use cases of a digital traffic circulation plan mentioned in the POLIS/CROW position paper (alongside areas to be avoided and the use of main routes).</skos:scopeNote>
    <dct:source rdf:resource="https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1787733042482"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793811380198">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Mijdgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">Een zone waarvan de toegang niet ontzegd wordt, maar afgeraden (advies)</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000024">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Venstertijdengebied</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Time-window zone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied dat alleen op door de gemeente bepaalde tijdstippen toegankelijk is voor (bevoorradend) gemotoriseerd verkeer.</skos:definition>
    <skos:definition xml:lang="en">An area accessible to (delivery) motorised traffic only at times determined by the municipality.</skos:definition>
    <skos:scopeNote xml:lang="nl">Venstertijden worden kenbaar gemaakt via onderborden bij een geslotenverklaring (BABW). Veelgebruikt voor stadslogistiek.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Time windows are made known by means of supplementary panels accompanying a closure declaration (BABW). Widely used for urban logistics.</skos:scopeNote>
    <dct:source rdf:resource="https://wetten.overheid.nl/BWBR0004826"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/punt-en-wegvakmaatregelen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Punt- en wegvakmaatregelen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Link &amp; node measures</skos:prefLabel>
    <skos:memberList rdf:nodeID="Naf22e17caddb4b3bbee7e8c045210394"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000032">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Zonegrens</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Zone boundary</skos:prefLabel>
    <skos:definition xml:lang="nl">De ruimtelijke begrenzing van een gebied waarbinnen een zonale verkeersregel geldt.</skos:definition>
    <skos:definition xml:lang="en">The spatial delimitation of an area within which a zonal traffic rule applies.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie grenzen van zonale beperkingen, verboden of geboden (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category boundaries of zonal restrictions, prohibitions or obligations (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source rdf:resource="https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N42c34c45bb264826ac46f706fde923d4">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000013"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000005">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Multimodaal netwerkkader</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Multimodal network framework</skos:prefLabel>
    <skos:definition xml:lang="nl">Een eenduidige weergave van het beleidsmatig gewenste multimodale gebruik van het wegennet, met een prioritering tussen modaliteiten per netwerkonderdeel.</skos:definition>
    <skos:definition xml:lang="en">An unambiguous representation of the multimodal use of the road network desired as a matter of policy, with a prioritisation between modes per network element.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gestandaardiseerd via de CROW/LVMB-richtlijn en -leidraad voor multimodale netwerkkaders. Vormt de modaliteitslaag waarop voorkeursroutes en wegcategorisering kunnen aansluiten.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Standardised through the CROW/LVMB guideline and manual for multimodal network frameworks. Forms the modality layer to which preferred routes and road categorisation can connect.</skos:scopeNote>
    <dct:source rdf:resource="https://www.crow.nl/kennisproducten/richtlijn-en-leidraad-voor-multimodale-netwerkkaders/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793102688983">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Functionele inrichting netwerk (DSM-2)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">Dit is de 2e laag uit het 4 lagen model. Het bevat gegevens van geldende regels en beperkingen, zoals voertuigcategorie, wegtype (FRC), modaliteit en zones</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000019"/>
    <skos:narrowMatch rdf:resource="https://pending.ontologica.local/id/ec9c4463-3781-490a-8fb0-c3c4510e59c7/concept-1794213431938"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000029">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Inrijverbod</skos:prefLabel>
    <skos:prefLabel xml:lang="en">No-entry restriction</skos:prefLabel>
    <skos:definition xml:lang="nl">Een permanente toegangsbeperking voor een of meer voertuigcategorieen op een specifiek wegvak.</skos:definition>
    <skos:definition xml:lang="en">A permanent access restriction for one or more vehicle categories on a specific road link.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie permanente toegangsbeperkingen (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category permanent access restrictions (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source rdf:resource="https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"/>
    <skos:broader rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000028"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e4117d42e4c4c70a66bafd0b123396d">
    <rdf:first rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000012"/>
    <rdf:rest rdf:nodeID="N42c34c45bb264826ac46f706fde923d4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1793286609090">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Doelgroep</skos:prefLabel>
    <skos:prefLabel xml:lang="en">t.b.d.</skos:prefLabel>
    <skos:definition xml:lang="nl">net als modaliteit een selectie van weggebruikers, maar dan anders -&gt; rephrase</skos:definition>
    <skos:definition xml:lang="en">t.b.d.</skos:definition>
    <skos:scopeNote xml:lang="nl">Bijvoorbeeld een vuilniswagen (speciale vrachtwegen) of een taxi (speciale auto)</skos:scopeNote>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000014"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000015"/>
    <skos:related rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/concept-1773240000018"/>
  </rdf:Description>
