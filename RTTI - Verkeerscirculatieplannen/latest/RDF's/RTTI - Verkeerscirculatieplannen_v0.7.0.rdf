  <rdf:Description rdf:about="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8/geometrie-en-locatiereferentie">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://ndwnu.github.io/its-gegevenscatalogus/id/81b8cfdf-1be0-4990-beab-0d0cf24b1cc8"/>
    <skos:prefLabel xml:lang="nl">Geometrie &amp; locatiereferentie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Geometry &amp; location referencing</skos:prefLabel>
    <skos:memberList rdf:nodeID="Na08b0dff128a4e1cb8ff546e3a3a915b"/>
