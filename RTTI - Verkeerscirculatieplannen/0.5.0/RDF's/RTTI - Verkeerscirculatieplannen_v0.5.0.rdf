   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000026">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Limited traffic zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Zone met beperkt verkeer</skos:prefLabel>
    <skos:definition xml:lang="nl">Een afgebakend gebied waarbinnen het verkeer voor bepaalde voertuigcategorieen of doelgroepen is beperkt; internationaal bekend als ZTL (zona a traffico limitato).</skos:definition>
    <skos:definition xml:lang="en">A delimited area within which traffic is restricted for certain vehicle categories or target groups; known internationally as ZTL (zona a traffico limitato).</skos:definition>
    <skos:scopeNote xml:lang="nl">Generiek zonaal regime dat de internationale UVAR-praktijk dekt en in NL via geslotenverklaring met uitzonderingen wordt vormgegeven.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Generic zonal regime covering international UVAR practice, shaped in the Netherlands through a closure declaration with exemptions.</skos:scopeNote>
    <dct:source>https://datex2.eu/user-domains/uvars/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000025">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">School street</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Schoolstraat</skos:prefLabel>
    <skos:definition xml:lang="nl">Een straat die autovrij is gedurende de begin- en eindtijden van de schooldag.</skos:definition>
    <skos:definition xml:lang="en">A street that is car-free during the start and end times of the school day.</skos:definition>
    <skos:scopeNote xml:lang="nl">Als concrete maatregel genoemd in de POLIS/CROW-positiepaper; in NL doorgaans gerealiseerd via een tijdgebonden geslotenverklaring.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Mentioned as a concrete measure in the POLIS/CROW position paper; in the Netherlands usually realised through a time-bound closure declaration.</skos:scopeNote>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000015">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Destination traffic</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Bestemmingsverkeer</skos:prefLabel>
    <skos:definition xml:lang="nl">Bestuurders wier reisdoel een of meer percelen betreft die aan of nabij een weg met een geslotenverklaring liggen en die daartoe uitsluitend via die weg bereikbaar zijn, alsmede bestuurders van lijnbussen.</skos:definition>
    <skos:definition xml:lang="en">Drivers whose journey destination concerns one or more plots situated on or near a road subject to a closure declaration and reachable for that purpose solely via that road, as well as drivers of scheduled buses.</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie ontleend aan art. 1 RVV 1990. Bestemmingsverkeer wordt veelal via een onderbord uitgezonderd van een geslotenverklaring.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Definition derived from art. 1 RVV 1990. Destination traffic is usually exempted from a closure declaration by means of a supplementary panel.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Time-window zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Venstertijdengebied</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied dat alleen op door de gemeente bepaalde tijdstippen toegankelijk is voor (bevoorradend) gemotoriseerd verkeer.</skos:definition>
    <skos:definition xml:lang="en">An area accessible to (delivery) motorised traffic only at times determined by the municipality.</skos:definition>
    <skos:scopeNote xml:lang="nl">Venstertijden worden kenbaar gemaakt via onderborden bij een geslotenverklaring (BABW). Veelgebruikt voor stadslogistiek.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Time windows are made known by means of supplementary panels accompanying a closure declaration (BABW). Widely used for urban logistics.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004826</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000013">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Residential yard</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Woonerf</skos:prefLabel>
    <skos:definition xml:lang="nl">Een als erf aangeduid verblijfsgebied, begrensd door de borden G5 (begin) en G6 (einde), waar voetgangers de gehele breedte van de weg mogen gebruiken en stapvoets (15 km/u) wordt gereden.</skos:definition>
    <skos:definition xml:lang="en">A residential area designated as a yard (Dutch: erf), bounded by signs G5 (start) and G6 (end), where pedestrians may use the full width of the road and vehicles travel at walking pace (15 km/h).</skos:definition>
    <skos:scopeNote xml:lang="nl">RVV 1990 (borden G5/G6). Een woonerf is de meest verblijfsgerichte uitwerking van een erftoegangsweg.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">RVV 1990 (signs G5/G6). A woonerf is the most residential-oriented elaboration of an access road.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000012"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Through traffic</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Doorgaand verkeer</skos:prefLabel>
    <skos:definition xml:lang="nl">Verkeer dat noch een herkomst, noch een bestemming heeft binnen het beschouwde gebied.</skos:definition>
    <skos:definition xml:lang="en">Traffic that has neither an origin nor a destination within the area under consideration.</skos:definition>
    <skos:scopeNote xml:lang="nl">Term conform de CROW-thesaurus. Het weren van doorgaand verkeer uit verblijfsgebieden is een kerndoel van veel verkeerscirculatieplannen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Term in line with the CROW thesaurus. Keeping through traffic out of residential areas is a core objective of many traffic circulation plans.</skos:scopeNote>
    <dct:source>https://data.crow.nl/thesaurus/term/48FA2203-699F-48A2-B82F-A0C4F6CA181C</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Urban vehicle access regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">_Zonaal toegangsregime</skos:prefLabel>
    <skos:definition xml:lang="nl">Een begrenzing of beperking van het gebruik van het wegennet op basis van voertuigtype, reizigerstype of tijd, die geldt voor een afgebakend gebied.</skos:definition>
    <skos:definition xml:lang="en">A limitation or restriction on the use of the road network on the basis of vehicle type, traveller type or time, applying to a delimited area.</skos:definition>
    <skos:scopeNote xml:lang="nl">Bekend onder de Europese term UVAR (Urban Vehicle Access Regulation). In DATEX II ondergebracht in de namespaces TrafficRegulation en ControlledZone; het NAPCORE Quality Framework for UVAR Data beschrijft de bijbehorende datakwaliteitseisen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Known by the European term UVAR (Urban Vehicle Access Regulation). Placed in DATEX II in the TrafficRegulation and ControlledZone namespaces; the NAPCORE Quality Framework for UVAR Data describes the associated data quality requirements.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Graag reviewcommentaar toelichten @Nuno:

Ook onder RTTI : he crucial types of data on regulations and restrictions:
static and dynamic traffic regulations, where applicable; boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones;</skos:editorialNote>
    <dct:source>https://napcore.eu/quality/</dct:source>
    <dct:source>https://datex2.eu/user-domains/uvars/</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000025"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000023"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000026"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000013"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000022"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000021"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000020"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024"/>
    <skos:narrower rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202761035"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na863deb3ba094a62b708d71ab36d5ac1">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033"/>
