  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000007">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">FRC levels 0 to 8</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">FRC-niveaus 0 tot 8</skos:prefLabel>
    <skos:definition xml:lang="nl">De negen niveaus van de functionele wegclassificatie, oplopend van niveau 0 (hoofdweg/autosnelweg) tot niveau 8 (lokale wegen van minder belang en paden).</skos:definition>
    <skos:definition xml:lang="en">The nine levels of the functional road classification, ranging from level 0 (main road/motorway) up to level 8 (local roads of minor importance and paths).</skos:definition>
    <skos:scopeNote xml:lang="nl">Waardenlijst conform de INSPIRE FunctionalRoadClassValue-enumeratie, zoals weergegeven in de POLIS/CROW-positiepaper. De afzonderlijke niveau-URI's volgen het patroon van het INSPIRE-codelijstregister.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Value list in line with the INSPIRE FunctionalRoadClassValue enumeration, as presented in the POLIS/CROW position paper. The individual level URIs follow the pattern of the INSPIRE code list register.</skos:scopeNote>
    <dct:source>https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue</dct:source>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000020">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Low emission zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Milieuzone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een zone binnen een woonplaats waar motorvoertuigen die niet aan een bepaalde emissieklasse voldoen, worden geweerd.</skos:definition>
    <skos:definition xml:lang="en">A zone from which motor vehicles that do not meet a given emission class are barred, in order to improve air quality; known across Europe as a low emission zone (LEZ).</skos:definition>
    <skos:scopeNote xml:lang="nl">Aangeduid met bord C22a, dat samen met de overige C22-borden wordt vervangen door het geunificeerde bord C22e (Stb. 2025, 265).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Indicated by sign C22a, which together with the other C22 signs is being replaced by the unified sign C22e (Stb. 2025, 265).</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <dct:source>https://zoek.officielebekendmakingen.nl/stb-2025-265.html</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000021"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="nl">_Functionele wegclassificatie</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Functional road class</skos:prefLabel>
    <skos:definition xml:lang="nl">Een classificatie van wegen op basis van het belang van hun functie binnen het wegennet, onafhankelijk van de fysieke wegcategorie.</skos:definition>
    <skos:definition xml:lang="en">A classification of roads based on the importance of their function within the road network, independent of the physical road category.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gebaseerd op de INSPIRE Transport Networks FunctionalRoadClass. In de POLIS/CROW-positiepaper wordt de functionele wegclassificatie voorgesteld als basis (datatype 2b) voor het digitaal verkeerscirculatieplan, met de kanttekening dat voor beleidsdoeleinden vaak meer functies nodig zijn dan de Europese FRC biedt en dat multimodaliteit nog ontbreekt.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Based on the INSPIRE Transport Networks FunctionalRoadClass. The POLIS/CROW position paper proposes the functional road classification as the basis (data type 2b) for the digital traffic circulation plan, with the caveat that policy purposes often require more functions than the European FRC offers and that multimodality is still lacking.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Funcitonele wegclassificatie =&gt; mapping -&gt; https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/</skos:editorialNote>
    <dct:source>https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue</dct:source>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000007"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"/>
    <skos:exactMatch rdf:resource="https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="nl">Bedrijfsregels</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Business rules</skos:prefLabel>
    <skos:definition xml:lang="en">to be decided later</skos:definition>
    <skos:definition xml:lang="nl">nader te bepalen</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/collections/plankader-en-juridische-basis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Plan framework &amp; legal basis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Plankader &amp; juridische basis</skos:prefLabel>
    <skos:memberList rdf:nodeID="N126a3a817859408cb5a0f1cd6325f3d2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000034">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Junction</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Knooppunt</skos:prefLabel>
    <skos:definition xml:lang="nl">Een locatie waar verkeer naar een andere route kan worden geleid.</skos:definition>
    <skos:definition xml:lang="en">A location where traffic can be directed onto another route.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie junctions (NAPCORE data dictionary). Voor de geometrische realisatie gelden NWB, BGT/IMGeo en het Rotterdamse Mercator/IBRO-model als referentiebron (dct:source).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category junctions (NAPCORE data dictionary). For the geometric realisation, NWB, BGT/IMGeo and the Rotterdam Mercator/IBRO model serve as reference sources (dct:source).</skos:scopeNote>
    <dct:source>https://docs.geostandaarden.nl/ibro/scope/</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndb62e5cd957048c1a858c8a880385290">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017"/>
    <rdf:rest rdf:nodeID="N5d5e7514a2ab42e3ab69c0a09d890644"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Road link</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegvak</skos:prefLabel>
    <skos:definition xml:lang="nl">Een onderdeel van het wegennet tussen twee opeenvolgende posities, dat als kleinste eenheid dient voor de registratie van wegkenmerken en maatregelen.</skos:definition>
    <skos:definition xml:lang="en">A part of the road network between two consecutive positions, serving as the smallest unit for recording road characteristics and measures.</skos:definition>
    <skos:scopeNote xml:lang="nl">In Nederland geregistreerd in het Nationaal Wegenbestand (NWB) en als Wegdeel in de BGT/IMGeo. Deze registraties dienen hier uitsluitend als referentiebron (dct:source), niet als koppeldoel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Recorded in the Netherlands in the National Road Database (NWB) and as Wegdeel in the BGT/IMGeo. These registers serve here solely as a reference source (dct:source), not as a linking target.</skos:scopeNote>
    <dct:source>https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502</dct:source>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <dct:source>https://docs.geostandaarden.nl/imgeo/catalogus/imgeo/</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000031">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Freight delivery regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Bevoorradingsregeling</skos:prefLabel>
    <skos:definition xml:lang="nl">Regelingen voor het laden en lossen van goederen, zoals de aanwijzing van wegvakken of gebieden en tijdgebonden beperkingen.</skos:definition>
    <skos:definition xml:lang="en">Regulations for the loading and unloading of goods, such as the designation of road links or areas and time-bound restrictions.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie freight delivery regulations (NAPCORE data dictionary); nauw verbonden met venstertijden.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category freight delivery regulations (NAPCORE data dictionary); closely linked to time windows.</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000018">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Slow traffic</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Langzaam verkeer</skos:prefLabel>
    <skos:definition xml:lang="nl">Niet-motorvoertuigen, fietsers, voetgangers en geleiders of berijders van een dier, alsmede motorvoertuigen die slechts een lage snelheid kunnen of mogen rijden.</skos:definition>
    <skos:definition xml:lang="en">Non-motorised vehicles, cyclists, pedestrians and persons leading or riding an animal, as well as motor vehicles that can or may travel only at a low speed.</skos:definition>
    <skos:scopeNote xml:lang="nl">Term conform de CROW-thesaurus. Relevant omdat circulatiemaatregelen langzaam verkeer doorgaans uitzonderen (bijv. een knip die wel passeerbaar is voor fietsers).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Term in line with the CROW thesaurus. Relevant because circulation measures usually exempt slow traffic (e.g. a traffic filter that cyclists can still pass).</skos:scopeNote>
    <dct:source>https://data.crow.nl/thesaurus/term/264DF64F-903B-49CD-A4E4-D3E235A20FF2</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5d5e7514a2ab42e3ab69c0a09d890644">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000018"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne4d7dba5f4d94eea9104509d9ff5275a">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000026"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6e977c742d464667911b6137f91903c1">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000030"/>
    <rdf:rest rdf:nodeID="N4be9edd785f34ec2afed494607bac30c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000005">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Multimodal network framework</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Multimodaal netwerkkader</skos:prefLabel>
    <skos:definition xml:lang="nl">Een eenduidige weergave van het beleidsmatig gewenste multimodale gebruik van het wegennet, met een prioritering tussen modaliteiten per netwerkonderdeel.</skos:definition>
    <skos:definition xml:lang="en">An unambiguous representation of the multimodal use of the road network desired as a matter of policy, with a prioritisation between modes per network element.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gestandaardiseerd via de CROW/LVMB-richtlijn en -leidraad voor multimodale netwerkkaders. Vormt de modaliteitslaag waarop voorkeursroutes en wegcategorisering kunnen aansluiten.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Standardised through the CROW/LVMB guideline and manual for multimodal network frameworks. Forms the modality layer to which preferred routes and road categorisation can connect.</skos:scopeNote>
    <dct:source>https://www.crow.nl/kennisproducten/richtlijn-en-leidraad-voor-multimodale-netwerkkaders/</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000032">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Zone boundary</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Zonegrens</skos:prefLabel>
    <skos:definition xml:lang="nl">De ruimtelijke begrenzing van een gebied waarbinnen een zonale verkeersregel geldt.</skos:definition>
    <skos:definition xml:lang="en">The spatial delimitation of an area within which a zonal traffic rule applies.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie grenzen van zonale beperkingen, verboden of geboden (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category boundaries of zonal restrictions, prohibitions or obligations (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000027">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">One-way street</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Eenrichtingsverkeer</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegvak waar verkeer slechts in een rijrichting is toegestaan.</skos:definition>
    <skos:definition xml:lang="en">A road link where traffic is permitted in one direction of travel only.</skos:definition>
    <skos:scopeNote xml:lang="nl">Aangeduid met de borden C2/C3/C4 (RVV 1990); in DATEX II te modelleren als een TrafficRegulation. Eenrichtingsverkeer is een veelgebruikte circulatiemaatregel.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Indicated by signs C2/C3/C4 (RVV 1990); to be modelled in DATEX II as a TrafficRegulation. One-way traffic is a widely used circulation measure.</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/levels/mastering/trafficregulation/</dct:source>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Closure declaration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geslotenverklaring</skos:prefLabel>
    <skos:definition xml:lang="nl">Een verbod om de betrokken weg of het betrokken weggedeelte in te rijden of in te gaan en te gebruiken.</skos:definition>
    <skos:definition xml:lang="en">A prohibition on entering and using the road or road section concerned.</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie ontleend aan art. 1 RVV 1990; gerealiseerd via de C-bordenreeks. Vormt de juridische basis voor veel circulatiemaatregelen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Definition derived from art. 1 RVV 1990; realised through the C series of signs. Forms the legal basis for many circulation measures.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000030"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000029"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000015"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd479de946b224c9088625ee2902a46a9">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000009"/>
    <rdf:rest rdf:nodeID="Nddda0d985bf8433091e243f93bb797f7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Preferred route</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Voorkeursroute</skos:prefLabel>
    <skos:definition xml:lang="nl">Een door de wegbeheerder beleidsmatig gewenste route per modaliteit of doelgroep, bedoeld om met serviceproviders te worden gedeeld zodat navigatiediensten erop kunnen sturen.</skos:definition>
    <skos:definition xml:lang="en">A route desired by the road authority as a matter of policy, per mode or target group, intended to be shared with service providers so that navigation services can guide traffic along it.</skos:definition>
    <skos:scopeNote xml:lang="nl">Een van de in de POLIS/CROW-positiepaper genoemde use cases van een digitaal verkeerscirculatieplan (naast te mijden gebieden en het gebruik van hoofdroutes).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">One of the use cases of a digital traffic circulation plan mentioned in the POLIS/CROW position paper (alongside areas to be avoided and the use of main routes).</skos:scopeNote>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1787733042482"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202761035">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="nl">Schoolzone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">School zone</skos:prefLabel>
    <skos:definition xml:lang="nl">nader te bepalen</skos:definition>
    <skos:definition xml:lang="en">to be decided later</skos:definition>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N69364e161366491389e32ecef7823bfa">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024"/>
    <rdf:rest rdf:nodeID="Nb5fe8bb95dce49ada61f61f626dab1e6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/collections/geometrie-en-locatiereferentie">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Geometry &amp; location referencing</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geometrie &amp; locatiereferentie</skos:prefLabel>
    <skos:memberList rdf:nodeID="Nae941862980d4d3db155e9d2cb2a3120"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1d0f53bd282944d5bcb60437e40661ba">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000013"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="nl">Verkeerscirculatieplan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Traffic circulation plan</skos:prefLabel>
    <skos:definition xml:lang="nl">Een samenhangende set van permanente of terugkerende verkeersmanagementmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones).</skos:definition>
    <skos:definition xml:lang="en">A coherent set of permanent or recurring traffic management measures designed by a road authority to guide traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences and existing restrictions (e.g. school zones).</skos:definition>
    <skos:scopeNote xml:lang="nl">Definitie gebaseerd op art. 2(21) van de Gedelegeerde Verordening RTTI (EU) 2022/670. In de POLIS/CROW-positiepaper (2024) wordt voorgesteld een digitaal verkeerscirculatieplan te modelleren als RTTI-datatype 2b: de functionele wegclassificatie aangevuld met use cases. De ITS-richtlijn verplicht digitalisering van nieuw ontwikkelde verkeerscirculatieplannen vanaf 2028.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A traffic circulation plan does not itself introduce restrictions.</skos:scopeNote>
    <skos:scopeNote xml:lang="nl">Een verkeerscirculatieplan introduceert geen beperkingen.</skos:scopeNote>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000004">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Policy objective</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Beleidsdoel</skos:prefLabel>
    <skos:definition xml:lang="nl">Een bestuurlijk geformuleerd doel - zoals bereikbaarheid, leefbaarheid, verkeersveiligheid of luchtkwaliteit - dat de gewenste verkeersstromen binnen een verkeerscirculatieplan stuurt.</skos:definition>
    <skos:definition xml:lang="en">An objective formulated at policy level - such as accessibility, liveability, road safety or air quality - that guides the desired traffic flows within a traffic circulation plan.</skos:definition>
    <skos:scopeNote xml:lang="nl">Conform de POLIS/CROW-positiepaper vormen beleidsdoelen de aanleiding voor de keuze van maatregelen en voorkeursroutes in een verkeerscirculatieplan.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">In line with the POLIS/CROW position paper, policy objectives are the reason for the choice of measures and preferred routes in a traffic circulation plan.</skos:scopeNote>
    <dct:source>https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf</dct:source>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000015"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000029">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">No-entry restriction</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Inrijverbod</skos:prefLabel>
    <skos:definition xml:lang="nl">Een permanente toegangsbeperking voor een of meer voertuigcategorieen op een specifiek wegvak.</skos:definition>
    <skos:definition xml:lang="en">A permanent access restriction for one or more vehicle categories on a specific road link.</skos:definition>
    <skos:scopeNote xml:lang="nl">Valt onder de RTTI-datacategorie permanente toegangsbeperkingen (NAPCORE data dictionary).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Falls under the RTTI data category permanent access restrictions (NAPCORE data dictionary).</skos:scopeNote>
    <dct:source>https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000030">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Traffic filter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Knip</skos:prefLabel>
    <skos:definition xml:lang="nl">Een fysieke afsluiting - bijvoorbeeld door beweegbare palen - die doorgaand gemotoriseerd verkeer onmogelijk maakt, terwijl fietsers, voetgangers en ontheffinghouders kunnen passeren.</skos:definition>
    <skos:definition xml:lang="en">A physical closure - for example by means of retractable bollards - that makes through motorised traffic impossible, while cyclists, pedestrians and exemption holders can pass.</skos:definition>
    <skos:scopeNote xml:lang="nl">De knip is de fysieke realisatie van een geslotenverklaring en een kernmaatregel tegen sluipverkeer in verkeerscirculatieplannen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The traffic filter is the physical realisation of a closure declaration and a core measure against rat-running traffic in traffic circulation plans.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000022">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Pedestrian zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Voetgangerszone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied waarin in beginsel uitsluitend voetgangers zich mogen bevinden en voorrang hebben op overig verkeer.</skos:definition>
    <skos:definition xml:lang="en">An area in which, in principle, only pedestrians may be present and where they have priority over other traffic.</skos:definition>
    <skos:scopeNote xml:lang="nl">Ook wel voetgangersgebied genoemd; aangeduid met de borden G7/G8 (RVV 1990).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Also referred to as a pedestrian area; indicated by signs G7/G8 (RVV 1990).</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc671202263245b3be4bbe61a847c3fa">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"/>
    <rdf:rest rdf:nodeID="Nd479de946b224c9088625ee2902a46a9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Road category</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegcategorie</skos:prefLabel>
    <skos:definition xml:lang="nl">De fysiek-functionele indeling van een weg volgens de Nederlandse wegontwerpsystematiek, bepalend voor inrichting en gewenst gebruik.</skos:definition>
    <skos:definition xml:lang="en">The physical-functional classification of a road according to the Dutch road design system, determining its layout and intended use.</skos:definition>
    <skos:scopeNote xml:lang="nl">Gebaseerd op de Duurzaam Veilig-categorisering (CROW). De Nederlandse wegcategorieen corresponderen functioneel met de Europese functionele wegclassificatie, maar vormen daarmee geen een-op-een-hierarchie; daarom een skos:related-relatie in plaats van broader/narrower.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Based on the Sustainable Safety (Duurzaam Veilig) categorisation (CROW). The Dutch road categories correspond functionally to the European functional road classification, but do not form a one-to-one hierarchy with it; hence a skos:related relation instead of broader/narrower.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/</dct:source>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000010"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000012"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000009"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2780db5ab2b14d4297e8c01d31bd09bc">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000023"/>
    <rdf:rest rdf:nodeID="N69364e161366491389e32ecef7823bfa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000009">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Flow road</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Stroomweg</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegcategorie gericht op de doorstroming van verkeer met een constante, doorgaans hoge snelheid, met ongelijkvloerse kruisingen.</skos:definition>
    <skos:definition xml:lang="en">A road category aimed at the through-flow of traffic at a constant, generally high speed, with grade-separated intersections.</skos:definition>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie; komt vooral buiten de bebouwde kom voor.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category; occurs mainly outside built-up areas.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb5fe8bb95dce49ada61f61f626dab1e6">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000025"/>
    <rdf:rest rdf:nodeID="Ne4d7dba5f4d94eea9104509d9ff5275a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/collections/verkeersstromen-en-routering">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Traffic flows &amp; routing</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Verkeersstromen &amp; routering</skos:prefLabel>
    <skos:memberList rdf:nodeID="N0bc23a383d05492d9663442deaef7036"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000012">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Access road</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Erftoegangsweg</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegcategorie gericht op het toegankelijk maken van erven en bestemmingen, met een verblijfsfunctie en een lage snelheid.</skos:definition>
    <skos:definition xml:lang="en">A road category aimed at providing access to premises and destinations, with a residential function and a low speed.</skos:definition>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie (CROW). Afgekort ETW.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category (CROW). Abbreviated ETW.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"/>
    <skos:narrower rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000013"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/collections/zonale-toegangsregimes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Urban vehicle access regulations</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Zonale toegangsregimes</skos:prefLabel>
    <skos:memberList rdf:nodeID="N40a58b97421a4396aaff6be2d35fcd92"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc41bfd062e4f4e4e900d1709ebd239f7">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000029"/>
