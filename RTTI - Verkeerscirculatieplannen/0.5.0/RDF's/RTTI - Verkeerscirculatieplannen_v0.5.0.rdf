  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title xml:lang="nl">RTTI — Verkeerscirculatieplannen</dct:title>
    <dct:description xml:lang="nl">Dit conceptschema beschrijft de samenhangende set van permanente of terugkerende verkeersmaatregelen die door een wegbeheerder wordt ontworpen om de multimodale verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones).</dct:description>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T11:14:20.285419+00:00</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-09-07T10:38:18.575175+00:00</dct:modified>
    <owl:versionInfo>0.5.0</owl:versionInfo>
  </rdf:Description>
