  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000010">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Distributor road</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gebiedsontsluitingsweg</skos:prefLabel>
    <skos:definition xml:lang="nl">Een wegcategorie die landelijk of stedelijk gebied ontsluit: doorstroming op de wegvakken, uitwisseling op de kruispunten.</skos:definition>
    <skos:definition xml:lang="en">A road category that provides access to rural or urban areas: through-flow on the links, exchange at the intersections.</skos:definition>
    <skos:scopeNote xml:lang="nl">Duurzaam Veilig-categorie (CROW-thesaurus). Afgekort GOW.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Sustainable Safety (Duurzaam Veilig) category (CROW thesaurus). Abbreviated GOW.</skos:scopeNote>
    <dct:source>https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/</dct:source>
    <dct:source>https://data.crow.nl/thesaurus/term/8504D234-DD69-4A8D-BA4E-E207E57ECEAD</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000021">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Zero-emission zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Nul-emissiezone</skos:prefLabel>
    <skos:definition xml:lang="nl">Een zone waar voor bedrijfs- en vrachtauto's uitsluitend emissieloze voertuigen zijn toegestaan.</skos:definition>
    <skos:definition xml:lang="en">A zone where only zero-emission vehicles are permitted for vans and lorries.</skos:definition>
    <skos:scopeNote xml:lang="nl">Sinds 1 januari 2025 voeren gemeenten nul-emissiezones voor stadslogistiek in. Aangeduid met bord C22c, dat opgaat in het geunificeerde bord C22e (Stb. 2025, 265).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Since 1 January 2025 municipalities have been introducing zero-emission zones for urban logistics. Indicated by sign C22c, which is being merged into the unified sign C22e (Stb. 2025, 265).</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <dct:source>https://zoek.officielebekendmakingen.nl/stb-2025-265.html</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"/>
  </rdf:Description>
