  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000023">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="en">Low-car zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Autoluw gebied</skos:prefLabel>
    <skos:definition xml:lang="nl">Een gebied met bewust beperkt gemotoriseerd verkeer, doorgaans gerealiseerd via ontheffingen en kentekenhandhaving.</skos:definition>
    <skos:definition xml:lang="en">An area with deliberately limited motorised traffic, usually realised through exemptions and licence plate enforcement.</skos:definition>
    <skos:scopeNote xml:lang="nl">Niet als zodanig in het RVV gedefinieerd; in de praktijk een combinatie van geslotenverklaringen, venstertijden en ontheffingen.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Not defined as such in the RVV; in practice a combination of closure declarations, time windows and exemptions.</skos:scopeNote>
    <dct:source>https://wetten.overheid.nl/BWBR0004825</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"/>
    <skos:related rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1787733042482">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"/>
    <skos:prefLabel xml:lang="nl">_Bewegwijzering</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Signage</skos:prefLabel>
    <skos:editorialNote xml:lang="nl">Definities graag aanleveren. Indien er op basis van andere standaarden (bijv. DATEXII) een beschrijving wordt toegevoegd, graag URL meegeven.</skos:editorialNote>
    <skos:definition xml:lang="nl">t.b.d.</skos:definition>
    <skos:definition xml:lang="en">t.b.d</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N84203858aa0d4a10a00685e70deefa18">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000022"/>
