      },
      {
        "@value": "https://zoek.officielebekendmakingen.nl/stb-2025-265.html"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een zone binnen een woonplaats waar motorvoertuigen die niet aan een bepaalde emissieklasse voldoen, worden geweerd."
      },
      {
        "@language": "en",
        "@value": "A zone from which motor vehicles that do not meet a given emission class are barred, in order to improve air quality; known across Europe as a low emission zone (LEZ)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Low emission zone"
      },
      {
        "@language": "nl",
        "@value": "Milieuzone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000021"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Aangeduid met bord C22a, dat samen met de overige C22-borden wordt vervangen door het geunificeerde bord C22e (Stb. 2025, 265)."
      },
      {
        "@language": "en",
        "@value": "Indicated by sign C22a, which together with the other C22 signs is being replaced by the unified sign C22e (Stb. 2025, 265)."
      }
    ]
  },
