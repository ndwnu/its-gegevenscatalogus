  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000007",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"
      },
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De negen niveaus van de functionele wegclassificatie, oplopend van niveau 0 (hoofdweg/autosnelweg) tot niveau 8 (lokale wegen van minder belang en paden)."
      },
      {
        "@language": "en",
        "@value": "The nine levels of the functional road classification, ranging from level 0 (main road/motorway) up to level 8 (local roads of minor importance and paths)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "FRC levels 0 to 8"
      },
      {
        "@language": "nl",
        "@value": "FRC-niveaus 0 tot 8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Waardenlijst conform de INSPIRE FunctionalRoadClassValue-enumeratie, zoals weergegeven in de POLIS/CROW-positiepaper. De afzonderlijke niveau-URI's volgen het patroon van het INSPIRE-codelijstregister."
      },
      {
        "@language": "en",
        "@value": "Value list in line with the INSPIRE FunctionalRoadClassValue enumeration, as presented in the POLIS/CROW position paper. The individual level URIs follow the pattern of the INSPIRE code list register."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000005",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/kennisproducten/richtlijn-en-leidraad-voor-multimodale-netwerkkaders/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een eenduidige weergave van het beleidsmatig gewenste multimodale gebruik van het wegennet, met een prioritering tussen modaliteiten per netwerkonderdeel."
      },
      {
        "@language": "en",
        "@value": "An unambiguous representation of the multimodal use of the road network desired as a matter of policy, with a prioritisation between modes per network element."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Multimodal network framework"
      },
      {
        "@language": "nl",
        "@value": "Multimodaal netwerkkader"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gestandaardiseerd via de CROW/LVMB-richtlijn en -leidraad voor multimodale netwerkkaders. Vormt de modaliteitslaag waarop voorkeursroutes en wegcategorisering kunnen aansluiten."
      },
      {
        "@language": "en",
        "@value": "Standardised through the CROW/LVMB guideline and manual for multimodal network frameworks. Forms the modality layer to which preferred routes and road categorisation can connect."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000023",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied met bewust beperkt gemotoriseerd verkeer, doorgaans gerealiseerd via ontheffingen en kentekenhandhaving."
      },
      {
        "@language": "en",
        "@value": "An area with deliberately limited motorised traffic, usually realised through exemptions and licence plate enforcement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Low-car zone"
      },
      {
        "@language": "nl",
        "@value": "Autoluw gebied"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Niet als zodanig in het RVV gedefinieerd; in de praktijk een combinatie van geslotenverklaringen, venstertijden en ontheffingen."
      },
      {
        "@language": "en",
        "@value": "Not defined as such in the RVV; in practice a combination of closure declarations, time windows and exemptions."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000009",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegcategorie gericht op de doorstroming van verkeer met een constante, doorgaans hoge snelheid, met ongelijkvloerse kruisingen."
      },
      {
        "@language": "en",
        "@value": "A road category aimed at the through-flow of traffic at a constant, generally high speed, with grade-separated intersections."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Flow road"
      },
      {
        "@language": "nl",
        "@value": "Stroomweg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Duurzaam Veilig-categorie; komt vooral buiten de bebouwde kom voor."
      },
      {
        "@language": "en",
        "@value": "Sustainable Safety (Duurzaam Veilig) category; occurs mainly outside built-up areas."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000022",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied waarin in beginsel uitsluitend voetgangers zich mogen bevinden en voorrang hebben op overig verkeer."
      },
      {
        "@language": "en",
        "@value": "An area in which, in principle, only pedestrians may be present and where they have priority over other traffic."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Pedestrian zone"
      },
      {
        "@language": "nl",
        "@value": "Voetgangerszone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Ook wel voetgangersgebied genoemd; aangeduid met de borden G7/G8 (RVV 1990)."
      },
      {
        "@language": "en",
        "@value": "Also referred to as a pedestrian area; indicated by signs G7/G8 (RVV 1990)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000030",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een fysieke afsluiting - bijvoorbeeld door beweegbare palen - die doorgaand gemotoriseerd verkeer onmogelijk maakt, terwijl fietsers, voetgangers en ontheffinghouders kunnen passeren."
      },
      {
        "@language": "en",
        "@value": "A physical closure - for example by means of retractable bollards - that makes through motorised traffic impossible, while cyclists, pedestrians and exemption holders can pass."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Traffic filter"
      },
      {
        "@language": "nl",
        "@value": "Knip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "De knip is de fysieke realisatie van een geslotenverklaring en een kernmaatregel tegen sluipverkeer in verkeerscirculatieplannen."
      },
      {
        "@language": "en",
        "@value": "The traffic filter is the physical realisation of a closure declaration and a core measure against rat-running traffic in traffic circulation plans."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000032",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De ruimtelijke begrenzing van een gebied waarbinnen een zonale verkeersregel geldt."
      },
      {
        "@language": "en",
        "@value": "The spatial delimitation of an area within which a zonal traffic rule applies."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Zone boundary"
      },
      {
        "@language": "nl",
        "@value": "Zonegrens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie grenzen van zonale beperkingen, verboden of geboden (NAPCORE data dictionary)."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category boundaries of zonal restrictions, prohibitions or obligations (NAPCORE data dictionary)."
      }
    ]
  },
  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1787733042482",
