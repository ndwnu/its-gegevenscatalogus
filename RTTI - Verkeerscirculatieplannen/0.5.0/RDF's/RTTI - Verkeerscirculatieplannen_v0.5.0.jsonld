  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/quality/"
      },
      {
        "@value": "https://datex2.eu/user-domains/uvars/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een begrenzing of beperking van het gebruik van het wegennet op basis van voertuigtype, reizigerstype of tijd, die geldt voor een afgebakend gebied."
      },
      {
        "@language": "en",
        "@value": "A limitation or restriction on the use of the road network on the basis of vehicle type, traveller type or time, applying to a delimited area."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Graag reviewcommentaar toelichten @Nuno:\n\nOok onder RTTI : he crucial types of data on regulations and restrictions:\nstatic and dynamic traffic regulations, where applicable; boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones;"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
