    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegcategorie gericht op het toegankelijk maken van erven en bestemmingen, met een verblijfsfunctie en een lage snelheid."
      },
      {
        "@language": "en",
        "@value": "A road category aimed at providing access to premises and destinations, with a residential function and a low speed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
