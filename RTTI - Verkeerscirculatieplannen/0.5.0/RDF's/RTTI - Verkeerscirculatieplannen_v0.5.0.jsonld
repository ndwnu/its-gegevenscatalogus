    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Urban vehicle access regulation"
      },
      {
        "@language": "nl",
        "@value": "_Zonaal toegangsregime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Bekend onder de Europese term UVAR (Urban Vehicle Access Regulation). In DATEX II ondergebracht in de namespaces TrafficRegulation en ControlledZone; het NAPCORE Quality Framework for UVAR Data beschrijft de bijbehorende datakwaliteitseisen."
      },
      {
        "@language": "en",
        "@value": "Known by the European term UVAR (Urban Vehicle Access Regulation). Placed in DATEX II in the TrafficRegulation and ControlledZone namespaces; the NAPCORE Quality Framework for UVAR Data describes the associated data quality requirements."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000015",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Bestuurders wier reisdoel een of meer percelen betreft die aan of nabij een weg met een geslotenverklaring liggen en die daartoe uitsluitend via die weg bereikbaar zijn, alsmede bestuurders van lijnbussen."
      },
      {
        "@language": "en",
        "@value": "Drivers whose journey destination concerns one or more plots situated on or near a road subject to a closure declaration and reachable for that purpose solely via that road, as well as drivers of scheduled buses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Destination traffic"
      },
      {
        "@language": "nl",
        "@value": "Bestemmingsverkeer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Definitie ontleend aan art. 1 RVV 1990. Bestemmingsverkeer wordt veelal via een onderbord uitgezonderd van een geslotenverklaring."
      },
      {
        "@language": "en",
        "@value": "Definition derived from art. 1 RVV 1990. Destination traffic is usually exempted from a closure declaration by means of a supplementary panel."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000034",
