      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000027",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://docs.datex2.eu/levels/mastering/trafficregulation/"
      },
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegvak waar verkeer slechts in een rijrichting is toegestaan."
      },
      {
        "@language": "en",
        "@value": "A road link where traffic is permitted in one direction of travel only."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "One-way street"
      },
      {
        "@language": "nl",
        "@value": "Eenrichtingsverkeer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Aangeduid met de borden C2/C3/C4 (RVV 1990); in DATEX II te modelleren als een TrafficRegulation. Eenrichtingsverkeer is een veelgebruikte circulatiemaatregel."
      },
      {
        "@language": "en",
        "@value": "Indicated by signs C2/C3/C4 (RVV 1990); to be modelled in DATEX II as a TrafficRegulation. One-way traffic is a widely used circulation measure."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een door de wegbeheerder beleidsmatig gewenste route per modaliteit of doelgroep, bedoeld om met serviceproviders te worden gedeeld zodat navigatiediensten erop kunnen sturen."
      },
      {
        "@language": "en",
        "@value": "A route desired by the road authority as a matter of policy, per mode or target group, intended to be shared with service providers so that navigation services can guide traffic along it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Preferred route"
      },
      {
        "@language": "nl",
        "@value": "Voorkeursroute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1787733042482"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Een van de in de POLIS/CROW-positiepaper genoemde use cases van een digitaal verkeerscirculatieplan (naast te mijden gebieden en het gebruik van hoofdroutes)."
      },
      {
        "@language": "en",
        "@value": "One of the use cases of a digital traffic circulation plan mentioned in the POLIS/CROW position paper (alongside areas to be avoided and the use of main routes)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000021",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      },
      {
        "@value": "https://zoek.officielebekendmakingen.nl/stb-2025-265.html"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een zone waar voor bedrijfs- en vrachtauto's uitsluitend emissieloze voertuigen zijn toegestaan."
      },
      {
        "@language": "en",
        "@value": "A zone where only zero-emission vehicles are permitted for vans and lorries."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Zero-emission zone"
      },
      {
        "@language": "nl",
        "@value": "Nul-emissiezone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Sinds 1 januari 2025 voeren gemeenten nul-emissiezones voor stadslogistiek in. Aangeduid met bord C22c, dat opgaat in het geunificeerde bord C22e (Stb. 2025, 265)."
      },
      {
        "@language": "en",
        "@value": "Since 1 January 2025 municipalities have been introducing zero-emission zones for urban logistics. Indicated by sign C22c, which is being merged into the unified sign C22e (Stb. 2025, 265)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004826"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een gebied dat alleen op door de gemeente bepaalde tijdstippen toegankelijk is voor (bevoorradend) gemotoriseerd verkeer."
      },
      {
        "@language": "en",
        "@value": "An area accessible to (delivery) motorised traffic only at times determined by the municipality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Time-window zone"
      },
      {
        "@language": "nl",
        "@value": "Venstertijdengebied"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Venstertijden worden kenbaar gemaakt via onderborden bij een geslotenverklaring (BABW). Veelgebruikt voor stadslogistiek."
      },
      {
        "@language": "en",
        "@value": "Time windows are made known by means of supplementary panels accompanying a closure declaration (BABW). Widely used for urban logistics."
      }
    ]
  },
