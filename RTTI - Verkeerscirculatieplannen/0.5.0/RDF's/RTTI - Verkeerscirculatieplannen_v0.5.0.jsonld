      },
      {
        "@language": "nl",
        "@value": "Knooppunt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie junctions (NAPCORE data dictionary). Voor de geometrische realisatie gelden NWB, BGT/IMGeo en het Rotterdamse Mercator/IBRO-model als referentiebron (dct:source)."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category junctions (NAPCORE data dictionary). For the geometric realisation, NWB, BGT/IMGeo and the Rotterdam Mercator/IBRO model serve as reference sources (dct:source)."
      }
    ]
  },
