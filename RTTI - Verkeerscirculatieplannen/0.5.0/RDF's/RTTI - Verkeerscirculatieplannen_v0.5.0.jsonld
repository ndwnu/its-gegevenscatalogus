    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Urban vehicle access regulations"
      },
      {
        "@language": "nl",
        "@value": "Zonale toegangsregimes"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      },
      {
        "@value": "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een samenhangende set van permanente of terugkerende verkeersmanagementmaatregelen die door een wegbeheerder wordt ontworpen om de verkeersstromen binnen een gebied te sturen, rekening houdend met bekende en terugkerende verkeerssituaties, seizoensinvloeden en bestaande beperkingen (bijv. schoolzones)."
      },
      {
        "@language": "en",
        "@value": "A coherent set of permanent or recurring traffic management measures designed by a road authority to guide traffic flows within an area, taking into account known and recurring traffic situations, seasonal influences and existing restrictions (e.g. school zones)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "Verkeerscirculatieplan"
      },
      {
        "@language": "en",
        "@value": "Traffic circulation plan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Definitie gebaseerd op art. 2(21) van de Gedelegeerde Verordening RTTI (EU) 2022/670. In de POLIS/CROW-positiepaper (2024) wordt voorgesteld een digitaal verkeerscirculatieplan te modelleren als RTTI-datatype 2b: de functionele wegclassificatie aangevuld met use cases. De ITS-richtlijn verplicht digitalisering van nieuw ontwikkelde verkeerscirculatieplannen vanaf 2028."
      },
      {
        "@language": "en",
        "@value": "A traffic circulation plan does not itself introduce restrictions."
      },
      {
        "@language": "nl",
        "@value": "Een verkeerscirculatieplan introduceert geen beperkingen."
      }
    ]
  },
  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784621302158",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Willen we iets met digitale actuatoren (zie andere RTTI modellen)?"
      },
      {
        "@language": "en",
        "@value": "Digital indicators?"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "AANTEKENINGEN"
      },
      {
        "@language": "en",
        "@value": "AANTEKENINGEN"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000026",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://datex2.eu/user-domains/uvars/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een afgebakend gebied waarbinnen het verkeer voor bepaalde voertuigcategorieen of doelgroepen is beperkt; internationaal bekend als ZTL (zona a traffico limitato)."
      },
      {
        "@language": "en",
        "@value": "A delimited area within which traffic is restricted for certain vehicle categories or target groups; known internationally as ZTL (zona a traffico limitato)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Limited traffic zone"
      },
      {
        "@language": "nl",
        "@value": "Zone met beperkt verkeer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Generiek zonaal regime dat de internationale UVAR-praktijk dekt en in NL via geslotenverklaring met uitzonderingen wordt vormgegeven."
      },
      {
        "@language": "en",
        "@value": "Generic zonal regime covering international UVAR practice, shaped in the Netherlands through a closure declaration with exemptions."
      }
    ]
  },
  {
    "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen",
