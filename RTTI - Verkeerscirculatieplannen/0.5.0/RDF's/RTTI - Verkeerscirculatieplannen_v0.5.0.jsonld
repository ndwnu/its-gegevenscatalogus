  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000010",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      },
      {
        "@value": "https://data.crow.nl/thesaurus/term/8504D234-DD69-4A8D-BA4E-E207E57ECEAD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een wegcategorie die landelijk of stedelijk gebied ontsluit: doorstroming op de wegvakken, uitwisseling op de kruispunten."
      },
      {
        "@language": "en",
        "@value": "A road category that provides access to rural or urban areas: through-flow on the links, exchange at the intersections."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Distributor road"
      },
      {
        "@language": "nl",
        "@value": "Gebiedsontsluitingsweg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Duurzaam Veilig-categorie (CROW-thesaurus). Afgekort GOW."
      },
      {
        "@language": "en",
        "@value": "Sustainable Safety (Duurzaam Veilig) category (CROW thesaurus). Abbreviated GOW."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000013",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://wetten.overheid.nl/BWBR0004825"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000012"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een als erf aangeduid verblijfsgebied, begrensd door de borden G5 (begin) en G6 (einde), waar voetgangers de gehele breedte van de weg mogen gebruiken en stapvoets (15 km/u) wordt gereden."
      },
      {
        "@language": "en",
        "@value": "A residential area designated as a yard (Dutch: erf), bounded by signs G5 (start) and G6 (end), where pedestrians may use the full width of the road and vehicles travel at walking pace (15 km/h)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Residential yard"
      },
      {
        "@language": "nl",
        "@value": "Woonerf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "RVV 1990 (borden G5/G6). Een woonerf is de meest verblijfsgerichte uitwerking van een erftoegangsweg."
      },
      {
        "@language": "en",
        "@value": "RVV 1990 (signs G5/G6). A woonerf is the most residential-oriented elaboration of an access road."
      }
    ]
  },
