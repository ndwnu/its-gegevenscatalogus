      {
        "@language": "nl",
        "@value": "Een verbod om de betrokken weg of het betrokken weggedeelte in te rijden of in te gaan en te gebruiken."
      },
      {
        "@language": "en",
        "@value": "A prohibition on entering and using the road or road section concerned."
      }
    ],
