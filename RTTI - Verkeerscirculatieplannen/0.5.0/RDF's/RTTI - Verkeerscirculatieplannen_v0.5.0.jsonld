[
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://data.crow.nl/thesaurus/term/48FA2203-699F-48A2-B82F-A0C4F6CA181C"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Verkeer dat noch een herkomst, noch een bestemming heeft binnen het beschouwde gebied."
      },
      {
        "@language": "en",
        "@value": "Traffic that has neither an origin nor a destination within the area under consideration."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Through traffic"
      },
      {
        "@language": "nl",
        "@value": "Doorgaand verkeer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Term conform de CROW-thesaurus. Het weren van doorgaand verkeer uit verblijfsgebieden is een kerndoel van veel verkeerscirculatieplannen."
      },
      {
        "@language": "en",
        "@value": "Term in line with the CROW thesaurus. Keeping through traffic out of residential areas is a core objective of many traffic circulation plans."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000004",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een bestuurlijk geformuleerd doel - zoals bereikbaarheid, leefbaarheid, verkeersveiligheid of luchtkwaliteit - dat de gewenste verkeersstromen binnen een verkeerscirculatieplan stuurt."
      },
      {
        "@language": "en",
        "@value": "An objective formulated at policy level - such as accessibility, liveability, road safety or air quality - that guides the desired traffic flows within a traffic circulation plan."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Policy objective"
      },
      {
        "@language": "nl",
        "@value": "Beleidsdoel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000015"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000014"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000028"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Conform de POLIS/CROW-positiepaper vormen beleidsdoelen de aanleiding voor de keuze van maatregelen en voorkeursroutes in een verkeerscirculatieplan."
      },
      {
        "@language": "en",
        "@value": "In line with the POLIS/CROW position paper, policy objectives are the reason for the choice of measures and preferred routes in a traffic circulation plan."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000025",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een straat die autovrij is gedurende de begin- en eindtijden van de schooldag."
      },
      {
        "@language": "en",
        "@value": "A street that is car-free during the start and end times of the school day."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "School street"
      },
      {
        "@language": "nl",
        "@value": "Schoolstraat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen/concept-1784202276603"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Als concrete maatregel genoemd in de POLIS/CROW-positiepaper; in NL doorgaans gerealiseerd via een tijdgebonden geslotenverklaring."
      },
      {
        "@language": "en",
        "@value": "Mentioned as a concrete measure in the POLIS/CROW position paper; in the Netherlands usually realised through a time-bound closure declaration."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000018",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://data.crow.nl/thesaurus/term/264DF64F-903B-49CD-A4E4-D3E235A20FF2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Niet-motorvoertuigen, fietsers, voetgangers en geleiders of berijders van een dier, alsmede motorvoertuigen die slechts een lage snelheid kunnen of mogen rijden."
      },
      {
        "@language": "en",
        "@value": "Non-motorised vehicles, cyclists, pedestrians and persons leading or riding an animal, as well as motor vehicles that can or may travel only at a low speed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Slow traffic"
      },
      {
        "@language": "nl",
        "@value": "Langzaam verkeer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000017"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Term conform de CROW-thesaurus. Relevant omdat circulatiemaatregelen langzaam verkeer doorgaans uitzonderen (bijv. een knip die wel passeerbaar is voor fietsers)."
      },
      {
        "@language": "en",
        "@value": "Term in line with the CROW thesaurus. Relevant because circulation measures usually exempt slow traffic (e.g. a traffic filter that cyclists can still pass)."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000008",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.crow.nl/Onderwerpen/wegontwerp-en-weginrichting/duurzaam-veilig-wegontwerp/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De fysiek-functionele indeling van een weg volgens de Nederlandse wegontwerpsystematiek, bepalend voor inrichting en gewenst gebruik."
      },
      {
        "@language": "en",
        "@value": "The physical-functional classification of a road according to the Dutch road design system, determining its layout and intended use."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000010"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000012"
      },
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000009"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Road category"
      },
      {
        "@language": "nl",
        "@value": "Wegcategorie"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gebaseerd op de Duurzaam Veilig-categorisering (CROW). De Nederlandse wegcategorieen corresponderen functioneel met de Europese functionele wegclassificatie, maar vormen daarmee geen een-op-een-hierarchie; daarom een skos:related-relatie in plaats van broader/narrower."
      },
      {
        "@language": "en",
        "@value": "Based on the Sustainable Safety (Duurzaam Veilig) categorisation (CROW). The Dutch road categories correspond functionally to the European functional road classification, but do not form a one-to-one hierarchy with it; hence a skos:related relation instead of broader/narrower."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000006",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://inspire.ec.europa.eu/enumeration/FunctionalRoadClassValue"
      },
      {
        "@value": "https://www.polisnetwork.eu/wp-content/uploads/2024/11/RTTI-Report.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een classificatie van wegen op basis van het belang van hun functie binnen het wegennet, onafhankelijk van de fysieke wegcategorie."
      },
      {
        "@language": "en",
        "@value": "A classification of roads based on the importance of their function within the road network, independent of the physical road category."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "nl",
        "@value": "Funcitonele wegclassificatie => mapping -> https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://docs.datex2.eu/recommended-profiles/rrp/rtti/rtti-670/1-i-b-road-classification/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000007"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "nl",
        "@value": "_Functionele wegclassificatie"
      },
      {
        "@language": "en",
        "@value": "Functional road class"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000001"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Gebaseerd op de INSPIRE Transport Networks FunctionalRoadClass. In de POLIS/CROW-positiepaper wordt de functionele wegclassificatie voorgesteld als basis (datatype 2b) voor het digitaal verkeerscirculatieplan, met de kanttekening dat voor beleidsdoeleinden vaak meer functies nodig zijn dan de Europese FRC biedt en dat multimodaliteit nog ontbreekt."
      },
      {
        "@language": "en",
        "@value": "Based on the INSPIRE Transport Networks FunctionalRoadClass. The POLIS/CROW position paper proposes the functional road classification as the basis (data type 2b) for the digital traffic circulation plan, with the caveat that policy purposes often require more functions than the European FRC offers and that multimodality is still lacking."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000033",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.nationaalgeoregister.nl/geonetwork/srv/api/records/a9b7026e-0a81-4813-93bd-ba49e6f28502"
      },
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      },
      {
        "@value": "https://docs.geostandaarden.nl/imgeo/catalogus/imgeo/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Een onderdeel van het wegennet tussen twee opeenvolgende posities, dat als kleinste eenheid dient voor de registratie van wegkenmerken en maatregelen."
      },
      {
        "@language": "en",
        "@value": "A part of the road network between two consecutive positions, serving as the smallest unit for recording road characteristics and measures."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Road link"
      },
      {
        "@language": "nl",
        "@value": "Wegvak"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "In Nederland geregistreerd in het Nationaal Wegenbestand (NWB) en als Wegdeel in de BGT/IMGeo. Deze registraties dienen hier uitsluitend als referentiebron (dct:source), niet als koppeldoel."
      },
      {
        "@language": "en",
        "@value": "Recorded in the Netherlands in the National Road Database (NWB) and as Wegdeel in the BGT/IMGeo. These registers serve here solely as a reference source (dct:source), not as a linking target."
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000031",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://napcore.eu/wp-content/uploads/2025/05/DD_2022_670.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Regelingen voor het laden en lossen van goederen, zoals de aanwijzing van wegvakken of gebieden en tijdgebonden beperkingen."
      },
      {
        "@language": "en",
        "@value": "Regulations for the loading and unloading of goods, such as the designation of road links or areas and time-bound restrictions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://nationaal-toegangspunt-mobiliteit.ontologica.nl/schemes/rtti-verkeerscirculatieplannen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Freight delivery regulation"
      },
      {
        "@language": "nl",
        "@value": "Bevoorradingsregeling"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#related": [
      {
        "@id": "https://gegevenscatalogus.gov/rtti-verkeerscirculatieplannen/concept-1773240000024"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "nl",
        "@value": "Valt onder de RTTI-datacategorie freight delivery regulations (NAPCORE data dictionary); nauw verbonden met venstertijden."
      },
      {
        "@language": "en",
        "@value": "Falls under the RTTI data category freight delivery regulations (NAPCORE data dictionary); closely linked to time windows."
      }
    ]
  },
